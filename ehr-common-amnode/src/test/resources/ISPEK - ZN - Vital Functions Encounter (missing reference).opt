                                <ns2:term_definitions code="at0009">
                                    <ns2:items id="text">Material used</ns2:items>
                                    <ns2:items id="description">Details of materials used during the intervention.</ns2:items>
                                </ns2:term_definitions>
                                <ns2:term_definitions code="at0010">
                                    <ns2:items id="text">Material name</ns2:items>
