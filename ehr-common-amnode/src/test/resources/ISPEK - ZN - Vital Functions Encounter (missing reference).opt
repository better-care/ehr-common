                        <ns2:archetype_id>
                            <ns2:value>openEHR-EHR-OBSERVATION.lab_test-blood_glucose.v1</ns2:value>
                        </ns2:archetype_id>
                        <ns2:term_definitions code="at0.100">
                            <ns2:items id="text">Dose</ns2:items>
                            <ns2:items id="description">Dose of glucose.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.101">
                            <ns2:items id="text">Route</ns2:items>
                            <ns2:items id="description">The route of administration of the glucose challenge.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.103">
                            <ns2:items id="text">Pre-challenge</ns2:items>
                            <ns2:items id="description">The sample was taken prior to the challenge.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.104">
                            <ns2:items id="text">Post-challenge</ns2:items>
                            <ns2:items id="description">The sample was taken after the challenge.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.105">
                            <ns2:items id="text">Oral</ns2:items>
                            <ns2:items id="description">The glucose was taken orally.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.106">
                            <ns2:items id="text">Intravenous</ns2:items>
                            <ns2:items id="description">The glucose was administered intravenously.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.107">
                            <ns2:items id="text">Insulin challenge.</ns2:items>
                            <ns2:items id="description">An insulin challenge was administered.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.108">
                            <ns2:items id="text">Event</ns2:items>
                            <ns2:items id="description">An event.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.109">
                            <ns2:items id="text">Event name</ns2:items>
                            <ns2:items id="description">A name for the event.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.110">
                            <ns2:items id="text">Dose</ns2:items>
                            <ns2:items id="description">Dose of insulin.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.111">
                            <ns2:items id="text">Route</ns2:items>
                            <ns2:items id="description">The route of administration of the insulin.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.112">
                            <ns2:items id="text">Intravenous</ns2:items>
                            <ns2:items id="description">The insulin was administered intravenously.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.113">
                            <ns2:items id="text">Subcutaneous</ns2:items>
                            <ns2:items id="description">The insulin was administered subcutaneously.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.114">
                            <ns2:items id="text">Method</ns2:items>
                            <ns2:items id="description">The method used to determine the result of the test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.115">
                            <ns2:items id="text">Test strip - visual</ns2:items>
                            <ns2:items id="description">The result was derived from a visual estimate of a test strip.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.116">
                            <ns2:items id="text">Test strip - automated</ns2:items>
                            <ns2:items id="description">The result was estimated automatically by machine  from a test strip.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.117">
                            <ns2:items id="text">Laboratory analyser</ns2:items>
                            <ns2:items id="description">A laboratory analyser was used to determine the result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.89">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.90">
                            <ns2:items id="text">Diet</ns2:items>
                            <ns2:items id="description">Description of when the patient has eaten.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.91">
                            <ns2:items id="text">Intake</ns2:items>
                            <ns2:items id="description">Description of calorific intake.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.92">
                            <ns2:items id="text">Fasting</ns2:items>
                            <ns2:items id="description">No calorific intake.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.93">
                            <ns2:items id="text">Post-prandial</ns2:items>
                            <ns2:items id="description">After a meal.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.94">
                            <ns2:items id="text">Pre-prandial</ns2:items>
                            <ns2:items id="description">Before a meal.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.95">
                            <ns2:items id="text">Random</ns2:items>
                            <ns2:items id="description">Timing is not known.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.96">
                            <ns2:items id="text">Duration</ns2:items>
                            <ns2:items id="description">The timing of the specimen in relation to the intake.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.97">
                            <ns2:items id="text">Description</ns2:items>
                            <ns2:items id="description">Description of the intake.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.98">
                            <ns2:items id="text">Glucose challenge</ns2:items>
                            <ns2:items id="description">Information about a glucose challenge if relevant.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.99">
                            <ns2:items id="text">Timing</ns2:items>
                            <ns2:items id="description">The relationship of the sample to the challenge.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000.1">
                            <ns2:items id="text">Blood glucose</ns2:items>
                            <ns2:items id="description">The concentration of glucose in the blood.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0005">
                            <ns2:items id="text">Test result name</ns2:items>
                            <ns2:items id="description">Identification of the pathology test performed, sometimes including specimen type. Coding with a terminology, potientially a pre-coordinated term including specimen type, is preferred, where possible. May be coded with LOINC or Snomed-CT. A test result may be for a single analyte, or a group of items, including panel tests.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0010">
                            <ns2:items id="text">Test result representation</ns2:items>
                            <ns2:items id="description">Rich text or other mutlimedia representation of the entire result as issued by the diagnostic service. Multiple formats are allowed but they must be semantically equivalent.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0040">
                            <ns2:items id="text">Corrected / Amended</ns2:items>
                            <ns2:items id="description">This is a correction which should completely replace any previous results.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0057">
                            <ns2:items id="text">Conclusion</ns2:items>
                            <ns2:items id="description">Concise and clinically contextualised narrative interpretation of the pathology test results.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0062">
                            <ns2:items id="text">Requester order identifier</ns2:items>
                            <ns2:items id="description">The local ID assigned to the order by the order requester. Equivalent to the Placer Order Identifier.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0065">
                            <ns2:items id="text">Specimen detail</ns2:items>
                            <ns2:items id="description">Details about the specimen if all individual test results are derived from the same specimen. If the specimen is sufficiently specified with a code in the Test result name, then this additional data is not required. If there are multiple specimens, these may be represented per 'Result group'.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0073">
                            <ns2:items id="text">Overall test result status</ns2:items>
                            <ns2:items id="description">The status of the pathology test result as a whole.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0074">
                            <ns2:items id="text">Cancelled / Aborted</ns2:items>
                            <ns2:items id="description">The test was aborted and never completed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0075">
                            <ns2:items id="description">The date and/or time that the result was issued for the recorded ‘test status’.</ns2:items>
                            <ns2:items id="text">Datetime result issued</ns2:items>
                            <ns2:items id="comment">The date and time related to the results status is useful for version control and cumulative results for the report.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0077">
                            <ns2:items id="text">Diagnostic service</ns2:items>
                            <ns2:items id="description">The diagnostic service that performs the examination e.g. biochemistry, haematology. Coding with a terminology is desirable, where possible.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0078">
                            <ns2:items id="text">Result value</ns2:items>
                            <ns2:items id="description">Actual value of the result. Most result values will be numerical measurements, but others may be coded concepts, free text, or multimedia images.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0078.2">
                            <ns2:items id="text">Blood glucose</ns2:items>
                            <ns2:items id="description">Concentration of blood glucose in the sample.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0089">
                            <ns2:items id="text">Per-result annotation</ns2:items>
                            <ns2:items id="description">Slot to allow an annotation to be added to a particular test result at run-time.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0090">
                            <ns2:items id="text">Requester</ns2:items>
                            <ns2:items id="description">Details of the clinician or organisation requesting the laboratory test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Laboratory test result</ns2:items>
                            <ns2:items id="description">Record the findings and interpretation of pathology tests performed on tissues and body fluids.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Event Series</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">Any event.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0004">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0017">
                            <ns2:items id="text">Receiving laboratory</ns2:items>
                            <ns2:items id="description">Demographic details of the laboratory with responsibility for the test. Details of secondary laboratories may also be included.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0037">
                            <ns2:items id="text">Interim</ns2:items>
                            <ns2:items id="description">This is an initial or interim result - further updates are anticipated.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0038">
                            <ns2:items id="text">Final</ns2:items>
                            <ns2:items id="description">This is the final result. No further alterations are anticipated.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0039">
                            <ns2:items id="text">Supplementary</ns2:items>
                            <ns2:items id="description">This is a supplementary result ehich should be appended to a previous result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0063">
                            <ns2:items id="text">Receiver order Identifier</ns2:items>
                            <ns2:items id="description">The local ID assigned to the test order by the order filler, usually by the (LIS) Laboratory Information System. Equivalent to the DICOM Accession Number and the Filler Order Identifier.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0068">
                            <ns2:items id="text">Laboratory test result identifier</ns2:items>
                            <ns2:items id="description">The identifier given to the laboratory test result of a pathology investigation.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0079">
                            <ns2:items id="text">Never performed</ns2:items>
                            <ns2:items id="description">The test was never performed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0094">
                            <ns2:items id="text">Test request details</ns2:items>
                            <ns2:items id="description">*</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0095">
                            <ns2:items id="text">Result group</ns2:items>
                            <ns2:items id="description">A group of results. Results may be grouped by specimen, or by some other name or code to describe what binds all the results together. If a name or code is used, it is provided by run-time re-naming of the 'Result group' element or may be fixed in a specialised archetype or template. Coding with a terminology, potentially a pre-coordinated term including specimen type, is preferred where possible for the name. Should be coded with LOINC or SNOMED CT, if possible.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0096">
                            <ns2:items id="text">Result</ns2:items>
                            <ns2:items id="description">Specific detailed result, including both the value of the result item, and additional information that may be useful for clinical interpretation. Results include whatever specific data items pathology labs report as part of the clinical service; it is not confined to measurements. The result is identified by run-time re-naming of the 'Result group' element or may be fixed in a specialised archetype or template. Coding with a terminology, potentially a pre-coordinated term including specimen type, is preferred where possible for the name. Should be coded with LOINC or SNOMED CT. Examples include: glucose, haemoglobin, phenotype, titre, or scatterplot image.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0097">
                            <ns2:items id="text">Specimen detail</ns2:items>
                            <ns2:items id="description">Details about the individual specimen to which these ‘Result group’ test results refer, where testing of multiple specimens is required.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0098">
                            <ns2:items id="text">Pathological diagnosis</ns2:items>
                            <ns2:items id="description">Single word, phrase or brief description representing the 'Conclusion'. Coding with a terminology is preferred, where possible.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0099">
                            <ns2:items id="text">DateTime result issued</ns2:items>
                            <ns2:items id="description">The date and/or time that the result was issued for the recorded ‘Overall test result status’.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0100">
                            <ns2:items id="text">Clinical information provided</ns2:items>
                            <ns2:items id="description">Description of clinical information available at the time of interpretation of results, or a link to the original clinical information provided in the test request.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0101">
                            <ns2:items id="text">Test comment</ns2:items>
                            <ns2:items id="description">Additional narrative about the test not captured in other fields.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0102">
                            <ns2:items id="text">Result comment</ns2:items>
                            <ns2:items id="description">May include statements about significant, unexpected or unreliable. values, or information about the source of the value where this may be relevant to the interpretation of the result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0103">
                            <ns2:items id="text">Reference range guidance</ns2:items>
                            <ns2:items id="description">Additional advice on the applicability of the reference range.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0104">
                            <ns2:items id="text">Date of analysis</ns2:items>
                            <ns2:items id="description">The date that the analysis was performed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0105">
                            <ns2:items id="text">Analysis method</ns2:items>
                            <ns2:items id="description">*</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0106">
                            <ns2:items id="text">Test requested name</ns2:items>
                            <ns2:items id="description">Identification of pathology test requested, where the test requested differs from the test actually performed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0107">
                            <ns2:items id="text">Registered</ns2:items>
                            <ns2:items id="description">The tst has been registered by the laboratory but a result is not yet available.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0108">
                            <ns2:items id="text">Result status</ns2:items>
                            <ns2:items id="description">The status of the result value.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0110">
                            <ns2:items id="text">Test procedure</ns2:items>
                            <ns2:items id="description">Additional structured details of pathology test methodology followed. For example, structured details about the laboratory method and data interpretation used.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0111">
                            <ns2:items id="text">Date Time result issued</ns2:items>
                            <ns2:items id="description">The date and/or time that the result was issued for the recorded ‘Result status’.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0112">
                            <ns2:items id="text">Entered in error</ns2:items>
                            <ns2:items id="description">The Test Result has been withdrawn following previous Final release</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0113">
                            <ns2:items id="text">Entered in error</ns2:items>
                            <ns2:items id="description">The Test Result has been withdrawn following previous Final release</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0114">
                            <ns2:items id="text">Result representation</ns2:items>
                            <ns2:items id="description">Result representation</ns2:items>
                        </ns2:term_definitions>
                    </ns2:children>
                    <ns2:children xsi:type="ns2:C_ARCHETYPE_ROOT">
