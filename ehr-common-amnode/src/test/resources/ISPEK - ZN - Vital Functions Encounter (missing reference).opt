                                                            <ns2:items id="text">Symptom name</ns2:items>
                                                            <ns2:items id="description">The symptom experienced.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0002">
                                                            <ns2:items id="text">Comments</ns2:items>
                                                            <ns2:items id="description">Description of the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0003">
                                                            <ns2:items id="text">Variation</ns2:items>
                                                            <ns2:items id="description">The variation of the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0004">
                                                            <ns2:items id="text">Continual</ns2:items>
                                                            <ns2:items id="description">The symptom is constantly present.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0005">
                                                            <ns2:items id="text">Intermittent</ns2:items>
                                                            <ns2:items id="description">The symptom is present at times and not at others.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0006">
                                                            <ns2:items id="text">Fluctuating</ns2:items>
                                                            <ns2:items id="description">The symptom varys considerably but is almost always present.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0008">
                                                            <ns2:items id="text">Onset</ns2:items>
                                                            <ns2:items id="description">The nature of the onset of the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0009">
                                                            <ns2:items id="text">Gradual</ns2:items>
                                                            <ns2:items id="description">Over a longer period of time.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0010">
                                                            <ns2:items id="text">Sudden</ns2:items>
                                                            <ns2:items id="description">Almost immediate.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0011">
                                                            <ns2:items id="text">Cessation</ns2:items>
                                                            <ns2:items id="description">The nature of the cessation of the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0015">
                                                            <ns2:items id="text">Associated factor</ns2:items>
                                                            <ns2:items id="description">An event, activity or state that is associated with the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0017">
                                                            <ns2:items id="text">Change</ns2:items>
                                                            <ns2:items id="description">An event or activity that makes the symptom worse.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0018">
                                                            <ns2:items id="text">Exascerbating factor</ns2:items>
                                                            <ns2:items id="description">Information about a specific factor that changes the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0019">
                                                            <ns2:items id="text">Factor</ns2:items>
                                                            <ns2:items id="description">An event or activity that modifies the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0020">
                                                            <ns2:items id="text">Pain effects</ns2:items>
                                                            <ns2:items id="description">Other symptoms associated with this symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0028">
                                                            <ns2:items id="text">Duration</ns2:items>
                                                            <ns2:items id="description">The duration of the symptom since onset.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0030">
                                                            <ns2:items id="text">Time of maximum intensity</ns2:items>
                                                            <ns2:items id="description">The time (and/or date) of maximum intensity of the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0031">
                                                            <ns2:items id="text">Number of occurrences</ns2:items>
                                                            <ns2:items id="description">The number of times this symptom has occurred during this episode.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0032">
                                                            <ns2:items id="text">Character</ns2:items>
                                                            <ns2:items id="description">The characteristics of the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0033">
                                                            <ns2:items id="text">Clinical course</ns2:items>
                                                            <ns2:items id="description">Features of the course of the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0035">
                                                            <ns2:items id="text">Nil significant</ns2:items>
                                                            <ns2:items id="description">The person has not had any significant experience of the symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0036">
                                                            <ns2:items id="text">Rapid</ns2:items>
                                                            <ns2:items id="description">Over a short period of time.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0037">
                                                            <ns2:items id="text">Progression</ns2:items>
                                                            <ns2:items id="description">The progress of the symptom relative to the past.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0038">
                                                            <ns2:items id="text">Improving</ns2:items>
                                                            <ns2:items id="description">The symptom has improved over time.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0039">
                                                            <ns2:items id="text">Decreasing</ns2:items>
                                                            <ns2:items id="description">The symptom is decreasing in intensity over time.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0040">
                                                            <ns2:items id="text">Stable</ns2:items>
                                                            <ns2:items id="description">The symptom has not changed over time.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0041">
                                                            <ns2:items id="text">Increasing</ns2:items>
                                                            <ns2:items id="description">The symptom is increasing in intensity over time.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0042">
                                                            <ns2:items id="text">Worsening</ns2:items>
                                                            <ns2:items id="description">The symptom is getting worse over time.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0043">
                                                            <ns2:items id="text">Has resolved</ns2:items>
                                                            <ns2:items id="description">The symptom has resolved over time.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0046">
                                                            <ns2:items id="text">Observed current intensity</ns2:items>
                                                            <ns2:items id="description">Measures of the intensity of the symptom. Assumed to represent current intensity. Left unbounded to allow maximum, minimum and average intensities to be recorded.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0048">
                                                            <ns2:items id="text">Relieved completely</ns2:items>
                                                            <ns2:items id="description">The symptom is relieved by this factor.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0049">
                                                            <ns2:items id="text">Made better</ns2:items>
                                                            <ns2:items id="description">The symptom is made better by this factor.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0050">
                                                            <ns2:items id="text">Somewhat improved</ns2:items>
                                                            <ns2:items id="description">The symptom is somewhat improved by this factor.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0051">
                                                            <ns2:items id="text">No change</ns2:items>
                                                            <ns2:items id="description">The symptom is not modified by this factor.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0052">
                                                            <ns2:items id="text">Somewhat worse</ns2:items>
                                                            <ns2:items id="description">The symptom is made somewhat worse by this factor.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0053">
                                                            <ns2:items id="text">Made worse</ns2:items>
                                                            <ns2:items id="description">The symptom is made worse by this factor.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0054">
                                                            <ns2:items id="text">Much worse</ns2:items>
                                                            <ns2:items id="description">The symptom is made much worse by this factor.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0056">
                                                            <ns2:items id="text">Description</ns2:items>
                                                            <ns2:items id="description">Details of the effect.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0057">
                                                            <ns2:items id="text">Description</ns2:items>
                                                            <ns2:items id="description">Details of previous symptoms and comparison to this episode.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0058">
                                                            <ns2:items id="text">Previous episodes</ns2:items>
                                                            <ns2:items id="description">Details about previous episodes.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0059">
                                                            <ns2:items id="text">Any previous episodes</ns2:items>
                                                            <ns2:items id="description">Have there been any previous episodes of this symptom?</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0060">
                                                            <ns2:items id="text">Description</ns2:items>
                                                            <ns2:items id="description">Text description of the course of the symptom over time.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0062">
                                                            <ns2:items id="text">Absent expected feature</ns2:items>
                                                            <ns2:items id="description">A feature which would normally be expected but which is not present.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0063">
                                                            <ns2:items id="text">Associated symptom detail</ns2:items>
                                                            <ns2:items id="description">Associated symptoms.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0090">
                                                            <ns2:items id="text">Previous episode</ns2:items>
                                                            <ns2:items id="description">Details about a specific episode.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0098">
                                                            <ns2:items id="text">Number of previous episodes</ns2:items>
                                                            <ns2:items id="description">Number of previous episodes.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0142">
                                                            <ns2:items id="text">Date / time of previous episode</ns2:items>
                                                            <ns2:items id="description">Date/time of previous episode.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0143">
                                                            <ns2:items id="text">Comparison</ns2:items>
                                                            <ns2:items id="description">How the previous episode compares with this one.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0146">
                                                            <ns2:items id="text">Detail</ns2:items>
                                                            <ns2:items id="description">Structured details of symptoms in previous episodes.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0147">
                                                            <ns2:items id="text">Location in body</ns2:items>
                                                            <ns2:items id="description">Details of locations in the body.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0152">
                                                            <ns2:items id="text">Record of previous episode</ns2:items>
                                                            <ns2:items id="description">Link to a previous record of this symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0154">
                                                            <ns2:items id="text">Course</ns2:items>
                                                            <ns2:items id="description">The overall clinical course.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0155">
                                                            <ns2:items id="text">Acute</ns2:items>
                                                            <ns2:items id="description">Short-lived and/or rapid onset of symptoms.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0156">
                                                            <ns2:items id="text">Chronic</ns2:items>
                                                            <ns2:items id="description">Long-standing symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0157">
                                                            <ns2:items id="text">Chonic relapsing</ns2:items>
                                                            <ns2:items id="description">Long-standing symptom with regular exacerbations.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0158">
                                                            <ns2:items id="text">Acute-on-chronic</ns2:items>
                                                            <ns2:items id="description">Acute episode on background of lon-standing symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0160">
                                                            <ns2:items id="text">Scale detail</ns2:items>
                                                            <ns2:items id="description">Detail of symptom formal scoring methods and results.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0161">
                                                            <ns2:items id="text">Description</ns2:items>
                                                            <ns2:items id="description">A text description of the symptom intensity.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0162">
                                                            <ns2:items id="text">Cyclical</ns2:items>
                                                            <ns2:items id="description">The symptom is present on a cyclical basis.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0163">
                                                            <ns2:items id="text">Seasonal</ns2:items>
                                                            <ns2:items id="description">The sympton is present on a seasonal basis.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0164">
                                                            <ns2:items id="text">Fluctuating</ns2:items>
                                                            <ns2:items id="description">The symptom presence or intensity fluctuates.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0165">
                                                            <ns2:items id="text">Paroxysmal</ns2:items>
                                                            <ns2:items id="description">The symptom appears suddenly and dramatically.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0166">
                                                            <ns2:items id="text">Degree</ns2:items>
                                                            <ns2:items id="description">The degree to which the symptom is bothering the patient.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0167">
                                                            <ns2:items id="text">Associated symptom</ns2:items>
                                                            <ns2:items id="description">Any associated symptom.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0175">
                                                            <ns2:items id="text">Degree / level</ns2:items>
                                                            <ns2:items id="description">Symptom severity score on a scale of 0-10.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0176">
                                                            <ns2:items id="text">Scale name</ns2:items>
                                                            <ns2:items id="description">*</ns2:items>
                                                        </ns2:term_definitions>
                                                    </ns2:children>
                                                    <ns2:cardinality>
                                                        <ns2:is_ordered>false</ns2:is_ordered>
                                                        <ns2:is_unique>false</ns2:is_unique>
                                                        <ns2:interval>
                                                            <ns2:lower_included>true</ns2:lower_included>
                                                            <ns2:upper_included>false</ns2:upper_included>
                                                            <ns2:lower_unbounded>false</ns2:lower_unbounded>
                                                            <ns2:upper_unbounded>true</ns2:upper_unbounded>
                                                            <ns2:lower>1</ns2:lower>
                                                        </ns2:interval>
                                                    </ns2:cardinality>
                                                </ns2:attributes>
                                            </ns2:children>
                                        </ns2:attributes>
                                    </ns2:children>
                                    <ns2:cardinality>
                                        <ns2:is_ordered>false</ns2:is_ordered>
                                        <ns2:is_unique>false</ns2:is_unique>
                                        <ns2:interval>
                                            <ns2:lower_included>true</ns2:lower_included>
                                            <ns2:upper_included>false</ns2:upper_included>
                                            <ns2:lower_unbounded>false</ns2:lower_unbounded>
                                            <ns2:upper_unbounded>true</ns2:upper_unbounded>
                                            <ns2:lower>1</ns2:lower>
                                        </ns2:interval>
                                    </ns2:cardinality>
                                </ns2:attributes>
                            </ns2:children>
                        </ns2:attributes>
                        <ns2:attributes xsi:type="ns2:C_SINGLE_ATTRIBUTE">
                            <ns2:rm_attribute_name>name</ns2:rm_attribute_name>
                            <ns2:existence>
                                <ns2:lower_included>true</ns2:lower_included>
                                <ns2:upper_included>true</ns2:upper_included>
                                <ns2:lower_unbounded>false</ns2:lower_unbounded>
                                <ns2:upper_unbounded>false</ns2:upper_unbounded>
                                <ns2:lower>1</ns2:lower>
                                <ns2:upper>1</ns2:upper>
                            </ns2:existence>
                            <ns2:match_negated>false</ns2:match_negated>
                            <ns2:children xsi:type="ns2:C_COMPLEX_OBJECT">
                                <ns2:rm_type_name>DV_TEXT</ns2:rm_type_name>
                                <ns2:occurrences>
                                    <ns2:lower_included>true</ns2:lower_included>
                                    <ns2:upper_included>true</ns2:upper_included>
                                    <ns2:lower_unbounded>false</ns2:lower_unbounded>
                                    <ns2:upper_unbounded>false</ns2:upper_unbounded>
                                    <ns2:lower>1</ns2:lower>
                                    <ns2:upper>1</ns2:upper>
                                </ns2:occurrences>
                                <ns2:node_id></ns2:node_id>
                                <ns2:attributes xsi:type="ns2:C_SINGLE_ATTRIBUTE">
                                    <ns2:rm_attribute_name>value</ns2:rm_attribute_name>
                                    <ns2:existence>
                                        <ns2:lower_included>true</ns2:lower_included>
                                        <ns2:upper_included>true</ns2:upper_included>
                                        <ns2:lower_unbounded>false</ns2:lower_unbounded>
                                        <ns2:upper_unbounded>false</ns2:upper_unbounded>
                                        <ns2:lower>1</ns2:lower>
                                        <ns2:upper>1</ns2:upper>
                                    </ns2:existence>
                                    <ns2:match_negated>false</ns2:match_negated>
                                    <ns2:children xsi:type="ns2:C_PRIMITIVE_OBJECT">
                                        <ns2:rm_type_name>STRING</ns2:rm_type_name>
                                        <ns2:occurrences>
                                            <ns2:lower_included>true</ns2:lower_included>
                                            <ns2:upper_included>true</ns2:upper_included>
                                            <ns2:lower_unbounded>false</ns2:lower_unbounded>
                                            <ns2:upper_unbounded>false</ns2:upper_unbounded>
                                            <ns2:lower>1</ns2:lower>
                                            <ns2:upper>1</ns2:upper>
                                        </ns2:occurrences>
                                        <ns2:node_id></ns2:node_id>
                                        <ns2:item xsi:type="ns2:C_STRING">
                                            <ns2:list>Story</ns2:list>
                                        </ns2:item>
                                    </ns2:children>
                                </ns2:attributes>
                            </ns2:children>
                        </ns2:attributes>
                        <ns2:archetype_id>
                            <ns2:value>openEHR-EHR-OBSERVATION.story.v1</ns2:value>
                        </ns2:archetype_id>
                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Story</ns2:items>
                            <ns2:items id="description">A structure to collect information provided by the person or information provider in relation to the symptoms and difficulties they are presenting to the clinician</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Event Series</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">Base for recording the dates or intervals which apply</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0004">
                            <ns2:items id="text">Story</ns2:items>
                            <ns2:items id="description">Information provided about the person</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0006">
                            <ns2:items id="text">Detail</ns2:items>
                            <ns2:items id="description">*</ns2:items>
                        </ns2:term_definitions>
                    </ns2:children>
                    <ns2:cardinality>
                        <ns2:is_ordered>false</ns2:is_ordered>
                        <ns2:is_unique>false</ns2:is_unique>
                        <ns2:interval>
                            <ns2:lower_included>true</ns2:lower_included>
                            <ns2:upper_included>false</ns2:upper_included>
                            <ns2:lower_unbounded>false</ns2:lower_unbounded>
                            <ns2:upper_unbounded>true</ns2:upper_unbounded>
                            <ns2:lower>1</ns2:lower>
                        </ns2:interval>
                    </ns2:cardinality>
                </ns2:attributes>
                <ns2:attributes xsi:type="ns2:C_SINGLE_ATTRIBUTE">
                    <ns2:rm_attribute_name>name</ns2:rm_attribute_name>
                    <ns2:existence>
                        <ns2:lower_included>true</ns2:lower_included>
                        <ns2:upper_included>true</ns2:upper_included>
                        <ns2:lower_unbounded>false</ns2:lower_unbounded>
                        <ns2:upper_unbounded>false</ns2:upper_unbounded>
                        <ns2:lower>1</ns2:lower>
                        <ns2:upper>1</ns2:upper>
                    </ns2:existence>
                    <ns2:match_negated>false</ns2:match_negated>
                    <ns2:children xsi:type="ns2:C_COMPLEX_OBJECT">
                        <ns2:rm_type_name>DV_TEXT</ns2:rm_type_name>
                        <ns2:occurrences>
                            <ns2:lower_included>true</ns2:lower_included>
                            <ns2:upper_included>true</ns2:upper_included>
                            <ns2:lower_unbounded>false</ns2:lower_unbounded>
                            <ns2:upper_unbounded>false</ns2:upper_unbounded>
                            <ns2:lower>1</ns2:lower>
                            <ns2:upper>1</ns2:upper>
                        </ns2:occurrences>
                        <ns2:node_id></ns2:node_id>
                        <ns2:attributes xsi:type="ns2:C_SINGLE_ATTRIBUTE">
                            <ns2:rm_attribute_name>value</ns2:rm_attribute_name>
                            <ns2:existence>
                                <ns2:lower_included>true</ns2:lower_included>
                                <ns2:upper_included>true</ns2:upper_included>
                                <ns2:lower_unbounded>false</ns2:lower_unbounded>
                                <ns2:upper_unbounded>false</ns2:upper_unbounded>
                                <ns2:lower>1</ns2:lower>
