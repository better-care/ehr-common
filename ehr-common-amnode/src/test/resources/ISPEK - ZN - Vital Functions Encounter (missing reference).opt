                                                        <ns2:term_definitions code="at0.0.205">
                                                            <ns2:items id="text">Tolerance</ns2:items>
                                                            <ns2:items id="description">A pain tolerance measure was used.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.0.206">
                                                            <ns2:items id="text">Activity</ns2:items>
