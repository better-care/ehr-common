                                                                                        <ns2:pattern>openEHR-EHR-CLUSTER\.bodily_substance(-[a-zA-Z0-9_]+)*\.v1</ns2:pattern>
                                                                                    </ns2:item>
                                                                                    <ns2:reference_type>constraint</ns2:reference_type>
                                                                                </ns2:right_operand>
                                                                            </ns2:expression>
