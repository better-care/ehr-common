    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.indirect_oximetry.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Posredna oksimetrija</ns2:items>
                <ns2:items id="description">Metoda merjenja prisotnosti plnov kot so Spo2 in TCO2 na indirekten, posreden n-invazivni način</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Event Series(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">*Any event(en)</ns2:items>
                <ns2:items id="description">*Timing event.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="description">Saturacija kisika v krvi izmerjena s pulzno oksimetrijo.</ns2:items>
                <ns2:items id="text">SpO2</ns2:items>
                <ns2:items id="comment">*SpO2 is defined as the ratio of oxyhaemoglobin (HbO2) to the total concentration of haemoglobin (HbO2 + deoxyhaemoglobin).(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0007">
                <ns2:items id="text">*List(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0009">
                <ns2:items id="text">*Sensor site(en)</ns2:items>
                <ns2:items id="description">*The site of the measurement sensor.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0014">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0015">
                <ns2:items id="text">FiO2</ns2:items>
                <ns2:items id="description">Delež kisika v vdihanem zraku.</ns2:items>
            </ns2:items>
            <ns2:items code="at0016">
                <ns2:items id="text">*Confounding factors(en)</ns2:items>
                <ns2:items id="description">*Comment on and record other incidental factors that may be affect interpretation of the observation. For example, motion, pain, poor perfusion, infant feeding.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">Naprava</ns2:items>
                <ns2:items id="description">Naprava za neinvazivno oksimetrijo</ns2:items>
            </ns2:items>
            <ns2:items code="at0019">
                <ns2:items id="text">*Multimedia image(en)</ns2:items>
                <ns2:items id="description">*Details of a series of oximetry readings, other than waveforms, expressed as a multimedia image or series of images. Waveforms should be recorded using the Waveform slot and associated cluster archetype.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0020">
                <ns2:items id="text">Vrsta senzorja</ns2:items>
                <ns2:items id="description">*The type of measurement sensor used e.g. transmittal, reflective, clamp or strip, electrode.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0034">
                <ns2:items id="text">Napor</ns2:items>
                <ns2:items id="description">*Details about physical activity undertaken at the time of measurement.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0036">
                <ns2:items id="text">Opombe</ns2:items>
                <ns2:items id="description">*A text comment about the indirect oximetry result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0037">
                <ns2:items id="text">*Electrode operating temperature(en)</ns2:items>
                <ns2:items id="description">*The operating temperature of a transcutaneous oximeter electrode.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">*Time of sensor application(en)</ns2:items>
                <ns2:items id="description">*The date and time at which the sensor was applied. Significant for transcutaneous oximetry.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0039">
                <ns2:items id="text">tcpO2</ns2:items>
                <ns2:items id="description">Transkutani parcialni pritisk kisika v kapilarah.</ns2:items>
            </ns2:items>
            <ns2:items code="at0040">
                <ns2:items id="text">tcpCO2</ns2:items>
                <ns2:items id="description">Transkutani parcialni pritisk ogljikovega dioksida v kapilarah.</ns2:items>
            </ns2:items>
            <ns2:items code="at0044">
                <ns2:items id="text">spOC</ns2:items>
                <ns2:items id="description">Izmerjeno s puzlno CO-oksimetrijo, vsebnost kisika v periferni krvi. </ns2:items>
            </ns2:items>
            <ns2:items code="at0045">
                <ns2:items id="text">spCO</ns2:items>
                <ns2:items id="description">Merjeno s pulzno CO-oksimetrijo, zasičenost carboxyhaemoglobin v perpiherni krvi.</ns2:items>
            </ns2:items>
            <ns2:items code="at0046">
                <ns2:items id="text">spMet</ns2:items>
                <ns2:items id="description">Merjeno s pulzno CO-oksimetrijo, zasičenost methoxyhaemoglobin v periferni krvi.</ns2:items>
            </ns2:items>
            <ns2:items code="at0048">
                <ns2:items id="text">*Transmittal(en)</ns2:items>
                <ns2:items id="description">*A pulse oximetry transmittal sensor was applied.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0049">
                <ns2:items id="text">*Reflective(en)</ns2:items>
                <ns2:items id="description">*A pulse oximetry reflective sensor was applied.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0050">
                <ns2:items id="text">*Clamp(en)</ns2:items>
                <ns2:items id="description">*A pulse oximetry clamp sensor was applied.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0051">
                <ns2:items id="text">*Strip(en)</ns2:items>
                <ns2:items id="description">*A pulse oximetry strip sensor was applied.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0052">
                <ns2:items id="text">*Electrode(en)</ns2:items>
                <ns2:items id="description">*A transcutaneous electrode sensor was applied.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0054">
                <ns2:items id="text">*Waveform(en)</ns2:items>
                <ns2:items id="description">*A waveform reading associated with the oximetry measurement.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0058">
                <ns2:items id="text">Lokacija meritve SaO2</ns2:items>
                <ns2:items id="description">Lokacija meritve SaO2</ns2:items>
            </ns2:items>
            <ns2:items code="at0059">
                <ns2:items id="text">Prst leve roke</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na prstih leve roke</ns2:items>
            </ns2:items>
            <ns2:items code="at0060">
                <ns2:items id="text">Prst desne roke</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na prstih desne roke</ns2:items>
            </ns2:items>
            <ns2:items code="at0061">
                <ns2:items id="text">Prst leve noge</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na prstih leve noge</ns2:items>
            </ns2:items>
            <ns2:items code="at0062">
                <ns2:items id="text">Prst desne noge</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na prstih desne noge</ns2:items>
            </ns2:items>
            <ns2:items code="at0063">
                <ns2:items id="text">Dlan leve roke</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na dlani leve roke</ns2:items>
            </ns2:items>
            <ns2:items code="at0064">
                <ns2:items id="text">Dlan desne roke</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na dlani desne roke</ns2:items>
            </ns2:items>
            <ns2:items code="at0065">
                <ns2:items id="text">Leva noga</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na levi nogi</ns2:items>
            </ns2:items>
            <ns2:items code="at0066">
                <ns2:items id="text">Desna noga</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na desni nogi</ns2:items>
            </ns2:items>
            <ns2:items code="at0067">
                <ns2:items id="text">Levi uhelj</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na levem uhlju</ns2:items>
            </ns2:items>
            <ns2:items code="at0068">
                <ns2:items id="text">Desni uhelj</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na desnem uhlju</ns2:items>
            </ns2:items>
            <ns2:items code="at0069">
                <ns2:items id="text">Čelo</ns2:items>
                <ns2:items id="description">SaO2 je izmerjen na čelu</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-ACTION.procedure.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Aspiration</ns2:items>
                <ns2:items id="description">Izvedena klinična aktivnost</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">Aktivnost</ns2:items>
                <ns2:items id="description">Ime, naziv postopka, aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">Podrobnosti</ns2:items>
                <ns2:items id="description">Podroben opis izvedene aktivnosti, npr. priprave, uporabljena metoda, oprema in naprave</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Neopravljeno</ns2:items>
                <ns2:items id="description">TRUE (resnično) pomeni, da aktivnost ni bila opravljena s kliničnega vidika</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">Opombe</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">Zapleti</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0013">
                <ns2:items id="text">Multimedija</ns2:items>
                <ns2:items id="description">Multimedijske predstavitve, npr. slika</ns2:items>
            </ns2:items>
            <ns2:items code="at0014">
                <ns2:items id="text">Razlog</ns2:items>
                <ns2:items id="description">Razlogi za izvedbo aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0015">
                <ns2:items id="text">Nenačrtovan dogodek</ns2:items>
                <ns2:items id="description">Nenačrtovan dogodek, npr. neželen dogodek, ki vpliva na aktivnost</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">Neuspešni poskusi</ns2:items>
                <ns2:items id="description">Število neuspešnih poskusov izvedbe</ns2:items>
            </ns2:items>
            <ns2:items code="at0030">
                <ns2:items id="text">Dodatne naloge</ns2:items>
                <ns2:items id="description">Podatki o nenačrtovanih aktivnostih, katere je bilo potrebno izvesti med aktivnostjo. Ta arhetip zajema naziv in opis naloge, drugi podatki o nalogi pa naj se zapišejo v povezanih (link) arhetipih tipa INSTRUCTION ali ACTION</ns2:items>
            </ns2:items>
            <ns2:items code="at0031">
                <ns2:items id="text">Opis naloge</ns2:items>
                <ns2:items id="description">Opis dodatnih nalog med izvajanjem aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0032">
                <ns2:items id="text">Zapis dodanih nalog</ns2:items>
                <ns2:items id="description">Povazava na zapis o dodatni nalogi</ns2:items>
            </ns2:items>
            <ns2:items code="at0034">
                <ns2:items id="text">Zahteva, sprožena</ns2:items>
                <ns2:items id="description">Initiated - začeta</ns2:items>
            </ns2:items>
            <ns2:items code="at0035">
                <ns2:items id="text">Zahteva, poslana</ns2:items>
                <ns2:items id="description">Sent - poslana v task sezname izvajalcev</ns2:items>
            </ns2:items>
            <ns2:items code="at0036">
                <ns2:items id="text">Aktivnost, načrtovana</ns2:items>
                <ns2:items id="description">Scheduled - načrtovana v urniku</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">Zahteva, preložena</ns2:items>
                <ns2:items id="description">Postoponed - preložena na kasnejši čas</ns2:items>
            </ns2:items>
            <ns2:items code="at0039">
                <ns2:items id="text">Zahteva, preklicana</ns2:items>
                <ns2:items id="description">Cancelled - preklicana zahteva</ns2:items>
            </ns2:items>
            <ns2:items code="at0040">
                <ns2:items id="text">Zahteva, na čakanju</ns2:items>
                <ns2:items id="description">Suspend - zahteva trenutno miruje, lahko jo nadaljujemo v prihodnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0041">
                <ns2:items id="text">Zahteva, takojšnja zaustavitev</ns2:items>
                <ns2:items id="description">Aborted - nepreklicno ustavljena zahteva</ns2:items>
            </ns2:items>
            <ns2:items code="at0043">
                <ns2:items id="text">Zahteva, izvedena</ns2:items>
                <ns2:items id="description">Completed</ns2:items>
            </ns2:items>
            <ns2:items code="at0044">
                <ns2:items id="text">Poročilo pripravljeno</ns2:items>
                <ns2:items id="description">Written - kreirano</ns2:items>
            </ns2:items>
            <ns2:items code="at0045">
                <ns2:items id="text">Poročilo potrjeno</ns2:items>
                <ns2:items id="description">Attested - primerno za distribucijo</ns2:items>
            </ns2:items>
            <ns2:items code="at0046">
                <ns2:items id="text">Poročilo poslano</ns2:items>
                <ns2:items id="description">Sent - distribuirano prejemnikom</ns2:items>
            </ns2:items>
            <ns2:items code="at0047">
                <ns2:items id="text">Se izvaja</ns2:items>
                <ns2:items id="description">Aktinost je v teku</ns2:items>
            </ns2:items>
            <ns2:items code="at0048">
                <ns2:items id="text">Rezultat</ns2:items>
                <ns2:items id="description">Rezultat, sprotno vrednotenje izvedene aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0049">
                <ns2:items id="text">Opis</ns2:items>
                <ns2:items id="description">Narrative description about the procedure carried out.</ns2:items>
            </ns2:items>
            <ns2:items code="at0050">
                <ns2:items id="text">Anatomska lokacija</ns2:items>
                <ns2:items id="description">Podrobnosti o anatomski lokaciji, vezani na aktivnost</ns2:items>
            </ns2:items>
            <ns2:items code="at0051">
                <ns2:items id="text">Metoda, tehnika</ns2:items>
                <ns2:items id="description">ID uporabljene metode oz. tehnike</ns2:items>
            </ns2:items>
            <ns2:items code="at0052">
                <ns2:items id="text">Naloga</ns2:items>
                <ns2:items id="description">Naziv dodatne naloge, ki se je izvedla med aktivnostjo</ns2:items>
            </ns2:items>
            <ns2:items code="at0053">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0054">
                <ns2:items id="text">ID naročila - naročnik</ns2:items>
                <ns2:items id="description">Interni ID naročila, kot ga določi naročnik, npr. številka napotnice</ns2:items>
            </ns2:items>
            <ns2:items code="at0055">
                <ns2:items id="text">Naročnik</ns2:items>
                <ns2:items id="description">Kdo je naročil aktivnost, posameznik ali organizacija</ns2:items>
            </ns2:items>
            <ns2:items code="at0056">
                <ns2:items id="text">ID naročila - prejemnik</ns2:items>
                <ns2:items id="description">Interni ID naročila, kot ga določi prejemnik, npr. zap.št.pošte</ns2:items>
            </ns2:items>
            <ns2:items code="at0057">
                <ns2:items id="text">Prejemnik</ns2:items>
                <ns2:items id="description">Prejemnik naročila za izvedbo aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0060">
                <ns2:items id="text">Odstopanja</ns2:items>
                <ns2:items id="description">Opis odstopanj med načrtovano in izvedeno aktivnostjo</ns2:items>
            </ns2:items>
            <ns2:items code="at0061">
                <ns2:items id="text">Lokalizacija</ns2:items>
                <ns2:items id="description">Podrobnosti za podporo procesom in drugim lokalnim zahtavam (cluster)</ns2:items>
            </ns2:items>
            <ns2:items code="at0062">
                <ns2:items id="text">Opis naloge</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0063">
                <ns2:items id="text">Datum in ura izvedbe</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-CLUSTER.aspiration_zn.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Aspiracija</ns2:items>
                <ns2:items id="description">Respiratorna aspiracija, ki se izvede v okviru ZN</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">Tip ventilacije</ns2:items>
                <ns2:items id="description">Uporabljeni sistem ventilacije</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">Filtra</ns2:items>
                <ns2:items id="description">Kdaj je bil zadnjič zamenjan filter na aspiratorju</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">Vrečke</ns2:items>
                <ns2:items id="description">Kdaj je bila zadnjič zamenjana vrečka na aspiratorju</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Aspiracijska cevka</ns2:items>
                <ns2:items id="description">Kdaj je bila zadnjič zamenjana aspiracijska cev na aspiratorju</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">Pot aspiracije</ns2:items>
                <ns2:items id="description">Pot aspiracije pacienta</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">Razlog menjave vrečke</ns2:items>
                <ns2:items id="description">Zakaj je bila zamenjana vrečka na aspiratorju?</ns2:items>
            </ns2:items>
            <ns2:items code="at0007">
                <ns2:items id="text">Sputum</ns2:items>
                <ns2:items id="description">Podrobnosti o sputumu</ns2:items>
            </ns2:items>
            <ns2:items code="at0008">
                <ns2:items id="text">Umetna ventilacija</ns2:items>
                <ns2:items id="description">Ali je pacient bil umetno ventiliran?</ns2:items>
            </ns2:items>
            <ns2:items code="at0009">
                <ns2:items id="text">Usta</ns2:items>
                <ns2:items id="description">Aspiracija skozi usta</ns2:items>
            </ns2:items>
            <ns2:items code="at0010">
                <ns2:items id="text">Nos</ns2:items>
                <ns2:items id="description">Aspiracija skozi nos</ns2:items>
            </ns2:items>
            <ns2:items code="at0011">
                <ns2:items id="text">Tubus</ns2:items>
                <ns2:items id="description">Aspiracija skozi tubus</ns2:items>
            </ns2:items>
            <ns2:items code="at0012">
                <ns2:items id="text">Kanila</ns2:items>
                <ns2:items id="description">Aspiracija skozi kanilo</ns2:items>
            </ns2:items>
            <ns2:items code="at0013">
                <ns2:items id="text">Zaprt sistem</ns2:items>
                <ns2:items id="description">Zaprt sistem ventialcije</ns2:items>
            </ns2:items>
            <ns2:items code="at0014">
                <ns2:items id="text">Odprt sistem</ns2:items>
                <ns2:items id="description">Odprt sistem ventilacije</ns2:items>
            </ns2:items>
            <ns2:items code="at0015">
                <ns2:items id="text">na 24 ur</ns2:items>
                <ns2:items id="description">Menjava vrečke n a24 ur</ns2:items>
            </ns2:items>
            <ns2:items code="at0016">
                <ns2:items id="text">2/3 polna</ns2:items>
                <ns2:items id="description">Menjava vrečke, ko je ta polna 2/3</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.pulmonary_function-zn.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0.125">
                <ns2:items id="text">Test</ns2:items>
                <ns2:items id="description">Status testa</ns2:items>
            </ns2:items>
            <ns2:items code="at0.126">
                <ns2:items id="text">Izmerjen</ns2:items>
                <ns2:items id="description">Izmerjen</ns2:items>
            </ns2:items>
            <ns2:items code="at0.127">
                <ns2:items id="text">Ni izmerjen</ns2:items>
                <ns2:items id="description">Ni izmerjen</ns2:items>
            </ns2:items>
            <ns2:items code="at0.128">
                <ns2:items id="text">Ne zmore</ns2:items>
                <ns2:items id="description">Pacient ni sposeben izvesti test</ns2:items>
            </ns2:items>
            <ns2:items code="at0.129">
                <ns2:items id="text">Premlad</ns2:items>
                <ns2:items id="description">Pacient je premlad za izvedbo testa</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1">
                <ns2:items id="text">PEF before</ns2:items>
                <ns2:items id="description">*Pulmonary function testing including spirometry and other lung volume testing, according to ZN documentation(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0000">
                <ns2:items id="text">*Pulmonary function tests(en)</ns2:items>
                <ns2:items id="description">*Pulmonary function testing including spirometry and other lung volume testing.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Event Series(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">*Any event(en)</ns2:items>
                <ns2:items id="description">*Any event(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0008">
                <ns2:items id="text">Predviden</ns2:items>
                <ns2:items id="description">Predviden PEF</ns2:items>
            </ns2:items>
            <ns2:items code="at0013">
                <ns2:items id="text">*Forced expiratory time (FET)(en)</ns2:items>
                <ns2:items id="description">*The time taken to complete  a forced expiration.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">*Predicted(en)</ns2:items>
                <ns2:items id="description">*Predicted pulmonary test ratio result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0027">
                <ns2:items id="text">*Anatomical dead space(en)</ns2:items>
                <ns2:items id="description">*The volume of the conducting airways.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0029">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0030">
                <ns2:items id="text">*Device(en)</ns2:items>
                <ns2:items id="description">*Details of the device used to measure pulmonary function.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0031">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0033">
                <ns2:items id="text">*Spirography(en)</ns2:items>
                <ns2:items id="description">*Graphs produced by spirometry.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0034">
                <ns2:items id="text">*Volume-time curve(en)</ns2:items>
                <ns2:items id="description">*Shows volume (liters) along the Y-axis and time (seconds) along the X-axis.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0035">
                <ns2:items id="text">*Flow-volume loop(en)</ns2:items>
                <ns2:items id="description">*Graphically depicts the rate of airflow on the Y-axis and the total volume inspired or expired on the X-axis(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0037">
                <ns2:items id="comment">*In North America the unit for D, co is mL CO/min/mm Hg.&#13;
The Systeme Internationale unit is mmol/min/kPa, and in&#13;
Europe the test is called the CO transfer factor. The following&#13;
equation converts between the 2 units:&#13;
D,   2.986 X T(en)</ns2:items>
                <ns2:items id="text">*CO transfer factor (DLCO test)(en)</ns2:items>
                <ns2:items id="description">*Also called carbon monoxide diffusing capacity test .(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">*Maximal oxygen consumption (VO2max)(en)</ns2:items>
                <ns2:items id="description">*The maximum capacity of an individual's body to transport and utilize oxygen during incremental exercise.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0044">
                <ns2:items id="text">*Actual/predicted ratio(en)</ns2:items>
                <ns2:items id="description">*The ratio of actual to predicted test result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0046">
                <ns2:items id="text">*Bronchial challenge(en)</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0047">
                <ns2:items id="text">*Agent/modality(en)</ns2:items>
                <ns2:items id="description">*The agent or physical modality used e.g exercise.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0048">
                <ns2:items id="text">*Dose(en)</ns2:items>
                <ns2:items id="description">*The dose of agent used in the test.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0049">
                <ns2:items id="text">*Bronchodilation(en)</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0051">
                <ns2:items id="text">*Agent(en)</ns2:items>
                <ns2:items id="description">*The bronchodilating agent used in the test.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0052">
                <ns2:items id="text">*Pulmonary volume(en)</ns2:items>
                <ns2:items id="description">*Pulmonary function test that returns a measured volume or caclulated capacity.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0053">
                <ns2:items id="text">*Actual(en)</ns2:items>
                <ns2:items id="description">*Actual pulmonary volume test result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0054">
                <ns2:items id="text">*Predicted(en)</ns2:items>
                <ns2:items id="description">*Predicted pulmonary  volume test result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0055">
                <ns2:items id="text">*Pulmonary ratio(en)</ns2:items>
                <ns2:items id="description">*A pulmonary function test result expressed as a ratio.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0056">
                <ns2:items id="text">*Actual(en)</ns2:items>
                <ns2:items id="description">*Actual pulmonary test ratio result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0057">
                <ns2:items id="text">PEF</ns2:items>
                <ns2:items id="description">Merjenje največjega pretoka zraka pri ustih</ns2:items>
            </ns2:items>
            <ns2:items code="at0058">
                <ns2:items id="text">Izmerjen</ns2:items>
                <ns2:items id="description">Dejanski, izmerjen PEF</ns2:items>
            </ns2:items>
            <ns2:items code="at0064">
                <ns2:items id="text">*Slow vital capacity (SVC/EVC)(en)</ns2:items>
                <ns2:items id="description">*The amount of air that can be forced out of the lungs after a maximal inspiration. Emphasis on completeness of expiration. Also termed expiratory vital capacity (EVC) Calculated= IRV+ Vt+ ERV(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0065">
                <ns2:items id="text">*Forced vital capacity (FVC)(en)</ns2:items>
                <ns2:items id="description">*The volume change of the lung between a full inspiration to total lung capacity and a maximal expiration to residual volume.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0066">
                <ns2:items id="text">*Total lung capacity (TLC)(en)</ns2:items>
                <ns2:items id="description">*The volume of gas contained in the lung after a full inhalation.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0067">
                <ns2:items id="text">*Forced expiratory volume in 1 sec (FEV1)(en)</ns2:items>
                <ns2:items id="description">*The amount of air that can be forcibly blown out in one second.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0068">
                <ns2:items id="text">*Forced expiratory volume in 3 sec (FEV3)(en)</ns2:items>
                <ns2:items id="description">*The amount of air that can be forcibly blown out in three seconds.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0069">
                <ns2:items id="text">*Forced expiratory volume in 6 sec (FEV6)(en)</ns2:items>
                <ns2:items id="description">*The amount of air that can be forcibly blown out in six seconds.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0070">
                <ns2:items id="text">*Forced expiratory volume in .75 sec (FEV.75)(en)</ns2:items>
                <ns2:items id="description">*The amount of air that can be forcibly blown out in 0.75 of a second.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0071">
                <ns2:items id="text">*Peak expiratory flow (PEF)(en)</ns2:items>
                <ns2:items id="description">*The maximum flow generated during expiration performed with maximal force and started after a full inspiration. Also termed Peak Expiratory Flow Rate (PEFR).(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0072">
                <ns2:items id="text">*Forced expiratory flow 25-75% (FEF25-75%)(en)</ns2:items>
                <ns2:items id="description">*The average flow of air from the lung during the middle portion (25-75%) of expiration (also sometimes referred to as the MMEF, for maximal mid-expiratory flow).(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0073">
                <ns2:items id="text">*Forced expiratory flow 25-50% (FEF25-50%)(en)</ns2:items>
                <ns2:items id="description">*The average flow of air from the lung during the middle portion (25-50%) of expiration (also sometimes referred to as the MMEF, for maximal mid-expiratory flow).(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0074">
                <ns2:items id="text">*Forced inspratory flow 25-75% (FIF25-75%)(en)</ns2:items>
                <ns2:items id="description">*The average flow of air into the lung during the middle portion (25-75%) of inspiration.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0075">
                <ns2:items id="text">*Forced inspratory flow 25-50% (FIF25-50%)(en)</ns2:items>
                <ns2:items id="description">*The average flow of air into the lung during the middle portion (25-50%) of inspiration.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0076">
                <ns2:items id="text">*Inspiratory capacity (IC/IVC)(en)</ns2:items>
                <ns2:items id="description">*The maximal volume that can be inspired following a normal expiration. Also termed Inspiratory vital capacity (IVC). Calculated = TV+IRV(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0077">
                <ns2:items id="text">*Expiratory reserve volume (ERV)(en)</ns2:items>
                <ns2:items id="description">*The amount of additional air that can be pushed out after the end expiratory level of normal breathing.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0078">
                <ns2:items id="text">*Inspiratory reserve volume (IRV)(en)</ns2:items>
                <ns2:items id="description">*The additional air that can be inhaled after a normal tidal breath in. (en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0079">
                <ns2:items id="text">*Maximum voluntary ventilation(en)</ns2:items>
                <ns2:items id="description">*A measure of the maximum amount of air that can be inhaled and exhaled in one minute. Also termed Maximum ventilation per minute(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0080">
                <ns2:items id="text">*Tiffenau index (FEV1/SVC)(en)</ns2:items>
                <ns2:items id="description">*The ratio of Forced Expiratory volume in 1 second to Inspired vital capacity. Calculated = FEV1/ IVC.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0081">
                <ns2:items id="text">*FEV1/FVC ratio (FEV1%FVC)(en)</ns2:items>
                <ns2:items id="description">*The ration of Forced expiratory volume in 1 second to Forced vital capacity.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0082">
                <ns2:items id="text">*Tidal volume (Vt)(en)</ns2:items>
                <ns2:items id="description">*The volume of air inspired and then expired from the lung during one respiratory cycle.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0083">
                <ns2:items id="text">*Residual volume (RV)(en)</ns2:items>
                <ns2:items id="description">*The amount of air left in the lungs after a maximal exhalation.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0084">
                <ns2:items id="text">*Functional residual capacity (FRC)(en)</ns2:items>
                <ns2:items id="description">*The amount of air left in the lungs after a tidal breath out. Calculated = ERV+RV.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0087">
                <ns2:items id="text">*Test name(en)</ns2:items>
                <ns2:items id="description">*The name of the pulmonary volume test/parameter.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0088">
                <ns2:items id="text">Ime testa</ns2:items>
                <ns2:items id="description">Ime testa</ns2:items>
            </ns2:items>
            <ns2:items code="at0089">
                <ns2:items id="text">*Test name(en)</ns2:items>
                <ns2:items id="description">*The nameof the pulmonary ratio test.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0091">
                <ns2:items id="text">*Timing(en)</ns2:items>
                <ns2:items id="description">*The timin of the event in (en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0093">
                <ns2:items id="text">*Agent detail(en)</ns2:items>
                <ns2:items id="description">*Details of the agent used in the test.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0094">
                <ns2:items id="text">*Before bronchial challenge(en)</ns2:items>
                <ns2:items id="description">*The test was taken before  the challenge.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0095">
                <ns2:items id="text">*After bronchial challenge(en)</ns2:items>
                <ns2:items id="description">*The test was performed after the bronchial challenge.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0097">
                <ns2:items id="text">*Duration(en)</ns2:items>
                <ns2:items id="description">*The timing of the test in relation to the challenge.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0098">
                <ns2:items id="text">*Confounding factors(en)</ns2:items>
                <ns2:items id="description">*Comment on and record other incidental factors that may affect interpretation of the observation. (en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0099">
                <ns2:items id="text">*Interpretive findings(en)</ns2:items>
                <ns2:items id="description">*Textual or coded interpretations of the test results.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0101">
                <ns2:items id="text">*Comment(en)</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0102">
                <ns2:items id="text">*Patient-related failure(en)</ns2:items>
                <ns2:items id="description">*Patient related reason for failure of test.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0103">
                <ns2:items id="text">*Instrument-related failure(en)</ns2:items>
                <ns2:items id="description">*Instrument related reason for failure of test result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0104">
                <ns2:items id="text">*Calibration failed(en)</ns2:items>
                <ns2:items id="description">*Equipment failed calibration test.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0105">
                <ns2:items id="text">*Leak detected(en)</ns2:items>
                <ns2:items id="description">*Volume displacement spirometer shows a leak detected.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0106">
                <ns2:items id="text">*Rip or tear in flowhead(en)</ns2:items>
                <ns2:items id="description">*Rip or tear detected in flowhead connector tube for flow spirometers.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0107">
                <ns2:items id="text">*Hesitation(en)</ns2:items>
                <ns2:items id="description">*Patient hesistated during expiration.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0108">
                <ns2:items id="text">*Cough(en)</ns2:items>
                <ns2:items id="description">*Patient coughed.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0109">
                <ns2:items id="text">*Additional breath(en)</ns2:items>
                <ns2:items id="description">*Patient took additional breath during expiration.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0110">
                <ns2:items id="text">*Premature termination(en)</ns2:items>
                <ns2:items id="description">*Patient did not perform expiration for sufficient duration.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0111">
                <ns2:items id="text">*Obstruction of mouthpiece(en)</ns2:items>
                <ns2:items id="description">*Mouthpiece of measuring equipment obstructed by tongue or teeth.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0112">
                <ns2:items id="text">*Expiration not continuous(en)</ns2:items>
                <ns2:items id="description">*Patient stopped or started expiration during manoeuvre.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0113">
                <ns2:items id="text">*Clinician terminated measurement(en)</ns2:items>
                <ns2:items id="description">*Patient stopped expiration on instructions from clinician.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0114">
                <ns2:items id="text">*Poor posture(en)</ns2:items>
                <ns2:items id="description">*The patients posture was too poor to achieve a reliable result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0115">
                <ns2:items id="text">*Position(en)</ns2:items>
                <ns2:items id="description">*The body position of the subject at the time of measurement.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0116">
                <ns2:items id="text">*Standing(en)</ns2:items>
                <ns2:items id="description">*Standing at the time of measurement.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0117">
                <ns2:items id="text">*Sitting(en)</ns2:items>
                <ns2:items id="description">*Sitting (for example on bed or chair) at the time of measurement.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0118">
                <ns2:items id="text">*Reclining(en)</ns2:items>
                <ns2:items id="description">*Reclining at the time of measurement.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0119">
                <ns2:items id="text">*Lying(en)</ns2:items>
                <ns2:items id="description">*Lying flat at the time of measurement.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0122">
                <ns2:items id="text">Razmerje izmerjen glede na predviden</ns2:items>
                <ns2:items id="description">Razmerje izmerjenega PEFa glede na predvideni PEF</ns2:items>
            </ns2:items>
            <ns2:items code="at0123">
                <ns2:items id="text">*Too young(en)</ns2:items>
                <ns2:items id="description">*The patient is too young to perform the test.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0124">
                <ns2:items id="text">*Physically unable to perform test(en)</ns2:items>
                <ns2:items id="description">*The subject is physically unable to perform the test.(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-ACTION.procedure-unassisted_oxygen_delivery.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0.2">
                <ns2:items id="text">Spontano dihajoč</ns2:items>
                <ns2:items id="description">Intervencija pri spontano dihajočem pacientu</ns2:items>
            </ns2:items>
            <ns2:items code="at0.3">
                <ns2:items id="text">Menjava filtra</ns2:items>
                <ns2:items id="description">Datum in čas zadnje menjave filtra</ns2:items>
            </ns2:items>
            <ns2:items code="at0.4">
                <ns2:items id="text">CPAP</ns2:items>
                <ns2:items id="description">Konstanti pozitivni pristisk zraka za spontano dihanje</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1">
                <ns2:items id="text">Spontano dihajoč</ns2:items>
                <ns2:items id="description">Pacient, ki spontano diha</ns2:items>
            </ns2:items>
            <ns2:items code="at0002.1">
                <ns2:items id="text">Intervencija</ns2:items>
                <ns2:items id="description">Naziv intervencije</ns2:items>
            </ns2:items>
            <ns2:items code="at0058">
                <ns2:items id="text">*Performer(en)</ns2:items>
                <ns2:items id="description">*The person performing the procedure (where not the information provider).(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0059">
                <ns2:items id="text">*Assistant(en)</ns2:items>
                <ns2:items id="description">*A person assisting the key intervention performer.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0000">
                <ns2:items id="text">Izvedena klinična aktivnost</ns2:items>
                <ns2:items id="description">Izvedena klinična aktivnost</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">Aktivnost</ns2:items>
                <ns2:items id="description">Ime, naziv postopka, aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">Podrobnosti</ns2:items>
                <ns2:items id="description">Podroben opis izvedene aktivnosti, npr. priprave, uporabljena metoda, oprema in naprave</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Neopravljeno</ns2:items>
                <ns2:items id="description">TRUE (resnično) pomeni, da aktivnost ni bila opravljena s kliničnega vidika</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">Opombe</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">Zapleti</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0013">
                <ns2:items id="text">Multimedija</ns2:items>
                <ns2:items id="description">Multimedijske predstavitve, npr. slika</ns2:items>
            </ns2:items>
            <ns2:items code="at0014">
                <ns2:items id="text">Razlog</ns2:items>
                <ns2:items id="description">Razlogi za izvedbo aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0015">
                <ns2:items id="text">Nenačrtovan dogodek</ns2:items>
                <ns2:items id="description">Nenačrtovan dogodek, npr. neželen dogodek, ki vpliva na aktivnost</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">Neuspešni poskusi</ns2:items>
                <ns2:items id="description">Število neuspešnih poskusov izvedbe</ns2:items>
            </ns2:items>
            <ns2:items code="at0030">
                <ns2:items id="text">Dodatne naloge</ns2:items>
                <ns2:items id="description">Podatki o nenačrtovanih aktivnostih, katere je bilo potrebno izvesti med aktivnostjo. Ta arhetip zajema naziv in opis naloge, drugi podatki o nalogi pa naj se zapišejo v povezanih (link) arhetipih tipa INSTRUCTION ali ACTION</ns2:items>
            </ns2:items>
            <ns2:items code="at0031">
                <ns2:items id="text">Opis naloge</ns2:items>
                <ns2:items id="description">Opis dodatnih nalog med izvajanjem aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0032">
                <ns2:items id="text">Zapis dodanih nalog</ns2:items>
                <ns2:items id="description">Povazava na zapis o dodatni nalogi</ns2:items>
            </ns2:items>
            <ns2:items code="at0034">
                <ns2:items id="text">Zahteva, sprožena</ns2:items>
                <ns2:items id="description">Initiated - začeta</ns2:items>
            </ns2:items>
            <ns2:items code="at0035">
                <ns2:items id="text">Zahteva, poslana</ns2:items>
                <ns2:items id="description">Sent - poslana v task sezname izvajalcev</ns2:items>
            </ns2:items>
            <ns2:items code="at0036">
                <ns2:items id="text">Aktivnost, načrtovana</ns2:items>
                <ns2:items id="description">Scheduled - načrtovana v urniku</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">Zahteva, preložena</ns2:items>
                <ns2:items id="description">Postoponed - preložena na kasnejši čas</ns2:items>
            </ns2:items>
            <ns2:items code="at0039">
                <ns2:items id="text">Zahteva, preklicana</ns2:items>
                <ns2:items id="description">Cancelled - preklicana zahteva</ns2:items>
            </ns2:items>
            <ns2:items code="at0040">
                <ns2:items id="text">Zahteva, na čakanju</ns2:items>
                <ns2:items id="description">Suspend - zahteva trenutno miruje, lahko jo nadaljujemo v prihodnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0041">
                <ns2:items id="text">Zahteva, takojšnja zaustavitev</ns2:items>
                <ns2:items id="description">Aborted - nepreklicno ustavljena zahteva</ns2:items>
            </ns2:items>
            <ns2:items code="at0043">
                <ns2:items id="text">Zahteva, izvedena</ns2:items>
                <ns2:items id="description">Completed</ns2:items>
            </ns2:items>
            <ns2:items code="at0044">
                <ns2:items id="text">Poročilo pripravljeno</ns2:items>
                <ns2:items id="description">Written - kreirano</ns2:items>
            </ns2:items>
            <ns2:items code="at0045">
                <ns2:items id="text">Poročilo potrjeno</ns2:items>
                <ns2:items id="description">Attested - primerno za distribucijo</ns2:items>
            </ns2:items>
            <ns2:items code="at0046">
                <ns2:items id="text">Poročilo poslano</ns2:items>
                <ns2:items id="description">Sent - distribuirano prejemnikom</ns2:items>
            </ns2:items>
            <ns2:items code="at0047">
                <ns2:items id="text">Se izvaja</ns2:items>
                <ns2:items id="description">Aktinost je v teku</ns2:items>
            </ns2:items>
            <ns2:items code="at0048">
                <ns2:items id="text">Rezultat</ns2:items>
                <ns2:items id="description">Rezultat, sprotno vrednotenje izvedene aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0049">
                <ns2:items id="text">Opis</ns2:items>
                <ns2:items id="description">Narrative description about the procedure carried out.</ns2:items>
            </ns2:items>
            <ns2:items code="at0050">
                <ns2:items id="text">Anatomska lokacija</ns2:items>
                <ns2:items id="description">Podrobnosti o anatomski lokaciji, vezani na aktivnost</ns2:items>
            </ns2:items>
            <ns2:items code="at0051">
                <ns2:items id="text">Metoda, tehnika</ns2:items>
                <ns2:items id="description">ID uporabljene metode oz. tehnike</ns2:items>
            </ns2:items>
            <ns2:items code="at0052">
                <ns2:items id="text">Naloga</ns2:items>
                <ns2:items id="description">Naziv dodatne naloge, ki se je izvedla med aktivnostjo</ns2:items>
            </ns2:items>
            <ns2:items code="at0053">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0054">
                <ns2:items id="text">ID naročila - naročnik</ns2:items>
                <ns2:items id="description">Interni ID naročila, kot ga določi naročnik, npr. številka napotnice</ns2:items>
            </ns2:items>
            <ns2:items code="at0055">
                <ns2:items id="text">Naročnik</ns2:items>
                <ns2:items id="description">Kdo je naročil aktivnost, posameznik ali organizacija</ns2:items>
            </ns2:items>
            <ns2:items code="at0056">
                <ns2:items id="text">ID naročila - prejemnik</ns2:items>
                <ns2:items id="description">Interni ID naročila, kot ga določi prejemnik, npr. zap.št.pošte</ns2:items>
            </ns2:items>
            <ns2:items code="at0057">
                <ns2:items id="text">Prejemnik</ns2:items>
                <ns2:items id="description">Prejemnik naročila za izvedbo aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0060">
                <ns2:items id="text">Odstopanja</ns2:items>
                <ns2:items id="description">Opis odstopanj med načrtovano in izvedeno aktivnostjo</ns2:items>
            </ns2:items>
            <ns2:items code="at0061">
                <ns2:items id="text">Lokalizacija</ns2:items>
                <ns2:items id="description">Podrobnosti za podporo procesom in drugim lokalnim zahtavam (cluster)</ns2:items>
            </ns2:items>
            <ns2:items code="at0062">
                <ns2:items id="text">Opis naloge</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0063">
                <ns2:items id="text">Datum in ura izvedbe</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-CLUSTER.gas_delivery-oxygen.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0.100">
                <ns2:items id="text">Tubus</ns2:items>
                <ns2:items id="description">Tubus</ns2:items>
            </ns2:items>
            <ns2:items code="at0.101">
                <ns2:items id="text">Z enojno žico</ns2:items>
                <ns2:items id="description">Z enojno žico</ns2:items>
            </ns2:items>
            <ns2:items code="at0.102">
                <ns2:items id="text">Z dvojno žico</ns2:items>
                <ns2:items id="description">Z dvojno žico</ns2:items>
            </ns2:items>
            <ns2:items code="at0.104">
                <ns2:items id="text">Nosna NIV maska</ns2:items>
                <ns2:items id="description">Nosna NIV maska</ns2:items>
            </ns2:items>
            <ns2:items code="at0.105">
                <ns2:items id="text">Nosna kanila ZVP</ns2:items>
                <ns2:items id="description">Nosna kanila ZVP</ns2:items>
            </ns2:items>
            <ns2:items code="at0.106">
                <ns2:items id="text">Traheostomski nastavek ZVP</ns2:items>
                <ns2:items id="description">Traheostomski nastavek ZVP</ns2:items>
            </ns2:items>
            <ns2:items code="at0.107">
                <ns2:items id="text">Kisikova terapija</ns2:items>
                <ns2:items id="description">Tip kisikove terapije</ns2:items>
            </ns2:items>
            <ns2:items code="at0.108">
                <ns2:items id="text">Kisikova terapija</ns2:items>
                <ns2:items id="description">Kisikova terapija</ns2:items>
            </ns2:items>
            <ns2:items code="at0.109">
                <ns2:items id="text">Kisikova terapija ZVP</ns2:items>
                <ns2:items id="description">Kisikova terpija</ns2:items>
            </ns2:items>
            <ns2:items code="at0.110">
                <ns2:items id="text">do 30  l/min</ns2:items>
                <ns2:items id="description">do 30  l/min</ns2:items>
            </ns2:items>
            <ns2:items code="at0.96">
                <ns2:items id="text">Kisik</ns2:items>
                <ns2:items id="description">Naziv dovajanega plina</ns2:items>
            </ns2:items>
            <ns2:items code="at0.97">
                <ns2:items id="text">Trahealna kanila</ns2:items>
                <ns2:items id="description">Podatki o trahealni kanili</ns2:items>
            </ns2:items>
            <ns2:items code="at0.98">
                <ns2:items id="text">do 15 l/min</ns2:items>
                <ns2:items id="description">Low pressure  &lt; 15 l/min</ns2:items>
            </ns2:items>
            <ns2:items code="at0.99">
                <ns2:items id="text">Trahealna kanila</ns2:items>
                <ns2:items id="description">Tracheal Cannula</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1">
                <ns2:items id="text">Dovajanje kisika</ns2:items>
                <ns2:items id="description">Podatki o dovajanju kisika pacientu</ns2:items>
            </ns2:items>
