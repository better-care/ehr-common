            </ns2:items>
            <ns2:items code="at0.91">
                <ns2:items id="text">Vnos kalorij</ns2:items>
                <ns2:items id="description">Vnos kalorij</ns2:items>
            </ns2:items>
            <ns2:items code="at0.92">
                <ns2:items id="text">Tešč</ns2:items>
                <ns2:items id="description">Tešč</ns2:items>
            </ns2:items>
            <ns2:items code="at0.93">
                <ns2:items id="text">Po obroku</ns2:items>
                <ns2:items id="description">Po obroku</ns2:items>
            </ns2:items>
            <ns2:items code="at0.94">
                <ns2:items id="text">Pred obrokom</ns2:items>
                <ns2:items id="description">Pred obrokom</ns2:items>
            </ns2:items>
            <ns2:items code="at0.95">
                <ns2:items id="text">Poljubno</ns2:items>
                <ns2:items id="description">Poljubno</ns2:items>
            </ns2:items>
            <ns2:items code="at0.96">
                <ns2:items id="text">Čas trajanja</ns2:items>
                <ns2:items id="description">Čas trajanja</ns2:items>
            </ns2:items>
            <ns2:items code="at0.97">
                <ns2:items id="text">Opis</ns2:items>
                <ns2:items id="description">Opis vnosa</ns2:items>
            </ns2:items>
            <ns2:items code="at0.98">
                <ns2:items id="text">Provokacija z glukozo</ns2:items>
                <ns2:items id="description">Podatki o provokaciji z glukozo</ns2:items>
            </ns2:items>
            <ns2:items code="at0.99">
                <ns2:items id="text">Čas trajanja</ns2:items>
                <ns2:items id="description">Čas trajanja provokacije</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1">
                <ns2:items id="text">Krvni sladkor</ns2:items>
                <ns2:items id="description">Koncentarcija glukoze v krvi</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">*Test result name(en)</ns2:items>
                <ns2:items id="description">*Identification of the pathology test performed, sometimes including specimen type. Coding with a terminology, potientially a pre-coordinated term including specimen type, is preferred, where possible. May be coded with LOINC or Snomed-CT. A test result may be for a single analyte, or a group of items, including panel tests.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0010">
                <ns2:items id="text">*Test result representation(en)</ns2:items>
                <ns2:items id="description">*Rich text or other mutlimedia representation of the entire result as issued by the diagnostic service. Multiple formats are allowed but they must be semantically equivalent.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0017">
                <ns2:items id="text">*Receiving laboratory(en)</ns2:items>
                <ns2:items id="description">*Demographic details of the laboratory with responsibility for the test. Details of secondary laboratories may also be included.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0037">
                <ns2:items id="text">*Interim(en)</ns2:items>
                <ns2:items id="description">*This is an initial or interim result - further updates are anticipated.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">*Final(en)</ns2:items>
                <ns2:items id="description">*This is the final result. No further alterations are anticipated.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0039">
                <ns2:items id="text">*Supplementary(en)</ns2:items>
                <ns2:items id="description">*This is a supplementary result ehich should be appended to a previous result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0040">
                <ns2:items id="text">*Corrected / Amended(en)</ns2:items>
                <ns2:items id="description">*This is a correction which should completely replace any previous results.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0057">
                <ns2:items id="text">*Conclusion(en)</ns2:items>
                <ns2:items id="description">*Concise and clinically contextualised narrative interpretation of the pathology test results.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0062">
                <ns2:items id="text">*Requester order identifier(en)</ns2:items>
                <ns2:items id="description">*The local ID assigned to the order by the order requester. Equivalent to the Placer Order Identifier.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0063">
                <ns2:items id="text">*Receiver order Identifier(en)</ns2:items>
                <ns2:items id="description">*The local ID assigned to the test order by the order filler, usually by the (LIS) Laboratory Information System. Equivalent to the DICOM Accession Number and the Filler Order Identifier.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0065">
                <ns2:items id="text">*Specimen detail(en)</ns2:items>
                <ns2:items id="description">*Details about the specimen if all individual test results are derived from the same specimen. If the specimen is sufficiently specified with a code in the Test result name, then this additional data is not required. If there are multiple specimens, these may be represented per 'Result group'.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0068">
                <ns2:items id="text">*Laboratory test result identifier(en)</ns2:items>
                <ns2:items id="description">*The identifier given to the laboratory test result of a pathology investigation.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0073">
                <ns2:items id="text">*Overall test result status(en)</ns2:items>
                <ns2:items id="description">*The status of the pathology test result as a whole.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0074">
                <ns2:items id="text">*Cancelled / Aborted(en)</ns2:items>
                <ns2:items id="description">*The test was aborted and never completed.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0075">
                <ns2:items id="description">Datum in čas dobljenih rezultatov </ns2:items>
                <ns2:items id="text">Datum in čas dobljenih rezultatov</ns2:items>
                <ns2:items id="comment">*The date and time related to the results status is useful for version control and cumulative results for the report.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0077">
                <ns2:items id="text">*Diagnostic service(en)</ns2:items>
                <ns2:items id="description">*The diagnostic service that performs the examination e.g. biochemistry, haematology. Coding with a terminology is desirable, where possible.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0078">
                <ns2:items id="text">*Result value(en)</ns2:items>
                <ns2:items id="description">*Actual value of the result. Most result values will be numerical measurements, but others may be coded concepts, free text, or multimedia images.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0078.2">
                <ns2:items id="text">Krvni sladkor</ns2:items>
                <ns2:items id="description">Koncentracija glukoze v vzorcu krvi</ns2:items>
            </ns2:items>
            <ns2:items code="at0079">
                <ns2:items id="text">*Never performed(en)</ns2:items>
                <ns2:items id="description">*The test was never performed.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0089">
                <ns2:items id="text">Opombe (v času izvedbe testa)</ns2:items>
                <ns2:items id="description">Opombe (v času izvedbe testa)</ns2:items>
            </ns2:items>
            <ns2:items code="at0090">
                <ns2:items id="text">*Requester(en)</ns2:items>
                <ns2:items id="description">*Details of the clinician or organisation requesting the laboratory test.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0000">
                <ns2:items id="text">*Laboratory test result(en)</ns2:items>
                <ns2:items id="description">*Record the findings and interpretation of pathology tests performed on tissues and body fluids.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Event Series(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">*Any event(en)</ns2:items>
                <ns2:items id="description">*Any event.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0094">
                <ns2:items id="text">*Test request details(en)</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0095">
                <ns2:items id="text">*Result group(en)</ns2:items>
                <ns2:items id="description">*A group of results. Results may be grouped by specimen, or by some other name or code to describe what binds all the results together. If a name or code is used, it is provided by run-time re-naming of the 'Result group' element or may be fixed in a specialised archetype or template. Coding with a terminology, potentially a pre-coordinated term including specimen type, is preferred where possible for the name. Should be coded with LOINC or SNOMED CT, if possible.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0096">
                <ns2:items id="text">*Result(en)</ns2:items>
                <ns2:items id="description">*Specific detailed result, including both the value of the result item, and additional information that may be useful for clinical interpretation. Results include whatever specific data items pathology labs report as part of the clinical service; it is not confined to measurements. The result is identified by run-time re-naming of the 'Result group' element or may be fixed in a specialised archetype or template. Coding with a terminology, potentially a pre-coordinated term including specimen type, is preferred where possible for the name. Should be coded with LOINC or SNOMED CT. Examples include: glucose, haemoglobin, phenotype, titre, or scatterplot image.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0097">
                <ns2:items id="text">*Specimen detail(en)</ns2:items>
                <ns2:items id="description">*Details about the individual specimen to which these ‘Result group’ test results refer, where testing of multiple specimens is required.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0098">
                <ns2:items id="text">*Pathological diagnosis(en)</ns2:items>
                <ns2:items id="description">*Single word, phrase or brief description representing the 'Conclusion'. Coding with a terminology is preferred, where possible.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0099">
                <ns2:items id="text">*DateTime result issued(en)</ns2:items>
                <ns2:items id="description">*The date and/or time that the result was issued for the recorded ‘Overall test result status’.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0100">
                <ns2:items id="text">*Clinical information provided(en)</ns2:items>
                <ns2:items id="description">*Description of clinical information available at the time of interpretation of results, or a link to the original clinical information provided in the test request.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0101">
                <ns2:items id="text">*Test comment(en)</ns2:items>
                <ns2:items id="description">*Additional narrative about the test not captured in other fields.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0102">
                <ns2:items id="text">*Result comment(en)</ns2:items>
                <ns2:items id="description">*May include statements about significant, unexpected or unreliable. values, or information about the source of the value where this may be relevant to the interpretation of the result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0103">
                <ns2:items id="text">*Reference range guidance(en)</ns2:items>
                <ns2:items id="description">*Additional advice on the applicability of the reference range.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0104">
                <ns2:items id="text">*Date of analysis(en)</ns2:items>
                <ns2:items id="description">*The date that the analysis was performed.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0105">
                <ns2:items id="text">*Analysis method(en)</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0106">
                <ns2:items id="text">*Test requested name(en)</ns2:items>
                <ns2:items id="description">*Identification of pathology test requested, where the test requested differs from the test actually performed.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0107">
                <ns2:items id="text">*Registered(en)</ns2:items>
                <ns2:items id="description">*The tst has been registered by the laboratory but a result is not yet available.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0108">
                <ns2:items id="text">*Result status(en)</ns2:items>
                <ns2:items id="description">*The status of the result value.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0110">
                <ns2:items id="text">*Test procedure(en)</ns2:items>
                <ns2:items id="description">*Additional structured details of pathology test methodology followed. For example, structured details about the laboratory method and data interpretation used.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0111">
                <ns2:items id="text">*Date Time result issued(en)</ns2:items>
                <ns2:items id="description">*The date and/or time that the result was issued for the recorded ‘Result status’.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0112">
                <ns2:items id="text">*Entered in error(en)</ns2:items>
                <ns2:items id="description">*The Test Result has been withdrawn following previous Final release(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0113">
                <ns2:items id="text">*Entered in error(en)</ns2:items>
                <ns2:items id="description">*The Test Result has been withdrawn following previous Final release(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0114">
                <ns2:items id="text">*Result representation(en)</ns2:items>
                <ns2:items id="description">*Result representation(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.lab_test-hba1c.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">*Laboratory test result(en)</ns2:items>
                <ns2:items id="description">*Record the findings and interpretation of pathology tests performed on tissues and body fluids.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1">
                <ns2:items id="text">Hemoglobin A1c</ns2:items>
                <ns2:items id="description">Razmerje hemoglobina v krvi, ki je "glycolysed"</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">*Any event(en)</ns2:items>
                <ns2:items id="description">*Any event.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">*Test result name(en)</ns2:items>
                <ns2:items id="description">*Identification of the pathology test performed, sometimes including specimen type. Coding with a terminology, potientially a pre-coordinated term including specimen type, is preferred, where possible. May be coded with LOINC or Snomed-CT. A test result may be for a single analyte, or a group of items, including panel tests.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0010">
                <ns2:items id="text">*Test result representation(en)</ns2:items>
                <ns2:items id="description">*Rich text or other mutlimedia representation of the entire result as issued by the diagnostic service. Multiple formats are allowed but they must be semantically equivalent.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0017">
                <ns2:items id="text">*Receiving laboratory(en)</ns2:items>
                <ns2:items id="description">*Demographic details of the laboratory with responsibility for the test. Details of secondary laboratories may also be included.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0037">
                <ns2:items id="text">*Interim(en)</ns2:items>
                <ns2:items id="description">*This is an initial or interim result - further updates are anticipated.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">*Final(en)</ns2:items>
                <ns2:items id="description">*This is the final result. No further alterations are anticipated.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0039">
                <ns2:items id="text">*Supplementary(en)</ns2:items>
                <ns2:items id="description">*This is a supplementary result ehich should be appended to a previous result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0040">
                <ns2:items id="text">*Corrected / Amended(en)</ns2:items>
                <ns2:items id="description">*This is a correction which should completely replace any previous results.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0057">
                <ns2:items id="text">*Conclusion(en)</ns2:items>
                <ns2:items id="description">*Concise and clinically contextualised narrative interpretation of the pathology test results.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0062">
                <ns2:items id="text">*Requester order identifier(en)</ns2:items>
                <ns2:items id="description">*The local ID assigned to the order by the order requester. Equivalent to the Placer Order Identifier.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0063">
                <ns2:items id="text">*Receiver order Identifier(en)</ns2:items>
                <ns2:items id="description">*The local ID assigned to the test order by the order filler, usually by the (LIS) Laboratory Information System. Equivalent to the DICOM Accession Number and the Filler Order Identifier.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0065">
                <ns2:items id="text">*Specimen detail(en)</ns2:items>
                <ns2:items id="description">*Details about the specimen if all individual test results are derived from the same specimen. If the specimen is sufficiently specified with a code in the Test result name, then this additional data is not required. If there are multiple specimens, these may be represented per 'Result group'.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0068">
                <ns2:items id="text">*Laboratory test result identifier(en)</ns2:items>
                <ns2:items id="description">*The identifier given to the laboratory test result of a pathology investigation.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0073">
                <ns2:items id="text">*Overall test result status(en)</ns2:items>
                <ns2:items id="description">*The status of the pathology test result as a whole.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0074">
                <ns2:items id="text">*Cancelled / Aborted(en)</ns2:items>
                <ns2:items id="description">*The test was aborted and never completed.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0075">
                <ns2:items id="comment">*The date and time related to the results status is&#13;
useful for version control and cumulative results for the report.(en)</ns2:items>
                <ns2:items id="text">Datum in čas dobljenih rezultatov</ns2:items>
                <ns2:items id="description">Datum in čas dobljenih rezultatov </ns2:items>
            </ns2:items>
            <ns2:items code="at0077">
                <ns2:items id="text">*Diagnostic service(en)</ns2:items>
                <ns2:items id="description">*The diagnostic service that performs the examination e.g. biochemistry, haematology. Coding with a terminology is desirable, where possible.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0078">
                <ns2:items id="text">*Result value(en)</ns2:items>
                <ns2:items id="description">*Actual value of the result. Most result values will be numerical measurements, but others may be coded concepts, free text, or multimedia images.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0078.1">
                <ns2:items id="text">HbA1c</ns2:items>
                <ns2:items id="description">HbA1c</ns2:items>
            </ns2:items>
            <ns2:items code="at0079">
                <ns2:items id="text">*Never performed(en)</ns2:items>
                <ns2:items id="description">*The test was never performed.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0089">
                <ns2:items id="text">Opombe (v času izvedbe testa)</ns2:items>
                <ns2:items id="description">Opombe (v času izvedbe testa)</ns2:items>
            </ns2:items>
            <ns2:items code="at0090">
                <ns2:items id="text">*Requester(en)</ns2:items>
                <ns2:items id="description">*Details of the clinician or organisation requesting the laboratory test.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Event Series(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0094">
                <ns2:items id="text">*Test request details(en)</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0095">
                <ns2:items id="text">*Result group(en)</ns2:items>
                <ns2:items id="description">*A group of results. Results may be grouped by specimen, or by some other name or code to describe what binds all the results together. If a name or code is used, it is provided by run-time re-naming of the 'Result group' element or may be fixed in a specialised archetype or template. Coding with a terminology, potentially a pre-coordinated term including specimen type, is preferred where possible for the name. Should be coded with LOINC or SNOMED CT, if possible.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0096">
                <ns2:items id="text">*Result(en)</ns2:items>
                <ns2:items id="description">*Specific detailed result, including both the value of the result item, and additional information that may be useful for clinical interpretation. Results include whatever specific data items pathology labs report as part of the clinical service; it is not confined to measurements. The result is identified by run-time re-naming of the 'Result group' element or may be fixed in a specialised archetype or template. Coding with a terminology, potentially a pre-coordinated term including specimen type, is preferred where possible for the name. Should be coded with LOINC or SNOMED CT. Examples include: glucose, haemoglobin, phenotype, titre, or scatterplot image.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0097">
                <ns2:items id="text">*Specimen detail(en)</ns2:items>
                <ns2:items id="description">*Details about the individual specimen to which these ‘Result group’ test results refer, where testing of multiple specimens is required.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0098">
                <ns2:items id="text">*Pathological diagnosis(en)</ns2:items>
                <ns2:items id="description">*Single word, phrase or brief description representing the 'Conclusion'. Coding with a terminology is preferred, where possible.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0099">
                <ns2:items id="text">*DateTime result issued(en)</ns2:items>
                <ns2:items id="description">*The date and/or time that the result was issued for the recorded ‘Overall test result status’.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0100">
                <ns2:items id="text">*Clinical information provided(en)</ns2:items>
                <ns2:items id="description">*Description of clinical information available at the time of interpretation of results, or a link to the original clinical information provided in the test request.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0101">
                <ns2:items id="text">*Test comment(en)</ns2:items>
                <ns2:items id="description">*Additional narrative about the test not captured in other fields.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0102">
                <ns2:items id="text">*Result comment(en)</ns2:items>
                <ns2:items id="description">*May include statements about significant, unexpected or unreliable. values, or information about the source of the value where this may be relevant to the interpretation of the result.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0103">
                <ns2:items id="text">*Reference range guidance(en)</ns2:items>
                <ns2:items id="description">*Additional advice on the applicability of the reference range.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0104">
                <ns2:items id="text">*Date of analysis(en)</ns2:items>
                <ns2:items id="description">*The date that the analysis was performed.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0105">
                <ns2:items id="text">*Analysis method(en)</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0106">
                <ns2:items id="text">*Test requested name(en)</ns2:items>
                <ns2:items id="description">*Identification of pathology test requested, where the test requested differs from the test actually performed.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0107">
                <ns2:items id="text">*Registered(en)</ns2:items>
                <ns2:items id="description">*The tst has been registered by the laboratory but a result is not yet available.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0108">
                <ns2:items id="text">*Result status(en)</ns2:items>
                <ns2:items id="description">*The status of the result value.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0110">
                <ns2:items id="text">*Test procedure(en)</ns2:items>
                <ns2:items id="description">*Additional structured details of pathology test methodology followed. For example, structured details about the laboratory method and data interpretation used.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0111">
                <ns2:items id="text">*Date Time result issued(en)</ns2:items>
                <ns2:items id="description">*The date and/or time that the result was issued for the recorded ‘Result status’.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0112">
                <ns2:items id="text">*Entered in error(en)</ns2:items>
                <ns2:items id="description">*The Test Result has been withdrawn following previous Final release(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0113">
                <ns2:items id="text">*Entered in error(en)</ns2:items>
                <ns2:items id="description">*The Test Result has been withdrawn following previous Final release(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0114">
                <ns2:items id="text">*Result representation(en)</ns2:items>
                <ns2:items id="description">*Result representation(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
