                                                </ns2:archetype_id>
                                                <ns2:term_definitions code="at0000">
                                                    <ns2:items id="text">Device</ns2:items>
                                                    <ns2:items id="description">Any physical object, product, instrument, apparatus, appliance, material or other item used directly or indirectly in the provision of healthcare, but is not used primarily through therapeutic or metabolic means.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0001">
                                                    <ns2:items id="text">Device name</ns2:items>
                                                    <ns2:items id="description">Identification of the device.  This is very likely to be a coded field, including pre- or post-coordianted details.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0002">
                                                    <ns2:items id="text">Description</ns2:items>
                                                    <ns2:items id="description">Description of the device.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0003">
                                                    <ns2:items id="text">Type</ns2:items>
                                                    <ns2:items id="description">Type of device.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0004">
                                                    <ns2:items id="text">Manufacturer</ns2:items>
                                                    <ns2:items id="description">The name of the device manufacturer.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0005">
                                                    <ns2:items id="text">Date of manufacture</ns2:items>
                                                    <ns2:items id="description">Date the device was manufactured.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0006">
                                                    <ns2:items id="text">Batch number</ns2:items>
                                                    <ns2:items id="description">Manufacturer's batch number.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0007">
                                                    <ns2:items id="text">Date of expiry</ns2:items>
                                                    <ns2:items id="description">Date that the device/product is no longer fit for use.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0008">
                                                    <ns2:items id="text">Comment</ns2:items>
                                                    <ns2:items id="description">Comment about the device.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0009">
                                                    <ns2:items id="text">Additional Details</ns2:items>
                                                    <ns2:items id="description">Additional details to be noted about the device.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0013">
                                                    <ns2:items id="text">Safety feature</ns2:items>
                                                    <ns2:items id="description">Details about safety feature(s) of the device.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0014">
                                                    <ns2:items id="text">Type of feature</ns2:items>
                                                    <ns2:items id="description">Type of safety feature of the device.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0015">
                                                    <ns2:items id="text">Description</ns2:items>
                                                    <ns2:items id="description">Description of the safety feature of the device.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0016">
                                                    <ns2:items id="text">Size</ns2:items>
                                                    <ns2:items id="description">Size of device - a choice of value types is offered - count, quantity or text.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0017">
                                                    <ns2:items id="text">Dimensions</ns2:items>
                                                    <ns2:items id="description">Specific dimensions of the device.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0020">
                                                    <ns2:items id="text">Components</ns2:items>
                                                    <ns2:items id="description">Information about the device sub-components.</ns2:items>
                                                </ns2:term_definitions>
                                            </ns2:children>
