            </ns2:items>
            <ns2:items code="at0.99">
                <ns2:items id="text">Rumeno</ns2:items>
                <ns2:items id="description">Rumeno</ns2:items>
            </ns2:items>
            <ns2:items code="at0000">
                <ns2:items id="text">Telesne tekočine</ns2:items>
                <ns2:items id="description">*An excreted, secreted or otherwise output bodily substance such as blood, sputum, vomit, urine, faeces.(en)</ns2:items>
