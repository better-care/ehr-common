                                        <ns2:term_definitions code="at0000">
                                            <ns2:items id="text">Distribution</ns2:items>
                                            <ns2:items id="description">Details of the target of communication distribution, whether to identified individual parties or as a category.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0003">
                                            <ns2:items id="text">Communication mode</ns2:items>
                                            <ns2:items id="description">The communications mode by which the distribution is to be made.</ns2:items>
                                            <ns2:items id="comment">e.g. fax, email.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0006">
                                            <ns2:items id="text">Date sent</ns2:items>
                                            <ns2:items id="description">Date that the distribution was sent.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0007">
                                            <ns2:items id="text">Recipient details</ns2:items>
                                            <ns2:items id="description">An individual person or organisation to whom the distribution applies.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0008">
                                            <ns2:items id="text">Group category</ns2:items>
                                            <ns2:items id="description">A named category of group e.g. Social work, patient representatives to whom the distribution applies.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0010">
                                            <ns2:items id="text">Recipient identifier</ns2:items>
                                            <ns2:items id="description">Unique identifier for an individual recipient.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0011">
                                            <ns2:items id="text">Individual recipient</ns2:items>
                                            <ns2:items id="description">Distribution details for an individual recipient.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0012">
                                            <ns2:items id="text">Urgent</ns2:items>
                                            <ns2:items id="description">If true the notification should be distributed made as a matter of urgency.</ns2:items>
                                        </ns2:term_definitions>
