                        <ns2:archetype_id>
                            <ns2:value>openEHR-EHR-OBSERVATION.cough_zn.v1</ns2:value>
                        </ns2:archetype_id>
                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Cough</ns2:items>
                            <ns2:items id="description">Documenting cough assessment as needed for nursing care</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Event Series</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">*</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0004">
                            <ns2:items id="text">Character</ns2:items>
                            <ns2:items id="description">The character of the cough.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0005">
                            <ns2:items id="text">Duration</ns2:items>
                            <ns2:items id="description">The duration of the cough.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0006">
                            <ns2:items id="text">Associated nosebleeds</ns2:items>
                            <ns2:items id="description">Evidence of nose-bleeds associated with cough.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0007">
                            <ns2:items id="text">Present</ns2:items>
                            <ns2:items id="description">Nose- bleeds are present.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0008">
                            <ns2:items id="text">Absent</ns2:items>
                            <ns2:items id="description">Cough- associated nose bleeds are absent.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0009">
                            <ns2:items id="text">Frequency</ns2:items>
                            <ns2:items id="description">Frequency of cough.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0010">
                            <ns2:items id="text">Sputum</ns2:items>
                            <ns2:items id="description">Details of sputum.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0011">
                            <ns2:items id="text">Productive</ns2:items>
                            <ns2:items id="description">The cough is productive.&#13;</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0012">
                            <ns2:items id="text">Foaming</ns2:items>
                            <ns2:items id="description">Foaming at mouth.&#13;</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0013">
                            <ns2:items id="text">Barking</ns2:items>
                            <ns2:items id="description">The cough has a barking quality.&#13;</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0014">
                            <ns2:items id="text">Paroxysmal</ns2:items>
                            <ns2:items id="description">The cough is paroxysmal.&#13;</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0015">
                            <ns2:items id="text">Dry , tickly</ns2:items>
                            <ns2:items id="description">The cough is dry and tickly.&#13;</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0016">
                            <ns2:items id="text">Bovine</ns2:items>
                            <ns2:items id="description">The cough has a bovine quality&#13;</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0017">
                            <ns2:items id="text">Iritable</ns2:items>
                            <ns2:items id="description">*</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0018">
                            <ns2:items id="text">Ticklish</ns2:items>
                            <ns2:items id="description">Ticklish</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0019">
                            <ns2:items id="text">Associated vomiting</ns2:items>
                            <ns2:items id="description">Evidence of vomiting  associated with cough.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0020">
                            <ns2:items id="text">Present</ns2:items>
                            <ns2:items id="description">Vomiting is present</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0021">
                            <ns2:items id="text">Absent</ns2:items>
                            <ns2:items id="description">Vomiting is absent.</ns2:items>
                        </ns2:term_definitions>
