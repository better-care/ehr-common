                        <ns2:term_definitions code="at0.125">
                            <ns2:items id="text">Test status</ns2:items>
                            <ns2:items id="description">Status of the test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.126">
                            <ns2:items id="text">Measured</ns2:items>
                            <ns2:items id="description">The test has been pefromed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.127">
                            <ns2:items id="text">Not measured</ns2:items>
                            <ns2:items id="description">The test has not been performed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.128">
                            <ns2:items id="text">Physically unfit</ns2:items>
                            <ns2:items id="description">The subject is physically unfit to perform the test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.129">
                            <ns2:items id="text">Too young</ns2:items>
                            <ns2:items id="description">The subject is too young to perform the test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000.1">
                            <ns2:items id="text">PEF before</ns2:items>
                            <ns2:items id="description">Pulmonary function testing including spirometry and other lung volume testing, according to ZN documentation</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Pulmonary function tests</ns2:items>
                            <ns2:items id="description">Pulmonary function testing including spirometry and other lung volume testing.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Event Series</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">Any event</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0008">
                            <ns2:items id="text">Predicted</ns2:items>
                            <ns2:items id="description">Predicted pulmonary flow rate result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0013">
                            <ns2:items id="text">Forced expiratory time (FET)</ns2:items>
                            <ns2:items id="description">The time taken to complete  a forced expiration.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0018">
                            <ns2:items id="text">Predicted</ns2:items>
                            <ns2:items id="description">Predicted pulmonary test ratio result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0027">
                            <ns2:items id="text">Anatomical dead space</ns2:items>
                            <ns2:items id="description">The volume of the conducting airways.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0029">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0030">
                            <ns2:items id="text">Device</ns2:items>
                            <ns2:items id="description">Details of the device used to measure pulmonary function.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0031">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0033">
                            <ns2:items id="text">Spirography</ns2:items>
                            <ns2:items id="description">Graphs produced by spirometry.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0034">
                            <ns2:items id="text">Volume-time curve</ns2:items>
                            <ns2:items id="description">Shows volume (liters) along the Y-axis and time (seconds) along the X-axis.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0035">
                            <ns2:items id="text">Flow-volume loop</ns2:items>
                            <ns2:items id="description">Graphically depicts the rate of airflow on the Y-axis and the total volume inspired or expired on the X-axis</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0037">
                            <ns2:items id="description">Also called carbon monoxide diffusing capacity test .</ns2:items>
                            <ns2:items id="text">CO transfer factor (DLCO test)</ns2:items>
                            <ns2:items id="comment">In North America the unit for D, co is mL CO/min/mm Hg.&#13;
The Systeme Internationale unit is mmol/min/kPa, and in&#13;
Europe the test is called the CO transfer factor. The following&#13;
equation converts between the 2 units:&#13;
D,   2.986 X T</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0038">
                            <ns2:items id="text">Maximal oxygen consumption (VO2max)</ns2:items>
                            <ns2:items id="description">The maximum capacity of an individual's body to transport and utilize oxygen during incremental exercise.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0044">
                            <ns2:items id="text">Actual/predicted ratio</ns2:items>
                            <ns2:items id="description">The ratio of actual to predicted test result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0046">
                            <ns2:items id="text">Bronchial challenge</ns2:items>
                            <ns2:items id="description">*</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0047">
                            <ns2:items id="text">Agent/modality</ns2:items>
                            <ns2:items id="description">The agent or physical modality used e.g exercise.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0048">
                            <ns2:items id="text">Dose</ns2:items>
                            <ns2:items id="description">The dose of agent used in the test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0049">
                            <ns2:items id="text">Bronchodilation</ns2:items>
                            <ns2:items id="description">*</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0051">
                            <ns2:items id="text">Agent</ns2:items>
                            <ns2:items id="description">The bronchodilating agent used in the test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0052">
                            <ns2:items id="text">Pulmonary volume</ns2:items>
                            <ns2:items id="description">Pulmonary function test that returns a measured volume or caclulated capacity.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0053">
                            <ns2:items id="text">Actual</ns2:items>
                            <ns2:items id="description">Actual pulmonary volume test result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0054">
                            <ns2:items id="text">Predicted</ns2:items>
                            <ns2:items id="description">Predicted pulmonary  volume test result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0055">
                            <ns2:items id="text">Pulmonary ratio</ns2:items>
                            <ns2:items id="description">A pulmonary function test result expressed as a ratio.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0056">
                            <ns2:items id="text">Actual</ns2:items>
                            <ns2:items id="description">Actual pulmonary test ratio result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0057">
                            <ns2:items id="text">Pulmonary flow rate</ns2:items>
                            <ns2:items id="description">Pulmonary function test that returns a measured flow rate.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0058">
                            <ns2:items id="text">Actual</ns2:items>
                            <ns2:items id="description">Actual pulmonary flow rate result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0064">
                            <ns2:items id="text">Slow vital capacity (SVC/EVC)</ns2:items>
                            <ns2:items id="description">The amount of air that can be forced out of the lungs after a maximal inspiration. Emphasis on completeness of expiration. Also termed expiratory vital capacity (EVC) Calculated= IRV+ Vt+ ERV</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0065">
                            <ns2:items id="text">Forced vital capacity (FVC)</ns2:items>
                            <ns2:items id="description">The volume change of the lung between a full inspiration to total lung capacity and a maximal expiration to residual volume.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0066">
                            <ns2:items id="text">Total lung capacity (TLC)</ns2:items>
                            <ns2:items id="description">The volume of gas contained in the lung after a full inhalation.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0067">
                            <ns2:items id="text">Forced expiratory volume in 1 sec (FEV1)</ns2:items>
                            <ns2:items id="description">The amount of air that can be forcibly blown out in one second.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0068">
                            <ns2:items id="text">Forced expiratory volume in 3 sec (FEV3)</ns2:items>
                            <ns2:items id="description">The amount of air that can be forcibly blown out in three seconds.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0069">
                            <ns2:items id="text">Forced expiratory volume in 6 sec (FEV6)</ns2:items>
                            <ns2:items id="description">The amount of air that can be forcibly blown out in six seconds.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0070">
                            <ns2:items id="text">Forced expiratory volume in .75 sec (FEV.75)</ns2:items>
                            <ns2:items id="description">The amount of air that can be forcibly blown out in 0.75 of a second.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0071">
                            <ns2:items id="text">Peak expiratory flow (PEF)</ns2:items>
                            <ns2:items id="description">The maximum flow generated during expiration performed with maximal force and started after a full inspiration. Also termed Peak Expiratory Flow Rate (PEFR).</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0072">
                            <ns2:items id="text">Forced expiratory flow 25-75% (FEF25-75%)</ns2:items>
                            <ns2:items id="description">The average flow of air from the lung during the middle portion (25-75%) of expiration (also sometimes referred to as the MMEF, for maximal mid-expiratory flow).</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0073">
                            <ns2:items id="text">Forced expiratory flow 25-50% (FEF25-50%)</ns2:items>
                            <ns2:items id="description">The average flow of air from the lung during the middle portion (25-50%) of expiration (also sometimes referred to as the MMEF, for maximal mid-expiratory flow).</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0074">
                            <ns2:items id="text">Forced inspratory flow 25-75% (FIF25-75%)</ns2:items>
                            <ns2:items id="description">The average flow of air into the lung during the middle portion (25-75%) of inspiration.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0075">
                            <ns2:items id="text">Forced inspratory flow 25-50% (FIF25-50%)</ns2:items>
                            <ns2:items id="description">The average flow of air into the lung during the middle portion (25-50%) of inspiration.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0076">
                            <ns2:items id="text">Inspiratory capacity (IC/IVC)</ns2:items>
                            <ns2:items id="description">The maximal volume that can be inspired following a normal expiration. Also termed Inspiratory vital capacity (IVC). Calculated = TV+IRV</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0077">
                            <ns2:items id="text">Expiratory reserve volume (ERV)</ns2:items>
                            <ns2:items id="description">The amount of additional air that can be pushed out after the end expiratory level of normal breathing.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0078">
                            <ns2:items id="text">Inspiratory reserve volume (IRV)</ns2:items>
                            <ns2:items id="description">The additional air that can be inhaled after a normal tidal breath in. </ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0079">
                            <ns2:items id="text">Maximum voluntary ventilation</ns2:items>
                            <ns2:items id="description">A measure of the maximum amount of air that can be inhaled and exhaled in one minute. Also termed Maximum ventilation per minute</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0080">
                            <ns2:items id="text">Tiffenau index (FEV1/SVC)</ns2:items>
                            <ns2:items id="description">The ratio of Forced Expiratory volume in 1 second to Inspired vital capacity. Calculated = FEV1/ IVC.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0081">
                            <ns2:items id="text">FEV1/FVC ratio (FEV1%FVC)</ns2:items>
                            <ns2:items id="description">The ration of Forced expiratory volume in 1 second to Forced vital capacity.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0082">
                            <ns2:items id="text">Tidal volume (Vt)</ns2:items>
                            <ns2:items id="description">The volume of air inspired and then expired from the lung during one respiratory cycle.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0083">
                            <ns2:items id="text">Residual volume (RV)</ns2:items>
                            <ns2:items id="description">The amount of air left in the lungs after a maximal exhalation.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0084">
                            <ns2:items id="text">Functional residual capacity (FRC)</ns2:items>
                            <ns2:items id="description">The amount of air left in the lungs after a tidal breath out. Calculated = ERV+RV.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0087">
                            <ns2:items id="text">Test name</ns2:items>
                            <ns2:items id="description">The name of the pulmonary volume test/parameter.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0088">
                            <ns2:items id="text">Test name</ns2:items>
                            <ns2:items id="description">The name of the pulmonary flow rate test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0089">
                            <ns2:items id="text">Test name</ns2:items>
                            <ns2:items id="description">The nameof the pulmonary ratio test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0091">
                            <ns2:items id="text">Timing</ns2:items>
                            <ns2:items id="description">The timin of the event in </ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0093">
                            <ns2:items id="text">Agent detail</ns2:items>
                            <ns2:items id="description">Details of the agent used in the test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0094">
                            <ns2:items id="text">Before bronchial challenge</ns2:items>
                            <ns2:items id="description">The test was taken before  the challenge.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0095">
                            <ns2:items id="text">After bronchial challenge</ns2:items>
                            <ns2:items id="description">The test was performed after the bronchial challenge.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0097">
                            <ns2:items id="text">Duration</ns2:items>
                            <ns2:items id="description">The timing of the test in relation to the challenge.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0098">
                            <ns2:items id="text">Confounding factors</ns2:items>
                            <ns2:items id="description">Comment on and record other incidental factors that may affect interpretation of the observation. </ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0099">
                            <ns2:items id="text">Interpretive findings</ns2:items>
                            <ns2:items id="description">Textual or coded interpretations of the test results.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0101">
                            <ns2:items id="text">Comment</ns2:items>
                            <ns2:items id="description">*</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0102">
                            <ns2:items id="text">Patient-related failure</ns2:items>
                            <ns2:items id="description">Patient related reason for failure of test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0103">
                            <ns2:items id="text">Instrument-related failure</ns2:items>
                            <ns2:items id="description">Instrument related reason for failure of test result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0104">
                            <ns2:items id="text">Calibration failed</ns2:items>
                            <ns2:items id="description">Equipment failed calibration test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0105">
                            <ns2:items id="text">Leak detected</ns2:items>
                            <ns2:items id="description">Volume displacement spirometer shows a leak detected.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0106">
                            <ns2:items id="text">Rip or tear in flowhead</ns2:items>
                            <ns2:items id="description">Rip or tear detected in flowhead connector tube for flow spirometers.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0107">
                            <ns2:items id="text">Hesitation</ns2:items>
                            <ns2:items id="description">Patient hesistated during expiration.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0108">
                            <ns2:items id="text">Cough</ns2:items>
                            <ns2:items id="description">Patient coughed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0109">
                            <ns2:items id="text">Additional breath</ns2:items>
                            <ns2:items id="description">Patient took additional breath during expiration.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0110">
                            <ns2:items id="text">Premature termination</ns2:items>
                            <ns2:items id="description">Patient did not perform expiration for sufficient duration.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0111">
                            <ns2:items id="text">Obstruction of mouthpiece</ns2:items>
                            <ns2:items id="description">Mouthpiece of measuring equipment obstructed by tongue or teeth.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0112">
                            <ns2:items id="text">Expiration not continuous</ns2:items>
                            <ns2:items id="description">Patient stopped or started expiration during manoeuvre.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0113">
                            <ns2:items id="text">Clinician terminated measurement</ns2:items>
                            <ns2:items id="description">Patient stopped expiration on instructions from clinician.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0114">
                            <ns2:items id="text">Poor posture</ns2:items>
                            <ns2:items id="description">The patients posture was too poor to achieve a reliable result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0115">
                            <ns2:items id="text">Position</ns2:items>
                            <ns2:items id="description">The body position of the subject at the time of measurement.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0116">
                            <ns2:items id="text">Standing</ns2:items>
                            <ns2:items id="description">Standing at the time of measurement.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0117">
                            <ns2:items id="text">Sitting</ns2:items>
                            <ns2:items id="description">Sitting (for example on bed or chair) at the time of measurement.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0118">
                            <ns2:items id="text">Reclining</ns2:items>
                            <ns2:items id="description">Reclining at the time of measurement.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0119">
                            <ns2:items id="text">Lying</ns2:items>
                            <ns2:items id="description">Lying flat at the time of measurement.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0122">
                            <ns2:items id="text">Actual/predicted ratio</ns2:items>
                            <ns2:items id="description">The ratio of actual to predicted test result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0123">
                            <ns2:items id="text">Too young</ns2:items>
                            <ns2:items id="description">The patient is too young to perform the test.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0124">
                            <ns2:items id="text">Physically unable to perform test</ns2:items>
                            <ns2:items id="description">The subject is physically unable to perform the test.</ns2:items>
                        </ns2:term_definitions>
                    </ns2:children>
