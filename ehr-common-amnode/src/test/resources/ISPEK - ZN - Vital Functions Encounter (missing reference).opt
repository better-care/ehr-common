                                                            <ns2:upper_unbounded>true</ns2:upper_unbounded>
                                                            <ns2:lower>0</ns2:lower>
                                                        </ns2:interval>
                                                    </ns2:cardinality>
                                                </ns2:attributes>
                                            </ns2:children>
                                        </ns2:attributes>
                                    </ns2:children>
