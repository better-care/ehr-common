    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.eye_exam_zn.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Opazovanje oči</ns2:items>
                <ns2:items id="description">Dokumentiranje opazovanja oči v ZN</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Event Series(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">*Any event(en)</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Prizadet vid levo oko</ns2:items>
                <ns2:items id="description">Prizadet vid na levem očesu</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">Podatki o zenicah</ns2:items>
                <ns2:items id="description">Podatki o zenicah</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">Prizadet vid</ns2:items>
                <ns2:items id="description">Prizadet vid na levem očesu</ns2:items>
            </ns2:items>
            <ns2:items code="at0007">
                <ns2:items id="text">Prizadet vid desno oko</ns2:items>
                <ns2:items id="description">Prizadet vid na desnem očesu</ns2:items>
            </ns2:items>
            <ns2:items code="at0008">
                <ns2:items id="text">Mežikanje</ns2:items>
                <ns2:items id="description">Opis mežikanja</ns2:items>
            </ns2:items>
            <ns2:items code="at0009">
                <ns2:items id="text">Zrklo glede na orbito</ns2:items>
                <ns2:items id="description">*The position of the eyeball with respect to the orbit.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0010">
                <ns2:items id="text">Izbočeno</ns2:items>
                <ns2:items id="description">Zrklo je izbočeno</ns2:items>
            </ns2:items>
            <ns2:items code="at0011">
                <ns2:items id="text">Normalno</ns2:items>
                <ns2:items id="description">Zrklo je v normalnem položaju</ns2:items>
            </ns2:items>
            <ns2:items code="at0012">
                <ns2:items id="text">Vdrto</ns2:items>
                <ns2:items id="description">Zrklo je vdrto</ns2:items>
            </ns2:items>
            <ns2:items code="at0013">
                <ns2:items id="text">Gibanje oči</ns2:items>
                <ns2:items id="description">Opis gibanja oči</ns2:items>
            </ns2:items>
            <ns2:items code="at0014">
                <ns2:items id="text">Zrkli sta v centralnem položaju</ns2:items>
                <ns2:items id="description">Zrkli sta v centralnem položaju</ns2:items>
            </ns2:items>
            <ns2:items code="at0015">
                <ns2:items id="text">Nistagmus</ns2:items>
                <ns2:items id="description">Nistagmus je prisoten</ns2:items>
            </ns2:items>
            <ns2:items code="at0016">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Nistigmus ni prisoten</ns2:items>
            </ns2:items>
            <ns2:items code="at0017">
                <ns2:items id="text">Vertikalen</ns2:items>
                <ns2:items id="description">Prisotnost vertikalnega nistigmusa</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">Horizontalen</ns2:items>
                <ns2:items id="description">Prisotnost horizontalnega nistigmusa</ns2:items>
            </ns2:items>
            <ns2:items code="at0019">
                <ns2:items id="text">Rotacijski</ns2:items>
                <ns2:items id="description">Prisotnost rotacijskega nistigmusa</ns2:items>
            </ns2:items>
            <ns2:items code="at0020">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Pogled je prizadet na levem očesu</ns2:items>
            </ns2:items>
            <ns2:items code="at0021">
                <ns2:items id="text">Ni</ns2:items>
                <ns2:items id="description">Pogled ni prizadet na levem očesu</ns2:items>
            </ns2:items>
            <ns2:items code="at0022">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Pogled je prizadet na desnem očesu</ns2:items>
            </ns2:items>
            <ns2:items code="at0023">
                <ns2:items id="text">Ni</ns2:items>
                <ns2:items id="description">Pogled ni prizadet na desnem očesu</ns2:items>
            </ns2:items>
            <ns2:items code="at0024">
                <ns2:items id="text">Drugo</ns2:items>
                <ns2:items id="description">Doaten opis morebitnih drugih motenj</ns2:items>
            </ns2:items>
            <ns2:items code="at0025">
                <ns2:items id="text">Simetrični očesni veki ob zaprtju</ns2:items>
                <ns2:items id="description">Ali so očesni veki simetrični ob zartju?</ns2:items>
            </ns2:items>
            <ns2:items code="at0026">
                <ns2:items id="text">Izsušene oči</ns2:items>
                <ns2:items id="description">Ali so oči izsušene?</ns2:items>
            </ns2:items>
            <ns2:items code="at0027">
                <ns2:items id="text">Pordele oči</ns2:items>
                <ns2:items id="description">Ali so oči pordele?</ns2:items>
            </ns2:items>
            <ns2:items code="at0028">
                <ns2:items id="text">Halonirane oči</ns2:items>
                <ns2:items id="description">Ali so oči halonirane?</ns2:items>
            </ns2:items>
            <ns2:items code="at0029">
                <ns2:items id="text">Se odziva na svetlobo</ns2:items>
                <ns2:items id="description">Opazovanje odzivanja oči na svetlobo</ns2:items>
            </ns2:items>
            <ns2:items code="at0030">
                <ns2:items id="text">Solzenje</ns2:items>
                <ns2:items id="description">Opazovanje solzenja</ns2:items>
            </ns2:items>
            <ns2:items code="at0031">
                <ns2:items id="text">Normalno</ns2:items>
                <ns2:items id="description">Normalno solzenje</ns2:items>
            </ns2:items>
            <ns2:items code="at0032">
                <ns2:items id="text">Prekomerno</ns2:items>
                <ns2:items id="description">Prekomerno solzenje</ns2:items>
            </ns2:items>
            <ns2:items code="at0033">
                <ns2:items id="text">Zmanjšano</ns2:items>
                <ns2:items id="description">Zamnjšano solzenje</ns2:items>
            </ns2:items>
            <ns2:items code="at0034">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Zrkli sta v srednjem položaju</ns2:items>
            </ns2:items>
            <ns2:items code="at0035">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Zrkli nista v srednjem položaju</ns2:items>
            </ns2:items>
            <ns2:items code="at0036">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Očesni veki sta simetrični ob zaprtju</ns2:items>
            </ns2:items>
            <ns2:items code="at0037">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Očesni veki niso simetrični ob zaprtju</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Oči so izsušene</ns2:items>
            </ns2:items>
            <ns2:items code="at0039">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Oči niso izsušene</ns2:items>
            </ns2:items>
            <ns2:items code="at0040">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Oči so pordele</ns2:items>
            </ns2:items>
            <ns2:items code="at0041">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Oči niso pordele</ns2:items>
            </ns2:items>
            <ns2:items code="at0042">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Oči so halonirane</ns2:items>
            </ns2:items>
            <ns2:items code="at0043">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Oči niso halonirane</ns2:items>
            </ns2:items>
            <ns2:items code="at0044">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Oči se odzivajo na svetlobo</ns2:items>
            </ns2:items>
            <ns2:items code="at0045">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Oči se ne odzivajo na svetlobo</ns2:items>
            </ns2:items>
            <ns2:items code="at0047">
                <ns2:items id="text">Izcedek</ns2:items>
                <ns2:items id="description">Ali je prisoten izcedek iz oči? </ns2:items>
            </ns2:items>
            <ns2:items code="at0048">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Izcedek je prisoten</ns2:items>
            </ns2:items>
            <ns2:items code="at0049">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Izcedka ni</ns2:items>
            </ns2:items>
            <ns2:items code="at0050">
                <ns2:items id="text">Opombe</ns2:items>
                <ns2:items id="description">Dodatne opombe</ns2:items>
            </ns2:items>
            <ns2:items code="at0051">
                <ns2:items id="text">Normalen vid</ns2:items>
                <ns2:items id="description">Normalen vid</ns2:items>
            </ns2:items>
            <ns2:items code="at0052">
                <ns2:items id="text">Normalen vid s korekciijo</ns2:items>
                <ns2:items id="description">Normalen vid s korekciijo</ns2:items>
            </ns2:items>
            <ns2:items code="at0055">
                <ns2:items id="text">Opombe</ns2:items>
                <ns2:items id="description">Opombe</ns2:items>
            </ns2:items>
            <ns2:items code="at0056">
                <ns2:items id="text">Posebnosti</ns2:items>
                <ns2:items id="description">Ali pacient ima neke dodatne posebnosti z očmi?</ns2:items>
            </ns2:items>
            <ns2:items code="at0057">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Da, pacient ima normalen vid</ns2:items>
            </ns2:items>
            <ns2:items code="at0058">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Ne pacient nima normalnega vida</ns2:items>
            </ns2:items>
            <ns2:items code="at0059">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Da, pacient ima normalen vid s korekcijo (npr. očala)</ns2:items>
            </ns2:items>
            <ns2:items code="at0060">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Ne, pacient nima normalnega vida s korekcijo (npr. očala)</ns2:items>
            </ns2:items>
            <ns2:items code="at0061">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Da, pacient ima posebnosti z očmi</ns2:items>
            </ns2:items>
            <ns2:items code="at0062">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Ne, pacient nima posebnosti z očmi</ns2:items>
            </ns2:items>
            <ns2:items code="at0063">
                <ns2:items id="text">Slabovidnost</ns2:items>
                <ns2:items id="description">Je pacient slaboviden?</ns2:items>
            </ns2:items>
            <ns2:items code="at0064">
                <ns2:items id="text">Da</ns2:items>
                <ns2:items id="description">Da, pacient je slaboviden</ns2:items>
            </ns2:items>
            <ns2:items code="at0065">
                <ns2:items id="text">Ne</ns2:items>
                <ns2:items id="description">Ne, pacient ni slaboviden</ns2:items>
            </ns2:items>
            <ns2:items code="at0066">
