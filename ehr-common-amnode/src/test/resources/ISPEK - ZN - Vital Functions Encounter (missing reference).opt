            </ns2:items>
            <ns2:items code="at0.62">
                <ns2:items id="text">Filter menjan</ns2:items>
                <ns2:items id="description">*Details of ventilator filter changes.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1.1">
                <ns2:items id="text">Umetno ventiliran</ns2:items>
                <ns2:items id="description">*Details of mechanical assisted ventilation accoriding to ZN documentation.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0.63">
                <ns2:items id="text">*Mechanical ventilation(en)</ns2:items>
                <ns2:items id="description">*The intervention is mechanical ventilation.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1">
                <ns2:items id="text">*Mechanical ventilation(en)</ns2:items>
                <ns2:items id="description">*Details of mechanical assisted ventilation.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002.1">
                <ns2:items id="text">*Intervention(en)</ns2:items>
                <ns2:items id="description">*The name of the procedure.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003.1">
                <ns2:items id="text">*Ventilator settings(en)</ns2:items>
                <ns2:items id="description">*Detailed structure describing the procedure carried out, including preparation and details about the method and equipment/devices used.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0058">
                <ns2:items id="text">*Performer(en)</ns2:items>
                <ns2:items id="description">*The person performing the procedure (where not the information provider).(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0059">
                <ns2:items id="text">*Assistant(en)</ns2:items>
                <ns2:items id="description">*A person assisting the key intervention performer.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0000">
                <ns2:items id="text">Izvedena klinična aktivnost</ns2:items>
                <ns2:items id="description">Izvedena klinična aktivnost</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">Aktivnost</ns2:items>
                <ns2:items id="description">Ime, naziv postopka, aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">Podrobnosti</ns2:items>
                <ns2:items id="description">Podroben opis izvedene aktivnosti, npr. priprave, uporabljena metoda, oprema in naprave</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Neopravljeno</ns2:items>
                <ns2:items id="description">TRUE (resnično) pomeni, da aktivnost ni bila opravljena s kliničnega vidika</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">Opombe</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">Zapleti</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0013">
                <ns2:items id="text">Multimedija</ns2:items>
                <ns2:items id="description">Multimedijske predstavitve, npr. slika</ns2:items>
            </ns2:items>
            <ns2:items code="at0014">
                <ns2:items id="text">Razlog</ns2:items>
                <ns2:items id="description">Razlogi za izvedbo aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0015">
                <ns2:items id="text">Nenačrtovan dogodek</ns2:items>
                <ns2:items id="description">Nenačrtovan dogodek, npr. neželen dogodek, ki vpliva na aktivnost</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">Neuspešni poskusi</ns2:items>
                <ns2:items id="description">Število neuspešnih poskusov izvedbe</ns2:items>
            </ns2:items>
            <ns2:items code="at0030">
                <ns2:items id="text">Dodatne naloge</ns2:items>
                <ns2:items id="description">Podatki o nenačrtovanih aktivnostih, katere je bilo potrebno izvesti med aktivnostjo. Ta arhetip zajema naziv in opis naloge, drugi podatki o nalogi pa naj se zapišejo v povezanih (link) arhetipih tipa INSTRUCTION ali ACTION</ns2:items>
            </ns2:items>
            <ns2:items code="at0031">
                <ns2:items id="text">Opis naloge</ns2:items>
                <ns2:items id="description">Opis dodatnih nalog med izvajanjem aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0032">
                <ns2:items id="text">Zapis dodanih nalog</ns2:items>
                <ns2:items id="description">Povazava na zapis o dodatni nalogi</ns2:items>
            </ns2:items>
            <ns2:items code="at0034">
                <ns2:items id="text">Zahteva, sprožena</ns2:items>
                <ns2:items id="description">Initiated - začeta</ns2:items>
            </ns2:items>
            <ns2:items code="at0035">
                <ns2:items id="text">Zahteva, poslana</ns2:items>
                <ns2:items id="description">Sent - poslana v task sezname izvajalcev</ns2:items>
            </ns2:items>
            <ns2:items code="at0036">
                <ns2:items id="text">Aktivnost, načrtovana</ns2:items>
                <ns2:items id="description">Scheduled - načrtovana v urniku</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">Zahteva, preložena</ns2:items>
                <ns2:items id="description">Postoponed - preložena na kasnejši čas</ns2:items>
            </ns2:items>
            <ns2:items code="at0039">
                <ns2:items id="text">Zahteva, preklicana</ns2:items>
                <ns2:items id="description">Cancelled - preklicana zahteva</ns2:items>
            </ns2:items>
            <ns2:items code="at0040">
                <ns2:items id="text">Zahteva, na čakanju</ns2:items>
                <ns2:items id="description">Suspend - zahteva trenutno miruje, lahko jo nadaljujemo v prihodnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0041">
                <ns2:items id="text">Zahteva, takojšnja zaustavitev</ns2:items>
                <ns2:items id="description">Aborted - nepreklicno ustavljena zahteva</ns2:items>
            </ns2:items>
            <ns2:items code="at0043">
                <ns2:items id="text">Zahteva, izvedena</ns2:items>
                <ns2:items id="description">Completed</ns2:items>
            </ns2:items>
            <ns2:items code="at0044">
                <ns2:items id="text">Poročilo pripravljeno</ns2:items>
                <ns2:items id="description">Written - kreirano</ns2:items>
            </ns2:items>
            <ns2:items code="at0045">
                <ns2:items id="text">Poročilo potrjeno</ns2:items>
                <ns2:items id="description">Attested - primerno za distribucijo</ns2:items>
            </ns2:items>
            <ns2:items code="at0046">
                <ns2:items id="text">Poročilo poslano</ns2:items>
                <ns2:items id="description">Sent - distribuirano prejemnikom</ns2:items>
            </ns2:items>
            <ns2:items code="at0047">
                <ns2:items id="text">Se izvaja</ns2:items>
                <ns2:items id="description">Aktinost je v teku</ns2:items>
            </ns2:items>
            <ns2:items code="at0048">
                <ns2:items id="text">Rezultat</ns2:items>
                <ns2:items id="description">Rezultat, sprotno vrednotenje izvedene aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0049">
                <ns2:items id="text">Opis</ns2:items>
                <ns2:items id="description">Narrative description about the procedure carried out.</ns2:items>
            </ns2:items>
            <ns2:items code="at0050">
                <ns2:items id="text">Anatomska lokacija</ns2:items>
                <ns2:items id="description">Podrobnosti o anatomski lokaciji, vezani na aktivnost</ns2:items>
            </ns2:items>
            <ns2:items code="at0051">
                <ns2:items id="text">Metoda, tehnika</ns2:items>
                <ns2:items id="description">ID uporabljene metode oz. tehnike</ns2:items>
            </ns2:items>
            <ns2:items code="at0052">
                <ns2:items id="text">Naloga</ns2:items>
                <ns2:items id="description">Naziv dodatne naloge, ki se je izvedla med aktivnostjo</ns2:items>
            </ns2:items>
            <ns2:items code="at0053">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0054">
                <ns2:items id="text">ID naročila - naročnik</ns2:items>
                <ns2:items id="description">Interni ID naročila, kot ga določi naročnik, npr. številka napotnice</ns2:items>
            </ns2:items>
            <ns2:items code="at0055">
                <ns2:items id="text">Naročnik</ns2:items>
                <ns2:items id="description">Kdo je naročil aktivnost, posameznik ali organizacija</ns2:items>
            </ns2:items>
            <ns2:items code="at0056">
                <ns2:items id="text">ID naročila - prejemnik</ns2:items>
                <ns2:items id="description">Interni ID naročila, kot ga določi prejemnik, npr. zap.št.pošte</ns2:items>
            </ns2:items>
            <ns2:items code="at0057">
                <ns2:items id="text">Prejemnik</ns2:items>
                <ns2:items id="description">Prejemnik naročila za izvedbo aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0060">
                <ns2:items id="text">Odstopanja</ns2:items>
                <ns2:items id="description">Opis odstopanj med načrtovano in izvedeno aktivnostjo</ns2:items>
            </ns2:items>
            <ns2:items code="at0061">
                <ns2:items id="text">Lokalizacija</ns2:items>
                <ns2:items id="description">Podrobnosti za podporo procesom in drugim lokalnim zahtavam (cluster)</ns2:items>
            </ns2:items>
            <ns2:items code="at0062">
                <ns2:items id="text">Opis naloge</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0063">
                <ns2:items id="text">Datum in ura izvedbe</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
