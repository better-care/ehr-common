                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Body mass index</ns2:items>
                            <ns2:items id="description">Calculated measurement which compares a person's weight and height.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">history</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">Any timed recording of Body Mass Index.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">Single</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0004">
                            <ns2:items id="text">Body Mass Index</ns2:items>
                            <ns2:items id="description">Index describing ratio of weight to height.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0005">
                            <ns2:items id="text">List</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0006">
                            <ns2:items id="text">Method</ns2:items>
                            <ns2:items id="description">The method of entering the Body Mass Index.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0007">
                            <ns2:items id="text">Automatic entry</ns2:items>
                            <ns2:items id="description">Body Mass Index calculated and entered automatically without user intervention.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0008">
                            <ns2:items id="text">Direct entry</ns2:items>
                            <ns2:items id="description">Body Mass Index calculated and entered directly by user.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0010">
                            <ns2:items id="text">Formula</ns2:items>
                            <ns2:items id="description">Formula used to derive the Body Mass Index.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0011">
                            <ns2:items id="text">Comment</ns2:items>
                            <ns2:items id="description">Comment about the Body Mass Index measurement eg noting that the measurements used were adjusted weight/height.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="kg/m2">
                            <ns2:items id="text">kg/m²</ns2:items>
                            <ns2:items id="description">kg/m²</ns2:items>
                        </ns2:term_definitions>
