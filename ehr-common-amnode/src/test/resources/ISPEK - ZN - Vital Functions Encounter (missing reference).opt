                        <ns2:term_definitions code="at0.32">
                            <ns2:items id="text">Voiding</ns2:items>
                            <ns2:items id="description">Findings related to faecal voiding.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.33">
                            <ns2:items id="text">Bowels moved</ns2:items>
                            <ns2:items id="description">Have the subject's bowels moved?</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.34">
                            <ns2:items id="text">Datetime bowels last moved</ns2:items>
                            <ns2:items id="description">The date and /or time that faeces was last voided.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.35">
                            <ns2:items id="text">Period since bowels last moved</ns2:items>
                            <ns2:items id="description">The time elpased since faeces was last voided.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.36">
                            <ns2:items id="text">Difficulty</ns2:items>
                            <ns2:items id="description">Findings related to difficulty passing faeces.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.37">
                            <ns2:items id="text">Description</ns2:items>
                            <ns2:items id="description">Description of difficulty passing faeces.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.40">
                            <ns2:items id="text">Frequency of voiding</ns2:items>
                            <ns2:items id="description">Frequency of voiding </ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Fluid output</ns2:items>
                            <ns2:items id="description">Recording of findings and measurement (or estimation) of bodily output such as fluid output and defaecation. </ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000.1">
                            <ns2:items id="text">Bowel elimination</ns2:items>
                            <ns2:items id="description">Recording of findings and measuremenrealted to defaecation.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0016.1">
                            <ns2:items id="text">Faeces detail</ns2:items>
                            <ns2:items id="description">Details of the faeces.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Event Series</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">The estimation of fluid output without specifying the period of time.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">List</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0006">
                            <ns2:items id="text">Total</ns2:items>
                            <ns2:items id="description">For recording total fluid output over a period (may transcend a number of interval or point in time records).</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0007">
                            <ns2:items id="text">Actual</ns2:items>
                            <ns2:items id="description">For recording the fluid output over a period of time when this will later be totalled.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0008">
                            <ns2:items id="text">List</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0016">
                            <ns2:items id="text">Fluid detail</ns2:items>
                            <ns2:items id="description">Details of the fluid or substance observed being observed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0018">
                            <ns2:items id="text">Estimated</ns2:items>
                            <ns2:items id="description">The fluid volume has been estimated.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0019">
                            <ns2:items id="text">Measured</ns2:items>
                            <ns2:items id="description">The fluid volume has been directly measured.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0020">
                            <ns2:items id="text">Stated</ns2:items>
                            <ns2:items id="description">The fluid output has been stated.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0028">
                            <ns2:items id="text">Measurement device</ns2:items>
                            <ns2:items id="description">Details of device used to measure the fluid output.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0031">
                            <ns2:items id="text">Measurement precision</ns2:items>
                            <ns2:items id="description">Records the level of precision of the fluid output observation.</ns2:items>
                        </ns2:term_definitions>
                    </ns2:children>
