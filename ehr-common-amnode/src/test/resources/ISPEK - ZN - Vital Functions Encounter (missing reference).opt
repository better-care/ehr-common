                                                            <ns2:items id="description">Pins and needles / tingling sensation</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.0.208">
                                                            <ns2:items id="text">Nausea</ns2:items>
                                                            <ns2:items id="description">The pain is associated with nausea.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.0.209">
                                                            <ns2:items id="text">Sleep disturbance</ns2:items>
                                                            <ns2:items id="description">The pain is associated with sleep disturbance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.0.210">
                                                            <ns2:items id="text">Appetite</ns2:items>
                                                            <ns2:items id="description">The pain is associated with poor appetite. </ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.0.211">
