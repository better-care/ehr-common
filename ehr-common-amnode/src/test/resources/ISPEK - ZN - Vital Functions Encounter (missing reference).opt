                                                <ns2:term_definitions code="at0000">
                                                    <ns2:items id="text">Ambient oxygen</ns2:items>
                                                    <ns2:items id="description">The amount of oxygen being delivered to the subject at the time of observation.  Assumed values of 21% O2, Fi02 of 0.21 and Oxygen flow rate of zero.</ns2:items>
                                                </ns2:term_definitions>
                                                <ns2:term_definitions code="at0051">
