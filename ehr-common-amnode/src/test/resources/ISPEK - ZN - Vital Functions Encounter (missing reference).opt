                                                        <ns2:term_definitions code="at0.100">
                                                            <ns2:items id="text">Black</ns2:items>
                                                            <ns2:items id="description">The stool is black. </ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.101">
                                                            <ns2:items id="text">Green</ns2:items>
                                                            <ns2:items id="description">The stool has a green color.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.102">
                                                            <ns2:items id="text">Blue</ns2:items>
                                                            <ns2:items id="description">The stool has a blue colour.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.103">
                                                            <ns2:items id="text">Silver/white</ns2:items>
                                                            <ns2:items id="description">The stool has a silver/white color.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.104">
                                                            <ns2:items id="text">Melaena</ns2:items>
                                                            <ns2:items id="description">The stool contains melaena.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.105">
                                                            <ns2:items id="text">Blood</ns2:items>
                                                            <ns2:items id="description">The stool contains blood.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.106">
                                                            <ns2:items id="text">Mucous</ns2:items>
                                                            <ns2:items id="description">The stool contains mucous.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.108">
                                                            <ns2:items id="text">Blood streaks</ns2:items>
                                                            <ns2:items id="description">Blood streaks</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.109">
                                                            <ns2:items id="text">Other</ns2:items>
                                                            <ns2:items id="description">Other</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.111">
                                                            <ns2:items id="text">Malena</ns2:items>
                                                            <ns2:items id="description">Malena</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.84">
                                                            <ns2:items id="text">Faeces</ns2:items>
                                                            <ns2:items id="description">Faeces or stool.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.85">
                                                            <ns2:items id="text">Solid faeces weight</ns2:items>
                                                            <ns2:items id="description">The amount of faeces as a weight.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.87">
                                                            <ns2:items id="text">Bristol stool scale</ns2:items>
                                                            <ns2:items id="description">A score to assess the characteristics of faeces. </ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.88">
                                                            <ns2:items id="text">Separate hard lumps, like nuts (hard to pass)</ns2:items>
                                                            <ns2:items id="description">Stool consists of separate hard lumps, like nuts (hard to pass).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.90">
                                                            <ns2:items id="text">Sausage-shaped, but lumpy</ns2:items>
                                                            <ns2:items id="description">Stool is sausage-shaped, but lumpy.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.91">
                                                            <ns2:items id="text">Like a sausage but with cracks on its surface</ns2:items>
                                                            <ns2:items id="description">Stool is like a sausage but with cracks on its surface.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.92">
                                                            <ns2:items id="text">Like a sausage or snake, smooth and soft</ns2:items>
                                                            <ns2:items id="description">Stool is like a sausage or snake, smooth and soft.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.93">
                                                            <ns2:items id="text">Soft blobs with clear cut edges (passed easily)</ns2:items>
                                                            <ns2:items id="description">Stool consists of soft blobs with clear cut edges (passed easily).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.94">
                                                            <ns2:items id="text">Fluffy pieces with ragged edges, a mushy stool</ns2:items>
                                                            <ns2:items id="description">Stool consists of fluffy pieces with ragged edges, a mushy stool.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.95">
                                                            <ns2:items id="text">Watery, no solid pieces. Entirely liquid</ns2:items>
                                                            <ns2:items id="description">Stool is watery, no solid pieces. Entirely liquid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.96">
                                                            <ns2:items id="text">Normal</ns2:items>
                                                            <ns2:items id="description">The stool smells normal.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.97">
                                                            <ns2:items id="text">Abnormal</ns2:items>
                                                            <ns2:items id="description">Stool smells abnormal.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.98">
                                                            <ns2:items id="text">Normal  / brown / regular</ns2:items>
                                                            <ns2:items id="description">The stool is a normal colour</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.99">
                                                            <ns2:items id="text">Yellow</ns2:items>
                                                            <ns2:items id="description">The stool has a yellow colour.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0000.1">
                                                            <ns2:items id="text">Faeces</ns2:items>
                                                            <ns2:items id="description">Findings related to faeces. </ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0001.1">
                                                            <ns2:items id="text">Substance - faeces</ns2:items>
                                                            <ns2:items id="description">The name of the bodily substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0007.1">
                                                            <ns2:items id="text">Fluid faeces volume</ns2:items>
                                                            <ns2:items id="description">The volume of faeces as fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0013.1">
                                                            <ns2:items id="text">Stool colour</ns2:items>
                                                            <ns2:items id="description">The colour of the substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0032.1">
                                                            <ns2:items id="text">Contained substances</ns2:items>
                                                            <ns2:items id="description">Other substances mixed within the main bodily substance being described.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0067">
                                                            <ns2:items id="text">Odour</ns2:items>
                                                            <ns2:items id="description">The  odour(s) of the substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0067.1">
                                                            <ns2:items id="text">Stool odour</ns2:items>
                                                            <ns2:items id="description">Odour of the stool.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0075.1">
                                                            <ns2:items id="text">Faeces present</ns2:items>
                                                            <ns2:items id="description">Faeces is present.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0086">
                                                            <ns2:items id="text">Characteristics</ns2:items>
                                                            <ns2:items id="description">Findings related to characteristics of the bodily substance. </ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0094.1">
                                                            <ns2:items id="text">Substances within faeces</ns2:items>
                                                            <ns2:items id="description">Substances within the faeces.  </ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0000">
                                                            <ns2:items id="text">Bodily substance</ns2:items>
                                                            <ns2:items id="description">An excreted, secreted or otherwise output bodily substance such as blood, sputum, vomit, urine, faeces.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0001">
                                                            <ns2:items id="text">Name of substance</ns2:items>
                                                            <ns2:items id="description">The name of the bodily substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0002">
                                                            <ns2:items id="text">Source</ns2:items>
                                                            <ns2:items id="description">The source of the fluid or substance. Often a device or container.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0003">
                                                            <ns2:items id="text">Normal statements</ns2:items>
                                                            <ns2:items id="description">A statement about the normality of the fluid or substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0005">
                                                            <ns2:items id="text">Clinical description</ns2:items>
                                                            <ns2:items id="description">A text description of the fluid or substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0006">
                                                            <ns2:items id="text">Quantity</ns2:items>
                                                            <ns2:items id="description">Statements about the quantity of the bodily substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0007">
                                                            <ns2:items id="text">Fluid volume</ns2:items>
                                                            <ns2:items id="description">The volume of the substance as a fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0008">
                                                            <ns2:items id="text">Change in amount</ns2:items>
                                                            <ns2:items id="description">Statement about the change in the quantity of substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0009">
                                                            <ns2:items id="text">Increasing</ns2:items>
                                                            <ns2:items id="description">Increasing volumes of fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0010">
                                                            <ns2:items id="text">Stable</ns2:items>
                                                            <ns2:items id="description">The volume of fluid or liquid is stable.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0011">
                                                            <ns2:items id="text">Decreasing</ns2:items>
                                                            <ns2:items id="description">The volume of fluid is decreasing.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0012">
                                                            <ns2:items id="text">Ceased</ns2:items>
                                                            <ns2:items id="description">The quantity of body fluid is now zero.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0013">
                                                            <ns2:items id="text">Colour</ns2:items>
                                                            <ns2:items id="description">The colour of the substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0014">
                                                            <ns2:items id="text">Turbidity</ns2:items>
                                                            <ns2:items id="description">The degree of solid material suspended in the substance as a fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0015">
                                                            <ns2:items id="text">Clear</ns2:items>
                                                            <ns2:items id="description">The fluid or secretion is crystal clear.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0016">
                                                            <ns2:items id="text">Slightly cloudy</ns2:items>
                                                            <ns2:items id="description">There is a small amount of solid suspended in the fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0017">
                                                            <ns2:items id="text">Cloudy</ns2:items>
                                                            <ns2:items id="description">There is a large amount of solid suspended but it still transmits light.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0018">
                                                            <ns2:items id="text">Opaque</ns2:items>
                                                            <ns2:items id="description">There is so much solid suspended that the fluid does not transmit light.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0019">
                                                            <ns2:items id="text">Flocculent</ns2:items>
                                                            <ns2:items id="description">The fluid is mostly composed of suspended solids.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0020">
                                                            <ns2:items id="text">Viscosity</ns2:items>
                                                            <ns2:items id="description">The viscosity of the substance as a fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0021">
                                                            <ns2:items id="text">Watery</ns2:items>
                                                            <ns2:items id="description">The fluid flows like water.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0022">
                                                            <ns2:items id="text">Oily/viscous</ns2:items>
                                                            <ns2:items id="description">The fluid flows like an oil.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0023">
                                                            <ns2:items id="text">Creamy/sticky</ns2:items>
                                                            <ns2:items id="description">The fluid is quite thick and flows like cream.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0024">
                                                            <ns2:items id="text">Thick</ns2:items>
                                                            <ns2:items id="description">The fluid does not flow.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0025">
                                                            <ns2:items id="text">Amount</ns2:items>
                                                            <ns2:items id="description">The amount of substance as a text category.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0026">
                                                            <ns2:items id="text">None</ns2:items>
                                                            <ns2:items id="description">There is no longer any fluid /substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0027">
                                                            <ns2:items id="text">Scant</ns2:items>
                                                            <ns2:items id="description">There is a small amount of fluid/substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0028">
                                                            <ns2:items id="text">Minimal</ns2:items>
                                                            <ns2:items id="description">There is a minimal amount of fluid/substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0029">
                                                            <ns2:items id="text">Moderate</ns2:items>
                                                            <ns2:items id="description">There is a moderate amount of fluid/ substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0030">
                                                            <ns2:items id="text">Heavy</ns2:items>
                                                            <ns2:items id="description">There is a heavy amount of fluid/substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0031">
                                                            <ns2:items id="text">Large</ns2:items>
                                                            <ns2:items id="description">There is a large amount of fluid or substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0032">
                                                            <ns2:items id="text">Contained substances</ns2:items>
                                                            <ns2:items id="description">Other substances mixed within the main bodily substance being described.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0037">
                                                            <ns2:items id="text">Sediment</ns2:items>
                                                            <ns2:items id="description">The amount of sediment in the substance as fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0038">
                                                            <ns2:items id="text">Scant</ns2:items>
                                                            <ns2:items id="description">There is a very small amount of sediment in the fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0039">
                                                            <ns2:items id="text">Moderate</ns2:items>
                                                            <ns2:items id="description">There is a moderate amount of sediment in the fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0040">
                                                            <ns2:items id="text">Profuse</ns2:items>
                                                            <ns2:items id="description">There is a large amount of sediment in the fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0049">
                                                            <ns2:items id="text">Fresh</ns2:items>
                                                            <ns2:items id="description">The bodily substance appears fresh.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0050">
                                                            <ns2:items id="text">Old</ns2:items>
                                                            <ns2:items id="description">The bodily substance appears old.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0063">
                                                            <ns2:items id="text">Waxy</ns2:items>
                                                            <ns2:items id="description">The fluid has a consistency like wax.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0068">
                                                            <ns2:items id="text">Flow amount</ns2:items>
                                                            <ns2:items id="description">A text description of the flow rate of the fluid or secretion.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0069">
                                                            <ns2:items id="text">Flow rate</ns2:items>
                                                            <ns2:items id="description">A numerical expression of flow rate of the fluid or secretion.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0070">
                                                            <ns2:items id="text">Comment</ns2:items>
                                                            <ns2:items id="description">A text comment about the substance quantity.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0075">
                                                            <ns2:items id="text">Substance present</ns2:items>
                                                            <ns2:items id="description">The fluid or substance is present.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0081">
                                                            <ns2:items id="text">Age</ns2:items>
                                                            <ns2:items id="description">Estimated age of the bodily substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0082">
                                                            <ns2:items id="text">Particulate</ns2:items>
                                                            <ns2:items id="description">The fluid has become partially solidified and dispersed within a containing fluid e.g. particulate meconium within liquor.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0083">
                                                            <ns2:items id="text">Contained substance detail</ns2:items>
                                                            <ns2:items id="description">Details of a contained substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0084">
                                                            <ns2:items id="text">Location</ns2:items>
                                                            <ns2:items id="description">The location of the body from where the fluid or substance was collected.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0085">
                                                            <ns2:items id="text">Flow</ns2:items>
                                                            <ns2:items id="description">Findings related to flow of bodily substances as fluids.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0087">
                                                            <ns2:items id="text">Small</ns2:items>
                                                            <ns2:items id="description">The amount of the substance is small.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0088">
                                                            <ns2:items id="text">Clear</ns2:items>
                                                            <ns2:items id="description">There is no sediment present.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0089">
                                                            <ns2:items id="text">Description</ns2:items>
                                                            <ns2:items id="description">Description of contained substances.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0090">
                                                            <ns2:items id="text">Copious</ns2:items>
                                                            <ns2:items id="description">There is a copious amount of bodily substance/fluid.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0091">
                                                            <ns2:items id="text">Frothy</ns2:items>
                                                            <ns2:items id="description">The substance has a frothy consistency</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0092">
                                                            <ns2:items id="text">Solid</ns2:items>
                                                            <ns2:items id="description">The substance has solidified.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0093">
                                                            <ns2:items id="text">Normal</ns2:items>
                                                            <ns2:items id="description">The consistency of the substance is normal.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0094">
                                                            <ns2:items id="text">Substance name</ns2:items>
                                                            <ns2:items id="description">The name(s) of the contained substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0095">
                                                            <ns2:items id="text">Clear /serous</ns2:items>
                                                            <ns2:items id="description">The substance has a clear or serous colour.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0096">
                                                            <ns2:items id="text">Green</ns2:items>
                                                            <ns2:items id="description">The substance has a green colour.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0097">
                                                            <ns2:items id="text">Yellow</ns2:items>
                                                            <ns2:items id="description">The substance has a yellow colour.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0098">
                                                            <ns2:items id="text">Blood-staind</ns2:items>
                                                            <ns2:items id="description">The substance has a blood - stained colour.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0099">
                                                            <ns2:items id="text">Rust-colored</ns2:items>
                                                            <ns2:items id="description">The substance has a rusty colour.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0100">
                                                            <ns2:items id="text">Milky white/opaqe</ns2:items>
                                                            <ns2:items id="description">The substance has  milky white/opaqe colour.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0101">
                                                            <ns2:items id="text">Black/gray</ns2:items>
                                                            <ns2:items id="description">The substance has black/gray color</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0102">
                                                            <ns2:items id="text">Purulence</ns2:items>
                                                            <ns2:items id="description">Evidence of pus within the substance.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0103">
                                                            <ns2:items id="text">Not purulent</ns2:items>
                                                            <ns2:items id="description">The substance is not purulent.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0104">
                                                            <ns2:items id="text">Purulent</ns2:items>
                                                            <ns2:items id="description">The substance appears to contain pus.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0105">
                                                            <ns2:items id="text">Muco-purulent</ns2:items>
                                                            <ns2:items id="description">The substance appears to contain a mixture of mucus and pus.</ns2:items>
                                                        </ns2:term_definitions>
                                                    </ns2:children>
