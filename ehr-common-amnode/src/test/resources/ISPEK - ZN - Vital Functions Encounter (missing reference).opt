                            <ns2:value>openEHR-EHR-OBSERVATION.waist_hip.v1</ns2:value>
                        </ns2:archetype_id>
                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Waist, abdominal and hip circumference</ns2:items>
                            <ns2:items id="description">The waist (or girth), abdominal and hip circumference.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Event Series</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">Timing event</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">List</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0004">
                            <ns2:items id="text">Waist/abdominal circumference</ns2:items>
                            <ns2:items id="description">Defined by WHO as the circumference of the trunk measured midway between the inferior margin of the last rib and the crest of the ilium in a horizontal plane. Equivalent to WHO 'Abdominal circumference'.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0005">
                            <ns2:items id="text">Hip circumference</ns2:items>
                            <ns2:items id="description">Measurement of body circumference at the widest point of the buttocks.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0006">
                            <ns2:items id="text">Waist:hip ratio</ns2:items>
                            <ns2:items id="description">Ratio of waist/abdominal circumference to hip circumference .</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0007">
                            <ns2:items id="text">Maximum abdominal circumference</ns2:items>
                            <ns2:items id="description">The circumference of the widest part of the trunk  at the end of normal expiration.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0008">
                            <ns2:items id="text">Minimum waist circumference</ns2:items>
                            <ns2:items id="description">The circumference of the narrowest part of the trunk at the end of normal expiration. Equivalent to WHO 'Waist circumference'</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0009">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0010">
                            <ns2:items id="text">Waist/abdominal measurement method</ns2:items>
                            <ns2:items id="description">Details of methodology used to measure abdominal/waist circumference. </ns2:items>
                        </ns2:term_definitions>
                    </ns2:children>
