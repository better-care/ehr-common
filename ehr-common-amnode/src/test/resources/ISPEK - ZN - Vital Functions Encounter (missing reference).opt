                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.0.200">
                                                            <ns2:items id="text">11 faces</ns2:items>
                                                            <ns2:items id="description">The 11 faces scale was used.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0.0.201">
