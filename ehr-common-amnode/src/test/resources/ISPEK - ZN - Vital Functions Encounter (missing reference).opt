                        <ns2:term_definitions code="at0042">
                            <ns2:items id="text">Body position/exercise</ns2:items>
                            <ns2:items id="description">Body position and exercise level of the subject.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0046">
                            <ns2:items id="text">1 - None</ns2:items>
                            <ns2:items id="description">1 - None.   Retractions are not visible as indentations of the soft tissue covering the chest wall.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0047">
                            <ns2:items id="text">1-2 None =&gt; Moderate</ns2:items>
                            <ns2:items id="description">1-2 None to Moderate.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0048">
                            <ns2:items id="text">2-1 Moderate =&gt; None</ns2:items>
                            <ns2:items id="description">2-1 Moderate to None.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0049">
                            <ns2:items id="text">2 - Moderate</ns2:items>
                            <ns2:items id="description">2 - Moderate.  Retractions are visible as mild indentations of the soft tissue covering the chest wall.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0050">
                            <ns2:items id="text">2-3  Moderate=&gt; Severe</ns2:items>
                            <ns2:items id="description">2-3  Moderate to Severe.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0051">
                            <ns2:items id="text">3-2 Severe =&gt; Moderate</ns2:items>
                            <ns2:items id="description">3-2 Severe to Moderate.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0052">
                            <ns2:items id="text">3 - Severe</ns2:items>
                            <ns2:items id="description">3 - Severe. Retractions are visible as severe indentations of the soft tissue covering the chest wall.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0053">
                            <ns2:items id="text">None</ns2:items>
                            <ns2:items id="description">No signs of upper airway obstruction.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0054">
                            <ns2:items id="text">Nasal congestion</ns2:items>
                            <ns2:items id="description">The upper airway is obstructed by nasal congestion.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0055">
                            <ns2:items id="text">Foreign body</ns2:items>
                            <ns2:items id="description">The upper airway is obstructed by a foreign body.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0056">
                            <ns2:items id="text">Nose bleed</ns2:items>
                            <ns2:items id="description">The upper airway is obstructed by nose bleed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0057">
                            <ns2:items id="text">On effort</ns2:items>
                            <ns2:items id="description">The state of patient on effort</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0058">
                            <ns2:items id="text">Resting</ns2:items>
                            <ns2:items id="description">The state of patient at resting</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0059">
                            <ns2:items id="text">After effort</ns2:items>
                            <ns2:items id="description">The state of patient after effort</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0060">
                            <ns2:items id="text">Ortopnoa</ns2:items>
                            <ns2:items id="description">The state of patient after effort is Ortopnoa</ns2:items>
                        </ns2:term_definitions>
