                            <ns2:items id="description">Location of pallor.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0005">
                            <ns2:items id="text">Cyanosis location</ns2:items>
                            <ns2:items id="description">Location of cyanosis.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0006">
                            <ns2:items id="text">Colour</ns2:items>
                            <ns2:items id="description">Visible skin color from fixed list.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0007">
                            <ns2:items id="text">Trancutaneous bilirubin</ns2:items>
                            <ns2:items id="description">Findings of transcutaneous bilirubin measurements.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0008">
                            <ns2:items id="text">Location</ns2:items>
                            <ns2:items id="description">Location of transcutaneous bilirubin measurement.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0009">
                            <ns2:items id="text">Value</ns2:items>
                            <ns2:items id="description">Transcutaneous bilrubin measurement.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0010">
                            <ns2:items id="text">Skin temperature</ns2:items>
                            <ns2:items id="description">Areas of abnormal skin temperature.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0011">
                            <ns2:items id="text">Location of warmth</ns2:items>
                            <ns2:items id="description">Location(s) of abnormal skin temperature.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0012">
                            <ns2:items id="text">Temperature</ns2:items>
                            <ns2:items id="description">Abnormal skin temperature.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0015">
                            <ns2:items id="text">Hydration</ns2:items>
                            <ns2:items id="description">Details of skin hydration.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0017">
