    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.glasgow_coma-paed.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0.41">
                <ns2:items id="text">Gibanje (otroci mlajši od 2 let)</ns2:items>
                <ns2:items id="description">Gibanje (otroci mlajši od 2 let)</ns2:items>
            </ns2:items>
            <ns2:items code="at0.42">
                <ns2:items id="text">Ni odziva</ns2:items>
                <ns2:items id="description">Ni odziva</ns2:items>
            </ns2:items>
            <ns2:items code="at0.43">
                <ns2:items id="text">Iztegnjena drža</ns2:items>
                <ns2:items id="description">Iztegnjena drža kot odziv na bolečino</ns2:items>
            </ns2:items>
            <ns2:items code="at0.44">
                <ns2:items id="text">Pokrčena drža</ns2:items>
                <ns2:items id="description">Pokrčena drža kot odziv na bolečino</ns2:items>
            </ns2:items>
            <ns2:items code="at0.45">
                <ns2:items id="text">Reakcija na bolečino</ns2:items>
                <ns2:items id="description">Reakcija na bolečino</ns2:items>
            </ns2:items>
            <ns2:items code="at0.46">
                <ns2:items id="text">Reakcija na dotik</ns2:items>
                <ns2:items id="description">Reakcija na dotik</ns2:items>
            </ns2:items>
            <ns2:items code="at0.47">
                <ns2:items id="text">Spontano</ns2:items>
                <ns2:items id="description">Se giblje spontano in z namenom</ns2:items>
            </ns2:items>
            <ns2:items code="at0.48">
                <ns2:items id="text">Govor (otroci mlajši od 2 let)</ns2:items>
                <ns2:items id="description">Opazovanje govora pri otrocih starejših od 2 let</ns2:items>
            </ns2:items>
            <ns2:items code="at0.49">
                <ns2:items id="text">Govor (otroci mlajši od 30 dni)</ns2:items>
                <ns2:items id="description">Opazovanje govora pri otrocih mlajših od 30 let</ns2:items>
            </ns2:items>
            <ns2:items code="at0.50">
                <ns2:items id="text">Ni odziva</ns2:items>
                <ns2:items id="description">Ni odziva pri govoru</ns2:items>
            </ns2:items>
            <ns2:items code="at0.51">
                <ns2:items id="text">Nerazločljivi glasovi</ns2:items>
                <ns2:items id="description">Godrnjanje</ns2:items>
            </ns2:items>
            <ns2:items code="at0.52">
                <ns2:items id="text">Odgovarja nerazumljive besede</ns2:items>
                <ns2:items id="description">Odgovarja nerazumljive besede</ns2:items>
            </ns2:items>
            <ns2:items code="at0.53">
                <ns2:items id="text">Zmeden, dezorientiran</ns2:items>
                <ns2:items id="description">Govori, vendar je zmeden</ns2:items>
            </ns2:items>
            <ns2:items code="at0.54">
                <ns2:items id="text">Orientiran, normalen pogovor</ns2:items>
                <ns2:items id="description">Orientiran, normalen pogovor</ns2:items>
            </ns2:items>
            <ns2:items code="at0.55">
                <ns2:items id="text">Ni odziva</ns2:items>
                <ns2:items id="description">Ni verbalnega odziva</ns2:items>
            </ns2:items>
            <ns2:items code="at0.56">
                <ns2:items id="text">Stokanje</ns2:items>
                <ns2:items id="description">Občasno zastoka</ns2:items>
            </ns2:items>
            <ns2:items code="at0.57">
                <ns2:items id="text">Jokanje</ns2:items>
                <ns2:items id="description">Joka brez razloga </ns2:items>
            </ns2:items>
            <ns2:items code="at0.58">
                <ns2:items id="text">Razdražljiv jok</ns2:items>
                <ns2:items id="description">Spontan razdražljiv jok</ns2:items>
            </ns2:items>
            <ns2:items code="at0.59">
                <ns2:items id="text">Živahen</ns2:items>
                <ns2:items id="description">Dojenček je živahen in poskuša komunicirati</ns2:items>
            </ns2:items>
            <ns2:items code="at0.60">
                <ns2:items id="text">Izgled obraza</ns2:items>
                <ns2:items id="description">Izgled obraza (grimase)</ns2:items>
            </ns2:items>
            <ns2:items code="at0.61">
                <ns2:items id="text">Ni odziva</ns2:items>
                <ns2:items id="description">Se ne odziva na bolečino s spakovanjem obraza</ns2:items>
            </ns2:items>
            <ns2:items code="at0.62">
                <ns2:items id="text">Majhno spakovanje</ns2:items>
                <ns2:items id="description">Majhno spakovanje</ns2:items>
            </ns2:items>
            <ns2:items code="at0.63">
                <ns2:items id="text">Močno spakovanje</ns2:items>
                <ns2:items id="description">Močno spakovanje</ns2:items>
            </ns2:items>
            <ns2:items code="at0.64">
                <ns2:items id="text">Samo na dotik</ns2:items>
                <ns2:items id="description">Spakovanje samo na dotik</ns2:items>
            </ns2:items>
            <ns2:items code="at0.65">
                <ns2:items id="text">Normalen</ns2:items>
                <ns2:items id="description">Ima normalen izgled obraza</ns2:items>
            </ns2:items>
            <ns2:items code="at0000">
                <ns2:items id="text">Glasgow Coma Scale</ns2:items>
                <ns2:items id="description">Fifteen point scale used to assess the level of consciousness of a subject. Also known as the Modified Glasgow Coma Scale.</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1">
                <ns2:items id="text">Glasgow Coma Scale</ns2:items>
                <ns2:items id="description">Pediatrična Glasgow Coma Scale - 15 točkovna lestvica za oceno zavesti pri odraslih otrocih in novorojenčkih</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">Event Series</ns2:items>
                <ns2:items id="description">@ internal @</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">Any event</ns2:items>
                <ns2:items id="description">Any event</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">Tree</ns2:items>
                <ns2:items id="description">@ internal @</ns2:items>
            </ns2:items>
            <ns2:items code="at0007">
                <ns2:items id="text">Best verbal response (V)</ns2:items>
                <ns2:items id="description">Best verbal response to stimulus.</ns2:items>
            </ns2:items>
            <ns2:items code="at0007.1">
                <ns2:items id="text">Govor</ns2:items>
                <ns2:items id="description">Opazovanje govora pri odraslih</ns2:items>
            </ns2:items>
            <ns2:items code="at0008">
                <ns2:items id="text">Best motor response (M)</ns2:items>
                <ns2:items id="description">Best motor response to stimulus.</ns2:items>
            </ns2:items>
            <ns2:items code="at0008.1">
                <ns2:items id="text">Best motor response (M)</ns2:items>
                <ns2:items id="description">Gibanje pri otrocih do 2 let</ns2:items>
            </ns2:items>
            <ns2:items code="at0009">
                <ns2:items id="text">Best eye response (E)</ns2:items>
                <ns2:items id="description">Best eye response to stimulus.</ns2:items>
            </ns2:items>
            <ns2:items code="at0010">
                <ns2:items id="text">No response</ns2:items>
                <ns2:items id="description">Does not open eyes.</ns2:items>
            </ns2:items>
            <ns2:items code="at0011">
                <ns2:items id="text">Eyes open in response to pain</ns2:items>
                <ns2:items id="description">Opens eyes in response to painful stimuli in limbs.</ns2:items>
            </ns2:items>
            <ns2:items code="at0012">
                <ns2:items id="text">Eyes open in response to speech</ns2:items>
                <ns2:items id="description">Opens eyes in response to any verbal approach.</ns2:items>
            </ns2:items>
            <ns2:items code="at0013">
                <ns2:items id="text">Spontaneous eye opening</ns2:items>
                <ns2:items id="description">Opens eyes spontaneously.</ns2:items>
            </ns2:items>
            <ns2:items code="at0014">
                <ns2:items id="text">No response</ns2:items>
                <ns2:items id="description">No verbal response.</ns2:items>
            </ns2:items>
            <ns2:items code="at0015">
                <ns2:items id="text">Incomprehensible sounds</ns2:items>
                <ns2:items id="description">Moans or groans, but no recognisable words.</ns2:items>
            </ns2:items>
            <ns2:items code="at0016">
                <ns2:items id="text">Inappropriate speech</ns2:items>
                <ns2:items id="description">Intelligible speech, but no conversational exchange.</ns2:items>
            </ns2:items>
            <ns2:items code="at0017">
                <ns2:items id="text">Confused conversation</ns2:items>
                <ns2:items id="description">Converses, but confused and disoriented in their environment.</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">Oriented</ns2:items>
                <ns2:items id="description">Converses, oriented to their environment.</ns2:items>
            </ns2:items>
            <ns2:items code="at0019">
                <ns2:items id="text">No response</ns2:items>
                <ns2:items id="description">No motor response; limbs flaccid.</ns2:items>
            </ns2:items>
            <ns2:items code="at0020">
                <ns2:items id="text">Extensor response</ns2:items>
                <ns2:items id="description">Abnormal extension to pain.</ns2:items>
            </ns2:items>
            <ns2:items code="at0021">
                <ns2:items id="text">Flexor response</ns2:items>
                <ns2:items id="description">Abnormal flexion to pain.</ns2:items>
            </ns2:items>
            <ns2:items code="at0022">
                <ns2:items id="text">Withdrawal response</ns2:items>
                <ns2:items id="description">Flexion withdrawal response to pain.</ns2:items>
            </ns2:items>
            <ns2:items code="at0023">
                <ns2:items id="text">Localises pain</ns2:items>
                <ns2:items id="description">Localised movement in response to pain.</ns2:items>
            </ns2:items>
            <ns2:items code="at0024">
                <ns2:items id="text">Obeys commands</ns2:items>
                <ns2:items id="description">Follows simple verbal commands.</ns2:items>
            </ns2:items>
            <ns2:items code="at0026">
                <ns2:items id="text">Total score</ns2:items>
                <ns2:items id="description">The sum of the 3 ordinal scores for each component parameter.</ns2:items>
            </ns2:items>
            <ns2:items code="at0030">
                <ns2:items id="text">EMV profile</ns2:items>
                <ns2:items id="description">Eye Motor Verbal profile expressing each component individually. This can be derived as a combination of the preceding elements.</ns2:items>
            </ns2:items>
            <ns2:items code="at0034">
                <ns2:items id="text">Not able to test eye response</ns2:items>
                <ns2:items id="description">Not possible to test eye responses - for example in the case of associated severe facial/eye swelling or damage.</ns2:items>
            </ns2:items>
            <ns2:items code="at0035">
                <ns2:items id="text">Not able to test verbal response</ns2:items>
                <ns2:items id="description">Not possible to test verbal responses - for example in the case of associated intubation.</ns2:items>
            </ns2:items>
            <ns2:items code="at0036">
                <ns2:items id="text">Not able to test motor response</ns2:items>
                <ns2:items id="description">Not possible to test motor responses - for example in the case of associated limb paralysis.</ns2:items>
            </ns2:items>
            <ns2:items code="at0037">
                <ns2:items id="text">Comment</ns2:items>
                <ns2:items id="description">Comment about measurement of the Scale, especially if it was not possible to assess a response.</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">Reason for inability to test eye response</ns2:items>
                <ns2:items id="description">Reason for inability to test eye response.</ns2:items>
            </ns2:items>
            <ns2:items code="at0039">
                <ns2:items id="text">Reason for inability to test verbal response</ns2:items>
                <ns2:items id="description">Reason for inability to test verbal response.</ns2:items>
            </ns2:items>
            <ns2:items code="at0040">
                <ns2:items id="text">Reason for inability to test motor response</ns2:items>
                <ns2:items id="description">Reason for inability to test motor response.</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.story.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Story</ns2:items>
                <ns2:items id="description">*A structure to collect information provided by the person or information provider in relation to the symptoms and difficulties they are presenting to the clinician(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Event Series(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">*Any event(en)</ns2:items>
                <ns2:items id="description">*Base for recording the dates or intervals which apply(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Status ob sprejemu</ns2:items>
                <ns2:items id="description">Podatki o statusu pacienta ob sprejemu.</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">Podrobnosti</ns2:items>
                <ns2:items id="description">Podrobnosti</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-CLUSTER.symptom-pain-zn.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0.0.195">
                <ns2:items id="text">Sedenje</ns2:items>
                <ns2:items id="description">Bolečina je prisotna, ko pacient sedi</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.196">
                <ns2:items id="text">Ko pacient stoji</ns2:items>
                <ns2:items id="description">Bolečina je prisotna, ko pacient stoji</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.197">
                <ns2:items id="text">Pri hoji</ns2:items>
                <ns2:items id="description">Bolečina je prisotna, ko pacient hodi</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.198">
                <ns2:items id="text">Leže</ns2:items>
                <ns2:items id="description">Bolečina je prisotna, ko pacient leži</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.199">
                <ns2:items id="text">V mirovanju</ns2:items>
                <ns2:items id="description">Bolečina je prisotna, ko je pacient v mirovanju</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.200">
                <ns2:items id="text">11 obrazov</ns2:items>
                <ns2:items id="description">Lestvica 11 obrazov</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.201">
                <ns2:items id="text">6 obrazov</ns2:items>
                <ns2:items id="description">Lestvica 6 obrazov</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.202">
                <ns2:items id="text">Lestvica VAS</ns2:items>
                <ns2:items id="description">Vizualno analogna lestvica</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.203">
                <ns2:items id="text">Opisna</ns2:items>
                <ns2:items id="description">Opisna lestvica</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.204">
                <ns2:items id="text">Numerična</ns2:items>
                <ns2:items id="description">Numerična lestvica</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.205">
                <ns2:items id="text">Toleranca bolečine</ns2:items>
                <ns2:items id="description">Lestvica Toleranca bolečine</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.206">
                <ns2:items id="text">Meritev aktivnosti</ns2:items>
                <ns2:items id="description">Lestvica Meritev aktivnosti</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.207">
                <ns2:items id="text">Parestetično zaznavanje</ns2:items>
                <ns2:items id="description">Parestetično zaznavanje (zaznavanje dražljajev z bucikam)</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.208">
                <ns2:items id="text">Slabost v želodcu</ns2:items>
                <ns2:items id="description">Bolečina vpliva na slabost v želodcu</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.209">
                <ns2:items id="text">Spanje</ns2:items>
                <ns2:items id="description">Bolečina vpliva na spanje</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.210">
                <ns2:items id="text">Apetit</ns2:items>
                <ns2:items id="description">Bolečina vpliva na apetit</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.211">
                <ns2:items id="text">Fizične aktivnosti</ns2:items>
                <ns2:items id="description">Bolečina vpliva na fizično aktivnost</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.212">
                <ns2:items id="text">Čustvovanje</ns2:items>
                <ns2:items id="description">Bolečina vpliva na čustvovanje</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.213">
                <ns2:items id="text">Koncentracija</ns2:items>
                <ns2:items id="description">Bolečina vpliva na koncentracijo</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.214">
                <ns2:items id="text">Location</ns2:items>
                <ns2:items id="description">Lokacija bolečine</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.215">
                <ns2:items id="text">Površinska</ns2:items>
                <ns2:items id="description">Bolečina je površinska</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.216">
                <ns2:items id="text">Notranja</ns2:items>
                <ns2:items id="description">Bolečina je notranja</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.217">
                <ns2:items id="text">Razpršena</ns2:items>
                <ns2:items id="description">Bolečina je razpršena</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.219">
                <ns2:items id="description">Opis na kaj še bolečina vpliva </ns2:items>
                <ns2:items id="text">Drugo</ns2:items>
                <ns2:items id="comment">*(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.220">
                <ns2:items id="text">Huda bolečina</ns2:items>
                <ns2:items id="description">Huda bolečina</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.221">
                <ns2:items id="text">Huda bolečina</ns2:items>
                <ns2:items id="description">Huda bolečina</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.222">
                <ns2:items id="text">Neznosna bolečina</ns2:items>
                <ns2:items id="description">Neznosna bolečina</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.223">
                <ns2:items id="text">Neznosna bolečina</ns2:items>
                <ns2:items id="description">Neznosna bolečina</ns2:items>
            </ns2:items>
            <ns2:items code="at0.175">
                <ns2:items id="text">Pain</ns2:items>
                <ns2:items id="description">The symptom experienced is pain.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.176">
                <ns2:items id="text">Crushing</ns2:items>
                <ns2:items id="description">The pain has a crushing quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.177">
                <ns2:items id="text">Burning</ns2:items>
                <ns2:items id="description">The pain has a burning quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.178">
                <ns2:items id="text">Cramping</ns2:items>
                <ns2:items id="description">The pain has a cramping quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.179">
                <ns2:items id="text">Colicky</ns2:items>
                <ns2:items id="description">The pain has a colicky quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.180">
                <ns2:items id="text">Deep</ns2:items>
                <ns2:items id="description">The pain feels deep.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.181">
                <ns2:items id="text">Diffuse</ns2:items>
                <ns2:items id="description">The pain feels diffuse.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.182">
                <ns2:items id="text">Dull ache</ns2:items>
                <ns2:items id="description">The pain feels dull.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.183">
                <ns2:items id="text">Shooting</ns2:items>
                <ns2:items id="description">The pain has a shooting quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.184">
                <ns2:items id="text">Superficial</ns2:items>
                <ns2:items id="description">The pain feels superficial.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.185">
                <ns2:items id="text">Throbbing</ns2:items>
                <ns2:items id="description">The pain has a throbbing quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.186">
                <ns2:items id="text">Sharp</ns2:items>
                <ns2:items id="description">The pain feels sharp.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.187">
                <ns2:items id="text">Heavy</ns2:items>
                <ns2:items id="description">The pain has a heavy quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.188">
                <ns2:items id="text">Tearing</ns2:items>
                <ns2:items id="description">The pain has a tearing quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.189">
                <ns2:items id="text">Squeezing</ns2:items>
                <ns2:items id="description">The pain has a squeezing quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.190">
                <ns2:items id="text">Stabbing</ns2:items>
                <ns2:items id="description">The pain has a stabbing quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.191">
                <ns2:items id="text">Griping</ns2:items>
                <ns2:items id="description">The pain has a griping quality.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.192">
                <ns2:items id="text">Location</ns2:items>
                <ns2:items id="description">Details of location and radiation of pain.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.193">
                <ns2:items id="text">Radiation</ns2:items>
                <ns2:items id="description">Description of location to where the pain radiates.</ns2:items>
            </ns2:items>
            <ns2:items code="at0.194">
                <ns2:items id="text">Ocena</ns2:items>
                <ns2:items id="description">Nivo bolečine, lestvica od 0-10</ns2:items>
            </ns2:items>
            <ns2:items code="at0000">
                <ns2:items id="text">Symptom</ns2:items>
                <ns2:items id="description">A symptom experienced by the patient.</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1">
                <ns2:items id="text">Pain</ns2:items>
                <ns2:items id="description">Pain experienced by the patient.</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1.1">
                <ns2:items id="text">Bolečina</ns2:items>
                <ns2:items id="description">Bolečina - ocena pacienta </ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">Symptom name</ns2:items>
                <ns2:items id="description">The symptom experienced.</ns2:items>
            </ns2:items>
            <ns2:items code="at0001.1">
                <ns2:items id="text">Symptom name - pain</ns2:items>
                <ns2:items id="description">The symptom experienced.</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">Comments</ns2:items>
                <ns2:items id="description">Opis simptoma bolečine</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">Variation</ns2:items>
                <ns2:items id="description">The variation of the symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Continual</ns2:items>
                <ns2:items id="description">The symptom is constantly present.</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">Intermittent</ns2:items>
                <ns2:items id="description">The symptom is present at times and not at others.</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">Fluctuating</ns2:items>
                <ns2:items id="description">The symptom varys considerably but is almost always present.</ns2:items>
            </ns2:items>
            <ns2:items code="at0008">
                <ns2:items id="text">Onset</ns2:items>
                <ns2:items id="description">The nature of the onset of the symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0009">
                <ns2:items id="text">Gradual</ns2:items>
                <ns2:items id="description">Over a longer period of time.</ns2:items>
            </ns2:items>
            <ns2:items code="at0010">
                <ns2:items id="text">Sudden</ns2:items>
                <ns2:items id="description">Almost immediate.</ns2:items>
            </ns2:items>
            <ns2:items code="at0011">
                <ns2:items id="text">Cessation</ns2:items>
                <ns2:items id="description">The nature of the cessation of the symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0015">
                <ns2:items id="text">Associated factor</ns2:items>
                <ns2:items id="description">An event, activity or state that is associated with the symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0015.0.1">
                <ns2:items id="text">V stanju</ns2:items>
                <ns2:items id="description">V kakšnem stanju je pacient ob meritvi bolečine?</ns2:items>
            </ns2:items>
            <ns2:items code="at0017">
                <ns2:items id="text">Change</ns2:items>
                <ns2:items id="description">An event or activity that makes the symptom worse.</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">Exascerbating factor</ns2:items>
                <ns2:items id="description">Kaj bolečino ublaži?</ns2:items>
            </ns2:items>
            <ns2:items code="at0019">
                <ns2:items id="text">Factor</ns2:items>
                <ns2:items id="description">An event or activity that modifies the symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0020">
                <ns2:items id="text">Pain effects</ns2:items>
                <ns2:items id="description">Drugi simptome povezani z bolečino</ns2:items>
            </ns2:items>
            <ns2:items code="at0028">
                <ns2:items id="text">Duration</ns2:items>
                <ns2:items id="description">The duration of the symptom since onset.</ns2:items>
            </ns2:items>
            <ns2:items code="at0030">
                <ns2:items id="text">Time of maximum intensity</ns2:items>
                <ns2:items id="description">The time (and/or date) of maximum intensity of the symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0031">
                <ns2:items id="text">Number of occurrences</ns2:items>
                <ns2:items id="description">The number of times this symptom has occurred during this episode.</ns2:items>
            </ns2:items>
            <ns2:items code="at0032">
                <ns2:items id="text">Character</ns2:items>
                <ns2:items id="description">The characteristics of the symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0032.1">
                <ns2:items id="text">Character of pain</ns2:items>
                <ns2:items id="description">The characteristics of the pain.</ns2:items>
            </ns2:items>
            <ns2:items code="at0032.1.1">
                <ns2:items id="text">Značilnost bolečine</ns2:items>
                <ns2:items id="description">Značilnost boečine</ns2:items>
            </ns2:items>
            <ns2:items code="at0033">
                <ns2:items id="text">Clinical course</ns2:items>
                <ns2:items id="description">Features of the course of the symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0035">
                <ns2:items id="text">Nil significant</ns2:items>
                <ns2:items id="description">The person has not had any significant experience of the symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0036">
                <ns2:items id="text">Rapid</ns2:items>
                <ns2:items id="description">Over a short period of time.</ns2:items>
            </ns2:items>
            <ns2:items code="at0037">
                <ns2:items id="text">Progression</ns2:items>
                <ns2:items id="description">The progress of the symptom relative to the past.</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">Improving</ns2:items>
                <ns2:items id="description">The symptom has improved over time.</ns2:items>
            </ns2:items>
            <ns2:items code="at0039">
                <ns2:items id="text">Decreasing</ns2:items>
                <ns2:items id="description">The symptom is decreasing in intensity over time.</ns2:items>
            </ns2:items>
            <ns2:items code="at0040">
                <ns2:items id="text">Stable</ns2:items>
                <ns2:items id="description">The symptom has not changed over time.</ns2:items>
            </ns2:items>
            <ns2:items code="at0041">
                <ns2:items id="text">Increasing</ns2:items>
                <ns2:items id="description">The symptom is increasing in intensity over time.</ns2:items>
            </ns2:items>
            <ns2:items code="at0042">
                <ns2:items id="text">Worsening</ns2:items>
                <ns2:items id="description">The symptom is getting worse over time.</ns2:items>
            </ns2:items>
            <ns2:items code="at0043">
                <ns2:items id="text">Has resolved</ns2:items>
                <ns2:items id="description">The symptom has resolved over time.</ns2:items>
            </ns2:items>
            <ns2:items code="at0046">
                <ns2:items id="text">Observed current intensity</ns2:items>
                <ns2:items id="description">Jakost bolečine v časovnem intervalu</ns2:items>
            </ns2:items>
            <ns2:items code="at0048">
                <ns2:items id="text">Relieved completely</ns2:items>
                <ns2:items id="description">The symptom is relieved by this factor.</ns2:items>
            </ns2:items>
            <ns2:items code="at0049">
                <ns2:items id="text">Made better</ns2:items>
                <ns2:items id="description">The symptom is made better by this factor.</ns2:items>
            </ns2:items>
            <ns2:items code="at0050">
                <ns2:items id="text">Somewhat improved</ns2:items>
                <ns2:items id="description">The symptom is somewhat improved by this factor.</ns2:items>
            </ns2:items>
            <ns2:items code="at0051">
                <ns2:items id="text">No change</ns2:items>
                <ns2:items id="description">The symptom is not modified by this factor.</ns2:items>
            </ns2:items>
            <ns2:items code="at0052">
                <ns2:items id="text">Somewhat worse</ns2:items>
                <ns2:items id="description">The symptom is made somewhat worse by this factor.</ns2:items>
            </ns2:items>
            <ns2:items code="at0053">
                <ns2:items id="text">Made worse</ns2:items>
                <ns2:items id="description">The symptom is made worse by this factor.</ns2:items>
            </ns2:items>
            <ns2:items code="at0054">
                <ns2:items id="text">Much worse</ns2:items>
                <ns2:items id="description">The symptom is made much worse by this factor.</ns2:items>
            </ns2:items>
            <ns2:items code="at0056">
                <ns2:items id="text">Description</ns2:items>
                <ns2:items id="description">Details of the effect.</ns2:items>
            </ns2:items>
            <ns2:items code="at0057">
                <ns2:items id="text">Description</ns2:items>
                <ns2:items id="description">Details of previous symptoms and comparison to this episode.</ns2:items>
            </ns2:items>
            <ns2:items code="at0058">
                <ns2:items id="text">Previous episodes</ns2:items>
                <ns2:items id="description">Details about previous episodes.</ns2:items>
            </ns2:items>
            <ns2:items code="at0059">
                <ns2:items id="text">Any previous episodes</ns2:items>
                <ns2:items id="description">Have there been any previous episodes of this symptom?</ns2:items>
            </ns2:items>
            <ns2:items code="at0060">
                <ns2:items id="text">Description</ns2:items>
                <ns2:items id="description">Text description of the course of the symptom over time.</ns2:items>
            </ns2:items>
            <ns2:items code="at0062">
                <ns2:items id="text">Absent expected feature</ns2:items>
                <ns2:items id="description">A feature which would normally be expected but which is not present.</ns2:items>
            </ns2:items>
            <ns2:items code="at0063">
                <ns2:items id="text">Associated symptom detail</ns2:items>
                <ns2:items id="description">Associated symptoms.</ns2:items>
            </ns2:items>
            <ns2:items code="at0090">
                <ns2:items id="text">Previous episode</ns2:items>
                <ns2:items id="description">Details about a specific episode.</ns2:items>
            </ns2:items>
            <ns2:items code="at0098">
                <ns2:items id="text">Number of previous episodes</ns2:items>
                <ns2:items id="description">Number of previous episodes.</ns2:items>
            </ns2:items>
            <ns2:items code="at0142">
                <ns2:items id="text">Date / time of previous episode</ns2:items>
                <ns2:items id="description">Date/time of previous episode.</ns2:items>
            </ns2:items>
            <ns2:items code="at0143">
                <ns2:items id="text">Comparison</ns2:items>
                <ns2:items id="description">How the previous episode compares with this one.</ns2:items>
            </ns2:items>
            <ns2:items code="at0146">
                <ns2:items id="text">Detail</ns2:items>
                <ns2:items id="description">Structured details of symptoms in previous episodes.</ns2:items>
            </ns2:items>
            <ns2:items code="at0147">
                <ns2:items id="text">Location in body</ns2:items>
                <ns2:items id="description">Details of locations in the body.</ns2:items>
            </ns2:items>
            <ns2:items code="at0152">
                <ns2:items id="text">Record of previous episode</ns2:items>
                <ns2:items id="description">Link to a previous record of this symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0154">
                <ns2:items id="text">Course</ns2:items>
                <ns2:items id="description">The overall clinical course.</ns2:items>
            </ns2:items>
            <ns2:items code="at0155">
                <ns2:items id="text">Acute</ns2:items>
                <ns2:items id="description">Short-lived and/or rapid onset of symptoms.</ns2:items>
            </ns2:items>
            <ns2:items code="at0156">
                <ns2:items id="text">Chronic</ns2:items>
                <ns2:items id="description">Long-standing symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0157">
                <ns2:items id="text">Chonic relapsing</ns2:items>
                <ns2:items id="description">Long-standing symptom with regular exacerbations.</ns2:items>
            </ns2:items>
            <ns2:items code="at0158">
                <ns2:items id="text">Acute-on-chronic</ns2:items>
                <ns2:items id="description">Acute episode on background of lon-standing symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0160">
                <ns2:items id="text">Scale detail</ns2:items>
                <ns2:items id="description">Detail of symptom formal scoring methods and results.</ns2:items>
            </ns2:items>
            <ns2:items code="at0161">
                <ns2:items id="text">Description</ns2:items>
                <ns2:items id="description">A text description of the symptom intensity.</ns2:items>
            </ns2:items>
            <ns2:items code="at0162">
                <ns2:items id="text">Cyclical</ns2:items>
                <ns2:items id="description">The symptom is present on a cyclical basis.</ns2:items>
            </ns2:items>
            <ns2:items code="at0163">
                <ns2:items id="text">Seasonal</ns2:items>
                <ns2:items id="description">The sympton is present on a seasonal basis.</ns2:items>
            </ns2:items>
            <ns2:items code="at0164">
                <ns2:items id="text">Fluctuating</ns2:items>
                <ns2:items id="description">The symptom presence or intensity fluctuates.</ns2:items>
            </ns2:items>
            <ns2:items code="at0165">
                <ns2:items id="text">Paroxysmal</ns2:items>
                <ns2:items id="description">The symptom appears suddenly and dramatically.</ns2:items>
            </ns2:items>
            <ns2:items code="at0166">
                <ns2:items id="text">Degree</ns2:items>
                <ns2:items id="description">The degree to which the symptom is bothering the patient.</ns2:items>
            </ns2:items>
            <ns2:items code="at0166.0.1">
                <ns2:items id="text">Stopnja bolečine po lestvici VAS</ns2:items>
                <ns2:items id="description">Ocena stopnje bolečine po lestvici VAS. </ns2:items>
            </ns2:items>
            <ns2:items code="at0167">
                <ns2:items id="text">Associated symptom</ns2:items>
                <ns2:items id="description">Any associated symptom.</ns2:items>
            </ns2:items>
            <ns2:items code="at0167.0.1">
                <ns2:items id="text">Vpliva na</ns2:items>
                <ns2:items id="description">Vpliv simptoma</ns2:items>
            </ns2:items>
            <ns2:items code="at0168">
                <ns2:items id="text">Not present</ns2:items>
                <ns2:items id="description">The symptom is not present.</ns2:items>
            </ns2:items>
            <ns2:items code="at0169">
                <ns2:items id="text">Trivial</ns2:items>
                <ns2:items id="description">The symptom is trivial and causes no problems.</ns2:items>
            </ns2:items>
            <ns2:items code="at0170">
                <ns2:items id="text">Mild</ns2:items>
                <ns2:items id="description">The symptom does not interfere greatly with day to day activities.</ns2:items>
            </ns2:items>
            <ns2:items code="at0171">
                <ns2:items id="text">Moderate</ns2:items>
                <ns2:items id="description">The symptom interferes with day to day activities.</ns2:items>
            </ns2:items>
            <ns2:items code="at0172">
                <ns2:items id="text">Severe</ns2:items>
                <ns2:items id="description">The symptom prohibits some key daily activities.</ns2:items>
            </ns2:items>
            <ns2:items code="at0173">
                <ns2:items id="text">Very severe</ns2:items>
                <ns2:items id="description">The symptom is almost maximum possible intensity and prohibits any activity.</ns2:items>
            </ns2:items>
            <ns2:items code="at0174">
                <ns2:items id="text">Maximal</ns2:items>
                <ns2:items id="description">The symptom is as bad as it can be.</ns2:items>
            </ns2:items>
            <ns2:items code="at0175">
                <ns2:items id="text">Degree / level</ns2:items>
                <ns2:items id="description">Ocena jakosti simptoma z lestvico od 0-10</ns2:items>
            </ns2:items>
            <ns2:items code="at0176">
                <ns2:items id="text">Scale name</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0176.0.1">
                <ns2:items id="text">Ocenjevalna lestvica</ns2:items>
                <ns2:items id="description">Metoda, ki jo uporablja lestvica</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
