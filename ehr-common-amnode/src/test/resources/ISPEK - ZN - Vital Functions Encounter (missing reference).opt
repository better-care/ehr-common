            <ns2:items code="at0070">
                <ns2:items id="text">*CPAP (PS/CPAP)(en)</ns2:items>
                <ns2:items id="description">*Pressure support / Continous positive airway pressure.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0071">
                <ns2:items id="text">*BILEVEL CPAP(en)</ns2:items>
                <ns2:items id="description">*Bilevel CPAP.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0072">
                <ns2:items id="text">*CMV (CV)(en)</ns2:items>
                <ns2:items id="description">*Controlled mandatory ventilation or Controlled ventilation&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0073">
                <ns2:items id="text">*HFOV(en)</ns2:items>
                <ns2:items id="description">* High frequency oscillation ventilation.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0074">
                <ns2:items id="text">*HFO CMV(en)</ns2:items>
                <ns2:items id="description">*High frequency oscillation + Controlled mechanical ventilation.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0075">
                <ns2:items id="text">*PTV(en)</ns2:items>
                <ns2:items id="description">*Patient triggered ventilation.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0076">
                <ns2:items id="text">*IPPV(en)</ns2:items>
                <ns2:items id="description">*Intermittent positive pressure ventilation.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0077">
                <ns2:items id="text">*MMV(en)</ns2:items>
                <ns2:items id="description">*Mandatory minute ventilation.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0078">
                <ns2:items id="text">*SIMV ASB(en)</ns2:items>
                <ns2:items id="description">*Synchronised intermittent mandatory ventilation + Assisted spontaneous breathing.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0079">
                <ns2:items id="text">*BiPAP(en)</ns2:items>
                <ns2:items id="description">*Biphasic positive airway pressure.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0080">
                <ns2:items id="text">*PSV (en)</ns2:items>
                <ns2:items id="description">*Pressure support ventilation.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0081">
                <ns2:items id="text">*BiPAP ASB(en)</ns2:items>
                <ns2:items id="description">*Biphasic positive airway pressure + Assisted spontaneous breathing.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0082">
                <ns2:items id="text">*PSV ST(en)</ns2:items>
                <ns2:items id="description">*Pressure support ventilation with spontaneous timed mode.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0083">
                <ns2:items id="text">*PCV(en)</ns2:items>
                <ns2:items id="description">*Pressure controlled ventilation.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0084">
                <ns2:items id="text">*S/ T(en)</ns2:items>
                <ns2:items id="description">*Spontaneous timed breathing.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0085">
                <ns2:items id="text">*PAV / T(en)</ns2:items>
                <ns2:items id="description">*Proportional assist ventilation/Time.&#13;(en)</ns2:items>
            </ns2:items>
            <ns2:items code="[ppb]">
                <ns2:items id="text">ppb</ns2:items>
                <ns2:items id="description">parts per billion</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-CLUSTER.device.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Naprava</ns2:items>
                <ns2:items id="description">Uporablja se za zapisovanje podatkov o napravi, ki se lahko uporablja neposredno v terapevtske ali diagnostične namene; ali neposredno v zagotavljanju zdravstvene oskrbe.</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">ID</ns2:items>
                <ns2:items id="description">ID naprave </ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">Opis</ns2:items>
                <ns2:items id="description">Opis naprave</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">Tip</ns2:items>
                <ns2:items id="description">Tip naprave</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Proizvajalec</ns2:items>
                <ns2:items id="description">Proizvajalec naprave</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">Datum proizvodnje</ns2:items>
                <ns2:items id="description">Datum proizvodnje</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">Serijska številka</ns2:items>
                <ns2:items id="description">Serijska številka naprave</ns2:items>
            </ns2:items>
            <ns2:items code="at0007">
                <ns2:items id="text">Rok trajanja</ns2:items>
                <ns2:items id="description">Rok trajanja naprave / izdelka</ns2:items>
            </ns2:items>
            <ns2:items code="at0008">
                <ns2:items id="text">Opomba</ns2:items>
                <ns2:items id="description">Opombe glede naprave</ns2:items>
            </ns2:items>
            <ns2:items code="at0009">
                <ns2:items id="text">Dodatne podrobnosti</ns2:items>
                <ns2:items id="description">Dodatna pojasnila</ns2:items>
            </ns2:items>
            <ns2:items code="at0013">
                <ns2:items id="text">Varnostna navodila</ns2:items>
                <ns2:items id="description">Varnostna navodila </ns2:items>
            </ns2:items>
            <ns2:items code="at0014">
                <ns2:items id="text">Tip navodil</ns2:items>
                <ns2:items id="description">Tip varnostnih navodil</ns2:items>
            </ns2:items>
            <ns2:items code="at0015">
                <ns2:items id="text">Opis</ns2:items>
                <ns2:items id="description">Opis varnostnih navodil</ns2:items>
            </ns2:items>
            <ns2:items code="at0016">
                <ns2:items id="text">Velikost</ns2:items>
                <ns2:items id="description">Velikost naprave</ns2:items>
            </ns2:items>
            <ns2:items code="at0017">
                <ns2:items id="text">Dimenzija</ns2:items>
                <ns2:items id="description">Podrobne dimenzije naprave</ns2:items>
            </ns2:items>
            <ns2:items code="at0020">
                <ns2:items id="text">Sestavni deli</ns2:items>
                <ns2:items id="description">*Information about the device sub-components.(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-CLUSTER.nursing_process_action_zn.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Aktivnost v zdarvstveni negi</ns2:items>
                <ns2:items id="description">Infrastruktura za beleženje aktivnosti izvedenih v procesu zdravstvene nege ( "nursing ACTION archetypes")</ns2:items>
            </ns2:items>
            <ns2:items code="at0009">
                <ns2:items id="text">Uporabljni material</ns2:items>
                <ns2:items id="description">Podatki o uporabljenem materialu</ns2:items>
            </ns2:items>
            <ns2:items code="at0010">
                <ns2:items id="text">Naziv materiala</ns2:items>
                <ns2:items id="description">Naziv materiala</ns2:items>
            </ns2:items>
            <ns2:items code="at0012">
                <ns2:items id="text">Količina</ns2:items>
                <ns2:items id="description">Količina uporabljenega materiala </ns2:items>
            </ns2:items>
            <ns2:items code="at0019">
                <ns2:items id="text">Obvesti</ns2:items>
                <ns2:items id="description">Ime oseb, ki jih je potrebno obvestiti o izvedeni aktivnosti</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-CLUSTER.distribution.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Obveščanje</ns2:items>
                <ns2:items id="description">Seznam prejemnikov - skupina posameznikov, ki so naslovniki sporočila</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">Način komunikacija</ns2:items>
                <ns2:items id="description">Način obveščanja</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">Datum odpošiljanja</ns2:items>
                <ns2:items id="description">Datum obveščanja - distribuiranja sporočila</ns2:items>
            </ns2:items>
            <ns2:items code="at0007">
                <ns2:items id="text">Podrobnosti o prejemniku</ns2:items>
                <ns2:items id="description">Posameznik ali organizacija, na koga je naslovljeno sporočilo</ns2:items>
            </ns2:items>
            <ns2:items code="at0008">
                <ns2:items id="text">Skupina</ns2:items>
                <ns2:items id="description">Ime skupine prejemnikov, npr. 'zdravniki predstojniki oddelkov'</ns2:items>
            </ns2:items>
            <ns2:items code="at0010">
                <ns2:items id="text">ID prejemnika</ns2:items>
                <ns2:items id="description">Unikatni identifikator posameznika (primarni ključ, ki določa posameznika)</ns2:items>
            </ns2:items>
            <ns2:items code="at0011">
                <ns2:items id="text">Posamezni prejemnik</ns2:items>
                <ns2:items id="description">Podatki o posameznem prejemniku</ns2:items>
            </ns2:items>
            <ns2:items code="at0012">
                <ns2:items id="text">Nujno</ns2:items>
                <ns2:items id="description">Če potrebna nujna obravnava?</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.exam.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">*Examination Findings(en)</ns2:items>
                <ns2:items id="description">*Findings observed during the physical examination of a subject.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Event Series(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">*Any event(en)</ns2:items>
                <ns2:items id="description">*Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="comment">*May be used to record a narrative summary of the complete clinical examination or key aspects of clinical examination findings, which will be supported by structured data. Details of specific structured findings can be included using CLUSTER archetypes in the 'Examination Detail' slot. This data element may be used to capture legacy data that is not available in a structured format.(en)</ns2:items>
                <ns2:items id="text">Klinični opis</ns2:items>
                <ns2:items id="description">Beleženje ugotovljenih dejstev pri pregledu</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">Podrobno</ns2:items>
                <ns2:items id="description">Podatki o fizikalnem pregledu</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="comment">*Coding with a terminology is preferred, if possible. For example, normal examination or chronic otitis media.(en)</ns2:items>
                <ns2:items id="text">*Interpretation(en)</ns2:items>
                <ns2:items id="description">*Single word, phrase or brief description represents the clinical meaning and significance of the physical examination findings.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0007">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0008">
                <ns2:items id="text">*Confounding Factors(en)</ns2:items>
                <ns2:items id="description">*Description of any incidental factors that may have contributed to the physical examination findings.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0009">
                <ns2:items id="text">*Tree(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0010">
                <ns2:items id="text">*Device Details(en)</ns2:items>
                <ns2:items id="description">*Details about any device used during the physical examination.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0011">
                <ns2:items id="text">*Comment(en)</ns2:items>
                <ns2:items id="description">*Any additional narrative comment not covered by other elements.(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.body_temperature-zn.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0.60">
                <ns2:items id="text">Notranja stran ličnice</ns2:items>
                <ns2:items id="description">Merjenje telesne temperature v ustni sluznici</ns2:items>
            </ns2:items>
            <ns2:items code="at0.61">
                <ns2:items id="text">Pod jezikom</ns2:items>
                <ns2:items id="description">Merjenje telesne temperature pod jezikom</ns2:items>
            </ns2:items>
            <ns2:items code="at0.62">
                <ns2:items id="text">Drugo</ns2:items>
                <ns2:items id="description">Merjenje telesne temperature na način, ki ni naveden</ns2:items>
            </ns2:items>
            <ns2:items code="at0.63">
                <ns2:items id="text">Ugotovitve</ns2:items>
                <ns2:items id="description">Znaki neobičajne telesne temperature</ns2:items>
            </ns2:items>
            <ns2:items code="at0.64">
                <ns2:items id="text">Mrazenje/mrzlica</ns2:items>
                <ns2:items id="description">Prisotnost mrzlice ali mrazenja </ns2:items>
            </ns2:items>
            <ns2:items code="at0.65">
                <ns2:items id="text">Kurja polt</ns2:items>
                <ns2:items id="description">Prisotnost kurje polti</ns2:items>
            </ns2:items>
            <ns2:items code="at0000">
                <ns2:items id="text">Telesna temperatura</ns2:items>
                <ns2:items id="description">*A measurement of the body temperature, which is a surrogate for the whole body temperature of the person.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0000.1">
                <ns2:items id="text">Telesna temperatura</ns2:items>
                <ns2:items id="description">Merjenje telesne temperature, ki se lahko nanaša na celotno telo pacieta</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">Single</ns2:items>
                <ns2:items id="description">**(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">History</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">Any event</ns2:items>
                <ns2:items id="description">*Any event(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Telesna temperatura</ns2:items>
                <ns2:items id="description">*The measured body temperature (as a surrogate for the whole body)(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0020">
                <ns2:items id="text">Protocol</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0021">
                <ns2:items id="text">Stran telesa</ns2:items>
                <ns2:items id="description">*The anatomical site of measurement of the temperature(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0021.1">
                <ns2:items id="text">Lokacija</ns2:items>
                <ns2:items id="description">Natančna lokacija meritve</ns2:items>
            </ns2:items>
            <ns2:items code="at0022">
                <ns2:items id="text">Usta</ns2:items>
                <ns2:items id="description">*Temperature is measured within the mouth(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0023">
                <ns2:items id="text">V ušesu</ns2:items>
                <ns2:items id="description">*Temperature is measured from within the external auditory canal(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0024">
                <ns2:items id="text">Pod pazduho</ns2:items>
                <ns2:items id="description">*Temperature is measured from the skin of the axilla with the arm positioned down by the side(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0025">
                <ns2:items id="text">Rektalno</ns2:items>
                <ns2:items id="description">*Temperature measured within the rectum(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0026">
                <ns2:items id="text">Nazofarinks</ns2:items>
                <ns2:items id="description">*Temperature is measured within the nasopharynx(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0027">
                <ns2:items id="text">Sečni mehur</ns2:items>
                <ns2:items id="description">*Temperature is measured in the urinary bladder(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0028">
                <ns2:items id="text">Intravaskularno</ns2:items>
                <ns2:items id="description">*Temperature is measured within the vascular system(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0029">
                <ns2:items id="text">Stanje</ns2:items>
                <ns2:items id="description">*State information about the patient(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0030">
                <ns2:items id="text">Obleka</ns2:items>
                <ns2:items id="description">*The thermal situation of the person who is having the temperature taken(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0031">
                <ns2:items id="text">Gol</ns2:items>
                <ns2:items id="description">*No clothing, bedding or covering(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0032">
                <ns2:items id="text">Premalo oblečen (zavit)</ns2:items>
                <ns2:items id="description">*The person is covered by a lesser amount of clothing or bedding than deemed appropriate for the environmental circumstances(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0033">
                <ns2:items id="text">Primerno oblečen (zavit)</ns2:items>
                <ns2:items id="description">*The person is covered by an amount of clothing or bedding deemed appropriate for the environmental circumstances(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0034">
                <ns2:items id="text">Preveč oblečen (zavit)</ns2:items>
                <ns2:items id="description">*The person is covered by an increased amount of clothing or bedding than deemed appropriate for the environmental circumstances(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0041">
                <ns2:items id="text">Opis</ns2:items>
                <ns2:items id="description">*Description of the conditions applied to the subject that might influence their measured body temperature.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0043">
                <ns2:items id="text">Na koži</ns2:items>
                <ns2:items id="description">*Temperature is measured from exposed skin(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0051">
                <ns2:items id="text">Vaginalno</ns2:items>
                <ns2:items id="description">*Temperature is measured within the vagina(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0054">
                <ns2:items id="text">V požiralniku</ns2:items>
                <ns2:items id="description">*Temperatue is measured within the oesophagus(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0055">
                <ns2:items id="text">V ustih</ns2:items>
                <ns2:items id="description">*Temperature is measured in the inguinal skin crease between the leg and abdominal wall(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0056">
                <ns2:items id="text">Ambient</ns2:items>
                <ns2:items id="description">*Details about the environmental conditions at the time of temperature measurement(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0057">
                <ns2:items id="text">Napor</ns2:items>
                <ns2:items id="description">*Details about the exertion of the person at the time of temperature measurement(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0058">
                <ns2:items id="text">Menstrualni cikel</ns2:items>
                <ns2:items id="description">*Details about the menstrual cycle of a woman(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0059">
                <ns2:items id="text">Naprava</ns2:items>
                <ns2:items id="description">*Details about the device use to measure body temperature(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.body_weight.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Telesna teža</ns2:items>
                <ns2:items id="description">Merjenje telesne teže posameznega pacienta</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Simple(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">*history(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">*Any event(en)</ns2:items>
