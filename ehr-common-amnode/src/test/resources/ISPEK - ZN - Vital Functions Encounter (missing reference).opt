                            <ns2:items id="description">Eyelids are symmetrical when closed</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0037">
                            <ns2:items id="text">No</ns2:items>
                            <ns2:items id="description">The eyelids are not syymetrical when closed.</ns2:items>
                        </ns2:term_definitions>
