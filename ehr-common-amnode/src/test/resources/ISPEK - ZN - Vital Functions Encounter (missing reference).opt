                        <ns2:archetype_id>
                            <ns2:value>openEHR-EHR-OBSERVATION.glasgow_coma-paed.v1</ns2:value>
                        </ns2:archetype_id>
                        <ns2:term_definitions code="at0.41">
                            <ns2:items id="text">Best motor response - infant (M)</ns2:items>
                            <ns2:items id="description">Best motor response to stumulus in infant less than 2 years old.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.42">
                            <ns2:items id="text">No response</ns2:items>
                            <ns2:items id="description">No motor response; limbs flaccid.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.43">
                            <ns2:items id="text">Extensor response</ns2:items>
                            <ns2:items id="description">Abnormal extension to pain.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.44">
                            <ns2:items id="text">Flexor response</ns2:items>
                            <ns2:items id="description">Abnormal flexion to pain.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.45">
                            <ns2:items id="text">Withdrawal response</ns2:items>
                            <ns2:items id="description">Withdraws in response to painful stimulus.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.46">
                            <ns2:items id="text">Withdraws to touch</ns2:items>
                            <ns2:items id="description">Withdraws in response to touch.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.47">
                            <ns2:items id="text">Moves spontaneously</ns2:items>
                            <ns2:items id="description">Moves spontaneously and purposefully.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.48">
                            <ns2:items id="text">Best verbal response - child (V)</ns2:items>
                            <ns2:items id="description">Best verbal response to stimulus in a child older than 2 years.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.49">
                            <ns2:items id="text">Best verbal response - infant (V)</ns2:items>
                            <ns2:items id="description">Best verbal response to stimulus in a infant younger than 2 years.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.50">
                            <ns2:items id="text">No response</ns2:items>
                            <ns2:items id="description">No verbal response.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.51">
                            <ns2:items id="text">Incomprehensible words or nonspecific sounds</ns2:items>
                            <ns2:items id="description">Moans or groans, but no recognisable words.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.52">
                            <ns2:items id="text">Inappropriate words</ns2:items>
                            <ns2:items id="description">Intelligible speech, but inappropriate words.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.53">
                            <ns2:items id="text">Confused</ns2:items>
                            <ns2:items id="description">Converses, but confused and disoriented in their environment.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.54">
                            <ns2:items id="text">Oriented, appropriate</ns2:items>
                            <ns2:items id="description">Converses, oriented to their environment.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.55">
                            <ns2:items id="text">No response</ns2:items>
                            <ns2:items id="description">No verbal response.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.56">
                            <ns2:items id="text">Moans</ns2:items>
                            <ns2:items id="description">Occasionally whimpers or moans.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.57">
                            <ns2:items id="text">Cries</ns2:items>
                            <ns2:items id="description">Cries inappropriately.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.58">
                            <ns2:items id="text">Irritable cries</ns2:items>
                            <ns2:items id="description">Less than usual ability or spontaneous irritable cry.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.59">
                            <ns2:items id="text">Coos and babbles</ns2:items>
                            <ns2:items id="description">The infant is alert babbles, coos or says words or sentences to&#13;
their usual ability.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.60">
                            <ns2:items id="text">Best grimace response (G)</ns2:items>
                            <ns2:items id="description">Best grimace response in response to pain. May be used instead of verbal response for intubated patients.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.61">
                            <ns2:items id="text">No response</ns2:items>
                            <ns2:items id="description">No grimace response to pain.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.62">
                            <ns2:items id="text">Mild grimace</ns2:items>
                            <ns2:items id="description">Mild grimace or some change in facial expression to pain.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.63">
                            <ns2:items id="text">Vigorous grimace</ns2:items>
                            <ns2:items id="description">Vigorous grimace to pain.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.64">
                            <ns2:items id="text">Less than usual spontaneous activity</ns2:items>
                            <ns2:items id="description">Less than usual spontaneous ability or only responds to touch.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.65">
                            <ns2:items id="text">Normal spontaneous facial/oro-motor activity</ns2:items>
                            <ns2:items id="description">Spontaneous normal facial/oromotor activity.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000.1">
                            <ns2:items id="text">Glasgow Coma Scale</ns2:items>
                            <ns2:items id="description">Fifteen point scale used to assess the level of consciousness of a child subject. Also known as the Modified Glasgow Coma Scale for Infants and Children. </ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">Any event</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0007.1">
                            <ns2:items id="text">Best verbal response - adult (V)</ns2:items>
                            <ns2:items id="description">Best verbal response to stimulus in an adult.   </ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0008.1">
                            <ns2:items id="text">Best motor response (M)</ns2:items>
                            <ns2:items id="description">Best motor response to stimulus in child over 2 years old.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Glasgow Coma Scale</ns2:items>
                            <ns2:items id="description">Fifteen point scale used to assess the level of consciousness of a subject. Also known as the Modified Glasgow Coma Scale.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Event Series</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0007">
                            <ns2:items id="text">Best verbal response (V)</ns2:items>
                            <ns2:items id="description">Best verbal response to stimulus.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0008">
                            <ns2:items id="text">Best motor response (M)</ns2:items>
                            <ns2:items id="description">Best motor response to stimulus.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0009">
                            <ns2:items id="text">Best eye response (E)</ns2:items>
                            <ns2:items id="description">Best eye response to stimulus.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0010">
                            <ns2:items id="text">No response</ns2:items>
                            <ns2:items id="description">Does not open eyes.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0011">
                            <ns2:items id="text">Eyes open in response to pain</ns2:items>
                            <ns2:items id="description">Opens eyes in response to painful stimuli in limbs.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0012">
                            <ns2:items id="text">Eyes open in response to speech</ns2:items>
                            <ns2:items id="description">Opens eyes in response to any verbal approach.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0013">
                            <ns2:items id="text">Spontaneous eye opening</ns2:items>
                            <ns2:items id="description">Opens eyes spontaneously.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0014">
                            <ns2:items id="text">No response</ns2:items>
                            <ns2:items id="description">No verbal response.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0015">
                            <ns2:items id="text">Incomprehensible sounds</ns2:items>
                            <ns2:items id="description">Moans or groans, but no recognisable words.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0016">
                            <ns2:items id="text">Inappropriate speech</ns2:items>
                            <ns2:items id="description">Intelligible speech, but no conversational exchange.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0017">
                            <ns2:items id="text">Confused conversation</ns2:items>
                            <ns2:items id="description">Converses, but confused and disoriented in their environment.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0018">
                            <ns2:items id="text">Oriented</ns2:items>
                            <ns2:items id="description">Converses, oriented to their environment.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0019">
                            <ns2:items id="text">No response</ns2:items>
                            <ns2:items id="description">No motor response; limbs flaccid.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0020">
                            <ns2:items id="text">Extensor response</ns2:items>
                            <ns2:items id="description">Abnormal extension to pain.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0021">
                            <ns2:items id="text">Flexor response</ns2:items>
                            <ns2:items id="description">Abnormal flexion to pain.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0022">
                            <ns2:items id="text">Withdrawal response</ns2:items>
                            <ns2:items id="description">Flexion withdrawal response to pain.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0023">
                            <ns2:items id="text">Localises pain</ns2:items>
                            <ns2:items id="description">Localised movement in response to pain.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0024">
                            <ns2:items id="text">Obeys commands</ns2:items>
                            <ns2:items id="description">Follows simple verbal commands.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0026">
                            <ns2:items id="text">Total score</ns2:items>
                            <ns2:items id="description">The sum of the 3 ordinal scores for each component parameter.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0030">
                            <ns2:items id="text">EMV profile</ns2:items>
                            <ns2:items id="description">Eye Motor Verbal profile expressing each component individually. This can be derived as a combination of the preceding elements.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0034">
                            <ns2:items id="text">Not able to test eye response</ns2:items>
                            <ns2:items id="description">Not possible to test eye responses - for example in the case of associated severe facial/eye swelling or damage.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0035">
                            <ns2:items id="text">Not able to test verbal response</ns2:items>
                            <ns2:items id="description">Not possible to test verbal responses - for example in the case of associated intubation.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0036">
                            <ns2:items id="text">Not able to test motor response</ns2:items>
                            <ns2:items id="description">Not possible to test motor responses - for example in the case of associated limb paralysis.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0037">
                            <ns2:items id="text">Comment</ns2:items>
                            <ns2:items id="description">Comment about measurement of the Scale, especially if it was not possible to assess a response.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0038">
                            <ns2:items id="text">Reason for inability to test eye response</ns2:items>
                            <ns2:items id="description">Reason for inability to test eye response.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0039">
                            <ns2:items id="text">Reason for inability to test verbal response</ns2:items>
                            <ns2:items id="description">Reason for inability to test verbal response.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0040">
                            <ns2:items id="text">Reason for inability to test motor response</ns2:items>
                            <ns2:items id="description">Reason for inability to test motor response.</ns2:items>
                        </ns2:term_definitions>
                    </ns2:children>
