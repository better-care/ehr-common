                                                        <ns2:term_definitions code="at0169">
                                                            <ns2:items id="text">Trivial</ns2:items>
                                                            <ns2:items id="description">The symptom is trivial and causes no problems.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0170">
                                                            <ns2:items id="text">Mild</ns2:items>
                                                            <ns2:items id="description">The symptom does not interfere greatly with day to day activities.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0171">
                                                            <ns2:items id="text">Moderate</ns2:items>
                                                            <ns2:items id="description">The symptom interferes with day to day activities.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0172">
                                                            <ns2:items id="text">Severe</ns2:items>
                                                            <ns2:items id="description">The symptom prohibits some key daily activities.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0173">
                                                            <ns2:items id="text">Very severe</ns2:items>
                                                            <ns2:items id="description">The symptom is almost maximum possible intensity and prohibits any activity.</ns2:items>
                                                        </ns2:term_definitions>
