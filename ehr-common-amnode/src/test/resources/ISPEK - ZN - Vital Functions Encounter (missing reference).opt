                                                        <ns2:term_definitions code="at0000">
                                                            <ns2:items id="text">Hydration</ns2:items>
                                                            <ns2:items id="description">Clinical findings related to the fluid balance of the body.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0001">
                                                            <ns2:items id="text">Normal statements</ns2:items>
                                                            <ns2:items id="description">General statements of normaility with respect to hyrdation.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0003">
                                                            <ns2:items id="text">Clinical description</ns2:items>
                                                            <ns2:items id="description">A text description of the subject's hydration status.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0004">
                                                            <ns2:items id="text">Mucous membranes</ns2:items>
                                                            <ns2:items id="description">Finding of state of mucous membranes including mouth and lips.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0005">
                                                            <ns2:items id="text">Anterior fontanelle</ns2:items>
                                                            <ns2:items id="description">Describing state of infant's anteroir fontanelle.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0006">
                                                            <ns2:items id="text">Dry</ns2:items>
                                                            <ns2:items id="description">The mucous membranes are dry.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0007">
                                                            <ns2:items id="text">Moist</ns2:items>
                                                            <ns2:items id="description">The mucous membranes are moist.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0008">
                                                            <ns2:items id="text">Raised</ns2:items>
                                                            <ns2:items id="description">The anterior fontanelle is raised.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0009">
                                                            <ns2:items id="text">Normal</ns2:items>
                                                            <ns2:items id="description">The anterior fontanelle is normal.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0010">
                                                            <ns2:items id="text">Flat</ns2:items>
                                                            <ns2:items id="description">The anterior fontanelle is flat.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0011">
                                                            <ns2:items id="text">Sunken</ns2:items>
                                                            <ns2:items id="description">The anterior fontanelle is sunken.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0015">
                                                            <ns2:items id="text">Turgour</ns2:items>
                                                            <ns2:items id="description">Describing state of skin/tissue turgor. </ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0016">
                                                            <ns2:items id="text">Normal</ns2:items>
                                                            <ns2:items id="description">Skin turgor is normal.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0017">
                                                            <ns2:items id="text">Decreased</ns2:items>
                                                            <ns2:items id="description">Skin turgor is decreased.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0018">
                                                            <ns2:items id="text">Appearance of eyes</ns2:items>
                                                            <ns2:items id="description">Describes state of eyes.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0019">
                                                            <ns2:items id="text">Normal</ns2:items>
                                                            <ns2:items id="description">The eyes are not sunken.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0020">
                                                            <ns2:items id="text">Sunken in orbits</ns2:items>
                                                            <ns2:items id="description">The eyes appear sunken in the orbits.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0021">
                                                            <ns2:items id="text">Capillary filling time</ns2:items>
                                                            <ns2:items id="description">Description of state of capillary return.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0022">
                                                            <ns2:items id="text">Normal</ns2:items>
                                                            <ns2:items id="description">Capillary return is normal.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0023">
                                                            <ns2:items id="text">Reduced</ns2:items>
                                                            <ns2:items id="description">Capillary return is diminished.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0025">
                                                            <ns2:items id="text">Saliva thickness</ns2:items>
                                                            <ns2:items id="description">Details of thickness of saliva.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0026">
                                                            <ns2:items id="text">Estimate of dehydration</ns2:items>
                                                            <ns2:items id="description">Clinical estimate of dehydration.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0028">
                                                            <ns2:items id="text">Markedly decreased</ns2:items>
                                                            <ns2:items id="description">Skin turgor is markedly decreased.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0029">
                                                            <ns2:items id="text">Increased</ns2:items>
                                                            <ns2:items id="description">*</ns2:items>
                                                        </ns2:term_definitions>
