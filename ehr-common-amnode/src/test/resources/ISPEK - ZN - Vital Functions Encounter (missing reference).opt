                    <ns2:value>ISPEK - ZN - Vital Functions Encounter</ns2:value>
                </ns2:template_id>
                <ns2:term_definitions code="at0000">
                    <ns2:items id="text">Nursing intervention</ns2:items>
                    <ns2:items id="description">A clinical activity that has been carried out for therapeutic or diagnostic purposes.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0001">
                    <ns2:items id="text">Tree</ns2:items>
                    <ns2:items id="description">@ internal @</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0002">
                    <ns2:items id="text">Activity</ns2:items>
                    <ns2:items id="description">The name of the procedure.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0003">
                    <ns2:items id="text">Intervention details</ns2:items>
                    <ns2:items id="description">Detailed structure describing the procedure carried out, including preparation and details about the method and equipment/devices used.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0004">
                    <ns2:items id="text">Intervention unsuccessful</ns2:items>
                    <ns2:items id="description">Was the intervention regarded as unsuccessful, from a clinical perspective? True if unsuccessful.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0005">
                    <ns2:items id="text">Comments</ns2:items>
                    <ns2:items id="description">Comments about the procedure.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0006">
                    <ns2:items id="text">Complication</ns2:items>
                    <ns2:items id="description">Details about any complication arising from the procedure.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0013">
                    <ns2:items id="text">Multimedia</ns2:items>
                    <ns2:items id="description">Multimedia representation of the procedure, including images.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0014">
                    <ns2:items id="text">Reason/s for intervention</ns2:items>
                    <ns2:items id="description">The reason or indication for the procedure.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0015">
                    <ns2:items id="text">Unplanned event</ns2:items>
                    <ns2:items id="description">An unplanned event prior to or related to the procedure, which may affect its execution e.g patient self-removed cannula.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0018">
                    <ns2:items id="text">Failed attempts</ns2:items>
                    <ns2:items id="description">The number of failed attempts to perform the procedure.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0030">
                    <ns2:items id="text">Additional task</ns2:items>
                    <ns2:items id="description">Record information about unplanned or unexpected activities that needed to be done during the procedure. Record the name of the task and a description within this archetype, but detail should be recorded in specific linked INSTRUCTION or ACTION archetypes.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0031">
                    <ns2:items id="text">Task description</ns2:items>
                    <ns2:items id="description">Description of additional task performed during the procedure.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0032">
                    <ns2:items id="text">Record of additional task</ns2:items>
                    <ns2:items id="description">Link to a detailed record of the additional task.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0034">
                    <ns2:items id="text">Request initiated</ns2:items>
                    <ns2:items id="description">Request for procedure is initiated.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0035">
                    <ns2:items id="text">Request sent</ns2:items>
                    <ns2:items id="description">Request for procedure sent.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0036">
                    <ns2:items id="text">Intervention scheduled</ns2:items>
                    <ns2:items id="description">Intervention has been scheduled.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0038">
                    <ns2:items id="text">Request postponed</ns2:items>
                    <ns2:items id="description">Request for procedure is postponed.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0039">
                    <ns2:items id="text">Request cancelled</ns2:items>
                    <ns2:items id="description">Procedure request has been cancelled.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0040">
                    <ns2:items id="text">Intervention suspended</ns2:items>
                    <ns2:items id="description">Intervention has been suspended.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0041">
                    <ns2:items id="text">Intervention aborted</ns2:items>
                    <ns2:items id="description">Intervention has been aborted.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0043">
                    <ns2:items id="text">Completed</ns2:items>
                    <ns2:items id="description">Procedure has been completed.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0044">
                    <ns2:items id="text">Report authored</ns2:items>
                    <ns2:items id="description">Procedure report has been written.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0045">
                    <ns2:items id="text">Report attested</ns2:items>
                    <ns2:items id="description">Procedure report has been attested.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0046">
                    <ns2:items id="text">Report sent</ns2:items>
                    <ns2:items id="description">Procedure report has been distributed.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0047">
                    <ns2:items id="text">In progress</ns2:items>
                    <ns2:items id="description">Procedure is being carried out.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0048">
                    <ns2:items id="text">Outcome</ns2:items>
                    <ns2:items id="description">Outcome of intervention performed.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0049">
                    <ns2:items id="text">Narrative description</ns2:items>
                    <ns2:items id="description">Narrative description about the procedure carried out.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0050">
                    <ns2:items id="text">Anatomical site details</ns2:items>
                    <ns2:items id="description">Details about the anatomical site of procedure.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0051">
                    <ns2:items id="text">Method/Technique</ns2:items>
                    <ns2:items id="description">Identification of specific methods or techniques used for procedure or intervention.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0052">
                    <ns2:items id="text">Task</ns2:items>
                    <ns2:items id="description">Name of additional task performed during the procedure.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0053">
                    <ns2:items id="text">Tree</ns2:items>
                    <ns2:items id="description">@ internal @</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0054">
                    <ns2:items id="text">Requestor request identifier</ns2:items>
                    <ns2:items id="description">The local ID assigned to the order by the healthcare provider or organisation requesting the service. </ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0055">
                    <ns2:items id="text">Requestor</ns2:items>
                    <ns2:items id="description">Details about the healthcare provider or organisation requesting the service.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0056">
                    <ns2:items id="text">Receiver request identifier</ns2:items>
                    <ns2:items id="description">The ID assigned to the order by the healthcare provider or organisation receiving the request for service. This is also referred to as Filler Order Identifier.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0057">
                    <ns2:items id="text">Receiver</ns2:items>
                    <ns2:items id="description">Details about the healthcare provider or organisation receiving the request for service.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0060">
                    <ns2:items id="text">On-spot evaluation</ns2:items>
                    <ns2:items id="description">Descriptions of variance in the procedure performed from that requested.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0061">
                    <ns2:items id="text">Localisation</ns2:items>
                    <ns2:items id="description">Details of information required to support process and other local requirements.</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0062">
                    <ns2:items id="text">Task details</ns2:items>
                    <ns2:items id="description">*</ns2:items>
                </ns2:term_definitions>
                <ns2:term_definitions code="at0063">
                    <ns2:items id="text">Date time task performed</ns2:items>
                    <ns2:items id="description">*</ns2:items>
                </ns2:term_definitions>
            </ns2:children>
