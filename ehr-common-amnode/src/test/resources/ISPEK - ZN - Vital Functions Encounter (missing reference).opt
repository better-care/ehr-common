                <ns2:items id="description">Barva telesne tekočine je bela</ns2:items>
            </ns2:items>
            <ns2:items code="at0101">
                <ns2:items id="text">Črna/siva</ns2:items>
                <ns2:items id="description">Barva telesne tekočine je črna/siva</ns2:items>
            </ns2:items>
            <ns2:items code="at0102">
                <ns2:items id="text">*Purulence(en)</ns2:items>
                <ns2:items id="description">*Evidence of pus within the substance.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0103">
                <ns2:items id="text">*Not purulent(en)</ns2:items>
                <ns2:items id="description">*The substance is not purulent.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0104">
                <ns2:items id="text">*Purulent(en)</ns2:items>
                <ns2:items id="description">*The substance appears to contain pus.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0105">
                <ns2:items id="text">*Muco-purulent(en)</ns2:items>
                <ns2:items id="description">*The substance appears to contain a mixture of mucus and pus.(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-CLUSTER.anatomical_location.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Anatmoska lokacija</ns2:items>
                <ns2:items id="description">Anatomski opis lokacije na telesu oz. pozicije telesa </ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">Naziv</ns2:items>
                <ns2:items id="description">Naziv anatomske lokacije</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">Stran telesa</ns2:items>
                <ns2:items id="description">Opis določeni strani telesa</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">Leva stran</ns2:items>
                <ns2:items id="description">Leva stran</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Desna stran</ns2:items>
                <ns2:items id="description">Desna stran</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">Lokacija (točno mesto)</ns2:items>
                <ns2:items id="description">Točna anatomska lokacija / točka /predel na telesu</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">*Aspect(en)</ns2:items>
                <ns2:items id="description">*Qualifier to identify which direction the anatomical location is in relation to the identified landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0007">
                <ns2:items id="text">Srednji</ns2:items>
                <ns2:items id="description">*Relative location medial to the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0008">
                <ns2:items id="text">Stranski</ns2:items>
                <ns2:items id="description">*Relative location lateral to the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0009">
                <ns2:items id="text">Višje</ns2:items>
                <ns2:items id="description">*Relative location superior to the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0010">
                <ns2:items id="text">Nižje</ns2:items>
                <ns2:items id="description">*Relative location inferior to the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0011">
                <ns2:items id="text">V sredini</ns2:items>
                <ns2:items id="description">*In the sagittal plane passing through the midline of the body.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0012">
                <ns2:items id="text">Spredaj</ns2:items>
                <ns2:items id="description">*Relative location anterior to the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0013">
                <ns2:items id="text">Zadaj</ns2:items>
                <ns2:items id="description">*Relative location posterior to the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0014">
                <ns2:items id="text">Spodaj</ns2:items>
                <ns2:items id="description">*Relative location below the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0015">
                <ns2:items id="text">Zgoraj</ns2:items>
                <ns2:items id="description">*Relative location above the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0016">
                <ns2:items id="text">Nižje ob strani</ns2:items>
                <ns2:items id="description">*Relative location inferior and medial to the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0017">
                <ns2:items id="text">Višje ob strani</ns2:items>
                <ns2:items id="description">*Relative location superior and lateral to the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">Nižje v sredini</ns2:items>
                <ns2:items id="description">*Relative location inferior and medial to the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0019">
                <ns2:items id="text">Višje v sredini</ns2:items>
                <ns2:items id="description">*Relative location superior and medial to the landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0020">
                <ns2:items id="text">*Relative location(en)</ns2:items>
                <ns2:items id="description">*Qualifiers to identify non-specific location eg 5cm (distance) inferior (aspect) to the tibial tuberosity (landmark).  There may be more than one relative location required to provide a cross reference.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0021">
                <ns2:items id="text">*Identified landmark(en)</ns2:items>
                <ns2:items id="description">*Identified anatomical landmark from which to specify relative anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0022">
                <ns2:items id="text">*Distance from landmark(en)</ns2:items>
                <ns2:items id="description">*Distance of location from the identified landmark.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0023">
                <ns2:items id="text">Opis</ns2:items>
                <ns2:items id="description">*Description of anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0024">
                <ns2:items id="text">*Anatomical plane(en)</ns2:items>
                <ns2:items id="description">*Line describing the position of a vertical anatomical plane in the body.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0025">
                <ns2:items id="text">*Midclavicular line(en)</ns2:items>
                <ns2:items id="description">*In the sagittal plane passing through mid-clavical.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0026">
                <ns2:items id="text">*Midaxillary line(en)</ns2:items>
                <ns2:items id="description">*In the coronal plane passing through mid-axilla.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0027">
                <ns2:items id="text">*Midscapular line(en)</ns2:items>
                <ns2:items id="description">*In the sagittal plane passing through mid-scapula.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0028">
                <ns2:items id="text">*Numerical identifier(en)</ns2:items>
                <ns2:items id="description">*Identify the specific anatomical site out of multiple eg tenth rib; fourth vertebra; second toe.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0029">
                <ns2:items id="text">Prvi</ns2:items>
                <ns2:items id="description">*Ordinal position 1 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0030">
                <ns2:items id="text">Drugi</ns2:items>
                <ns2:items id="description">*Ordinal position 2 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0031">
                <ns2:items id="text">Tretji</ns2:items>
                <ns2:items id="description">*Ordinal position 3 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0032">
                <ns2:items id="text">Četrti</ns2:items>
                <ns2:items id="description">*Ordinal position 4 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0033">
                <ns2:items id="text">Peti</ns2:items>
                <ns2:items id="description">*Ordinal position 5 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0034">
                <ns2:items id="text">Šesti</ns2:items>
                <ns2:items id="description">*Ordinal position 6 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0035">
                <ns2:items id="text">Sedmi</ns2:items>
                <ns2:items id="description">*Ordinal position 7 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0036">
                <ns2:items id="text">Osmi</ns2:items>
                <ns2:items id="description">*Ordinal position 8 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0037">
                <ns2:items id="text">Deveti</ns2:items>
                <ns2:items id="description">*Ordinal position 9 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0038">
                <ns2:items id="text">deseti</ns2:items>
                <ns2:items id="description">*Ordinal position 10 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0039">
                <ns2:items id="text">Enajsti</ns2:items>
                <ns2:items id="description">*Ordinal position 11 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0040">
                <ns2:items id="text">Dvanajsti</ns2:items>
                <ns2:items id="description">*Ordinal position 12 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0041">
                <ns2:items id="text">Trinajsti</ns2:items>
                <ns2:items id="description">*Ordinal position 13 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0042">
                <ns2:items id="text">Štirinajstih</ns2:items>
                <ns2:items id="description">*Ordinal position 14 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0043">
                <ns2:items id="text">Petnajsti</ns2:items>
                <ns2:items id="description">*Ordinal position 15 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0044">
                <ns2:items id="text">Šestnajsti</ns2:items>
                <ns2:items id="description">*Ordinal position 16 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0045">
                <ns2:items id="text">Sedemnajsti</ns2:items>
                <ns2:items id="description">*Ordinal position 17 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0046">
                <ns2:items id="text">Osemnajsti</ns2:items>
                <ns2:items id="description">*Ordinal position 18 of an anatomical location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0051">
                <ns2:items id="text">Levo in desno</ns2:items>
                <ns2:items id="description">*Both left and right.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0052">
                <ns2:items id="text">Fotografija</ns2:items>
                <ns2:items id="description">*Image or images used to identify a location.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0053">
                <ns2:items id="text">*Visual markings/orientation(en)</ns2:items>
                <ns2:items id="description">*Description of any visual markings used to orientate the viewer e.g external reference points, special sutures, ink markings.(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-CLUSTER.bodily_substance-faeces.v1">
