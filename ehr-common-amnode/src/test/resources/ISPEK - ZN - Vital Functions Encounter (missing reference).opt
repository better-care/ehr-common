                                <ns2:term_definitions code="at0000">
                                    <ns2:items id="text">Context detail</ns2:items>
                                    <ns2:items id="description">Additional contextual detail to be applied to all compositions.</ns2:items>
                                </ns2:term_definitions>
                                <ns2:term_definitions code="at0001">
                                    <ns2:items id="text">Period of care identifier</ns2:items>
                                    <ns2:items id="description">The period of care to which this composition belongs. This equates to the CONTSYS concept and repesents an admisitrative or contractual spell of care, involving a specific instiution or care provider.</ns2:items>
                                </ns2:term_definitions>
                                <ns2:term_definitions code="at0002">
                                    <ns2:items id="text">Departmental period of care identifier</ns2:items>
                                    <ns2:items id="description">The identifier of the departmental period of care to which this Composition belongs.</ns2:items>
                                </ns2:term_definitions>
                                <ns2:term_definitions code="at0003">
                                    <ns2:items id="text">Portlet Id</ns2:items>
                                    <ns2:items id="description">Portlet ID from which stores the information where was the composition saved.</ns2:items>
                                </ns2:term_definitions>
