    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.fluid_output.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Izločene tekočine</ns2:items>
                <ns2:items id="description">*Recording of findings and measurement (or estimation) of bodily output such as fluid output and defaecation.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Event Series(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">*Any event(en)</ns2:items>
                <ns2:items id="description">*The estimation of fluid output without specifying the period of time.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">*List(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">*Total(en)</ns2:items>
                <ns2:items id="description">*For recording total fluid output over a period (may transcend a number of interval or point in time records).(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0007">
                <ns2:items id="text">*Actual(en)</ns2:items>
                <ns2:items id="description">*For recording the fluid output over a period of time when this will later be totalled.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0008">
                <ns2:items id="text">*List(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0016">
                <ns2:items id="text">*Fluid detail(en)</ns2:items>
                <ns2:items id="description">*Details of the fluid or substance observed being observed.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">*Estimated(en)</ns2:items>
                <ns2:items id="description">*The fluid volume has been estimated.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0019">
                <ns2:items id="text">*Measured(en)</ns2:items>
                <ns2:items id="description">*The fluid volume has been directly measured.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0020">
                <ns2:items id="text">*Stated(en)</ns2:items>
                <ns2:items id="description">*The fluid output has been stated.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0028">
                <ns2:items id="text">*Measurement device (en)</ns2:items>
                <ns2:items id="description">*Details of device used to measure the fluid output.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0031">
                <ns2:items id="text">*Measurement precision(en)</ns2:items>
                <ns2:items id="description">*Records the level of precision of the fluid output observation.(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
