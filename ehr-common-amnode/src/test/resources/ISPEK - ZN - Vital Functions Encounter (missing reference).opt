                        <ns2:archetype_id>
                            <ns2:value>openEHR-EHR-OBSERVATION.indirect_oximetry.v1</ns2:value>
                        </ns2:archetype_id>
                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Indirect oximetry</ns2:items>
                            <ns2:items id="description">Method of monitoring blood gas measurements such as Spo2 and pTCO2 by indirect, currently non-invasive, means. </ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Event Series</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">Timing event.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0006">
                            <ns2:items id="comment">SpO2 is defined as the ratio of oxyhaemoglobin (HbO2) to the total concentration of haemoglobin (HbO2 + deoxyhaemoglobin).</ns2:items>
                            <ns2:items id="text">spO2</ns2:items>
                            <ns2:items id="description">Measured via pulse oximetry, the saturation of oxygen in the peripheral blood. </ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0007">
                            <ns2:items id="text">List</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0009">
                            <ns2:items id="text">Sensor site</ns2:items>
                            <ns2:items id="description">The site of the measurement sensor.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0014">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0015">
                            <ns2:items id="text">Ambient oxygen</ns2:items>
                            <ns2:items id="description">Details of the amount of oxygen available to the subject at the time of observation.  Assumed values of 21% oxygen concentration, Fi02 of 0.21 and oxygen flow rate of 0 l/min or 0 ml/min.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0016">
                            <ns2:items id="text">Confounding factors</ns2:items>
                            <ns2:items id="description">Comment on and record other incidental factors that may be affect interpretation of the observation. For example, motion, pain, poor perfusion, infant feeding.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0018">
                            <ns2:items id="text">Device</ns2:items>
                            <ns2:items id="description">Details of the non-invasive oximetry device used.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0019">
                            <ns2:items id="text">Multimedia image</ns2:items>
                            <ns2:items id="description">Details of a series of oximetry readings, other than waveforms, expressed as a multimedia image or series of images. Waveforms should be recorded using the Waveform slot and associated cluster archetype.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0020">
                            <ns2:items id="text">Sensor type</ns2:items>
                            <ns2:items id="description">The type of measurement sensor used e.g. transmittal, reflective, clamp or strip, electrode.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0034">
                            <ns2:items id="text">Exertion</ns2:items>
                            <ns2:items id="description">Details about physical activity undertaken at the time of measurement.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0036">
                            <ns2:items id="text">Comment</ns2:items>
                            <ns2:items id="description">A text comment about the indirect oximetry result.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0037">
                            <ns2:items id="text">Electrode operating temperature</ns2:items>
                            <ns2:items id="description">The operating temperature of a transcutaneous oximeter electrode.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0038">
                            <ns2:items id="text">Time of sensor application</ns2:items>
                            <ns2:items id="description">The date and time at which the sensor was applied. Significant for transcutaneous oximetry.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0039">
                            <ns2:items id="text">ptcO2</ns2:items>
                            <ns2:items id="description">Measured via transcutaneous electrode oximetry, the partial pressure of oxygen in the peripheral blood.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0040">
                            <ns2:items id="text">ptcCO2</ns2:items>
                            <ns2:items id="description">Measured via transcutaneous electrode oximetry, the partial pressure of carbon dioxide in the peripheral blood.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0044">
                            <ns2:items id="text">spOC</ns2:items>
                            <ns2:items id="description">Measured via pulse CO-oximetry, the oxygen content of the peripheral blood.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0045">
                            <ns2:items id="text">spCO</ns2:items>
                            <ns2:items id="description">Measured via pulse CO-oximetry, the saturation of carboxyhaemoglobin in the perpiheral blood.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0046">
                            <ns2:items id="text">spMet</ns2:items>
                            <ns2:items id="description">Measured via pulse CO-oximetry, the saturation of methoxyhaemoglobin in the peripheral blood.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0048">
                            <ns2:items id="text">Transmittal</ns2:items>
                            <ns2:items id="description">A pulse oximetry transmittal sensor was applied.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0049">
                            <ns2:items id="text">Reflective</ns2:items>
                            <ns2:items id="description">A pulse oximetry reflective sensor was applied.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0050">
                            <ns2:items id="text">Clamp</ns2:items>
                            <ns2:items id="description">A pulse oximetry clamp sensor was applied.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0051">
                            <ns2:items id="text">Strip</ns2:items>
                            <ns2:items id="description">A pulse oximetry strip sensor was applied.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0052">
                            <ns2:items id="text">Electrode</ns2:items>
                            <ns2:items id="description">A transcutaneous electrode sensor was applied.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0054">
                            <ns2:items id="text">Waveform</ns2:items>
                            <ns2:items id="description">A waveform reading associated with the oximetry measurement.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0058">
                            <ns2:items id="text">Location of measurement SaO2</ns2:items>
                            <ns2:items id="description">Location of measurement SaO2</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0059">
                            <ns2:items id="text">Fingers of left arm</ns2:items>
                            <ns2:items id="description">The SaO2 is measured in fingers of left arm</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0060">
                            <ns2:items id="text">Fingers of right arm</ns2:items>
                            <ns2:items id="description">The SaO2 is measured in fingers of right arm</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0061">
                            <ns2:items id="text">Toes of left leg</ns2:items>
                            <ns2:items id="description">The SaO2 is measured on toes of left leg</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0062">
                            <ns2:items id="text">Toes of right leg</ns2:items>
                            <ns2:items id="description">The SaO2 is measured on toes of right leg</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0063">
                            <ns2:items id="text">Palm of left arm</ns2:items>
                            <ns2:items id="description">The SaO2 is measured on palm of left arm</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0064">
                            <ns2:items id="text">Palm of right arm</ns2:items>
                            <ns2:items id="description">The SaO2 is measured on palm of right arm</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0065">
                            <ns2:items id="text">Left leg</ns2:items>
                            <ns2:items id="description">The SaO2 is measured on left leg</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0066">
                            <ns2:items id="text">Right leg</ns2:items>
                            <ns2:items id="description">The SaO2 is measured on right leg</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0067">
                            <ns2:items id="text">Left pinna</ns2:items>
                            <ns2:items id="description">SaO2 is measured on left pinna</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0068">
                            <ns2:items id="text">Right pinna</ns2:items>
                            <ns2:items id="description">SaO2 is measured on right pinna</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0069">
                            <ns2:items id="text">Forehead</ns2:items>
                            <ns2:items id="description">SaO2 is measured on forehead</ns2:items>
                        </ns2:term_definitions>
                    </ns2:children>
