                        <ns2:term_definitions code="at0009">
                            <ns2:items id="text">Eyeball position in orbit</ns2:items>
                            <ns2:items id="description">The position of the eyeball with respect to the orbit.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0010">
                            <ns2:items id="text">Protruding / bulging</ns2:items>
                            <ns2:items id="description">The eyeball appears to protrude from the orbit.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0011">
                            <ns2:items id="text">Normal</ns2:items>
                            <ns2:items id="description">The eyeball position is normal with respect to the orbit.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0012">
                            <ns2:items id="text">Sunken</ns2:items>
                            <ns2:items id="description">The eyebell appears sunken in the orbit.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0013">
                            <ns2:items id="text">Eye movement</ns2:items>
                            <ns2:items id="description">Description of eye movement.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0014">
                            <ns2:items id="text">Eyeballs central</ns2:items>
                            <ns2:items id="description">The eyeballs are central.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0015">
                            <ns2:items id="text">Nystagmus</ns2:items>
                            <ns2:items id="description">Evidence of nystagmus.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0016">
                            <ns2:items id="text">None</ns2:items>
                            <ns2:items id="description">No evidence of nystagmus.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0017">
                            <ns2:items id="text">Vertical</ns2:items>
                            <ns2:items id="description">The subject has vertical nystagmus.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0018">
                            <ns2:items id="text">Horizontal</ns2:items>
                            <ns2:items id="description">The subject has horizontal nystagmus.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0019">
                            <ns2:items id="text">Rotary</ns2:items>
                            <ns2:items id="description">The subject has rotaryl nystagmus.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0020">
                            <ns2:items id="text">Present</ns2:items>
                            <ns2:items id="description">Vision is impaired in the left eye.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0021">
                            <ns2:items id="text">Not present</ns2:items>
                            <ns2:items id="description">Vision is not impaired in the left eye.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0022">
                            <ns2:items id="text">Present</ns2:items>
                            <ns2:items id="description">Vision is impaired in the right eye.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0023">
                            <ns2:items id="text">Not present</ns2:items>
                            <ns2:items id="description">Vision is not impaired in the right eye.</ns2:items>
                        </ns2:term_definitions>
