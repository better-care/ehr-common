    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.respiration.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Dihanje</ns2:items>
                <ns2:items id="description">Opazovanje spontanega dihanja pacienta</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*history(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">*Any event(en)</ns2:items>
                <ns2:items id="description">*Generic event(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0003">
                <ns2:items id="text">*List(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0004">
                <ns2:items id="text">Frekvenca dihanja</ns2:items>
                <ns2:items id="description">Frekvenca dihanja</ns2:items>
            </ns2:items>
            <ns2:items code="at0005">
                <ns2:items id="text">Ritem</ns2:items>
                <ns2:items id="description">Ritem dihanja</ns2:items>
            </ns2:items>
            <ns2:items code="at0006">
                <ns2:items id="text">Enakomeren</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0007">
                <ns2:items id="text">Neenakomeren</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0009">
                <ns2:items id="text">Posebne oblike</ns2:items>
                <ns2:items id="description">Posebne oblike dihanja</ns2:items>
            </ns2:items>
            <ns2:items code="at0012">
                <ns2:items id="text">Kussmaulovo</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0016">
                <ns2:items id="text">Globina</ns2:items>
                <ns2:items id="description">Globina dihanja</ns2:items>
            </ns2:items>
            <ns2:items code="at0017">
                <ns2:items id="text">Normalno</ns2:items>
                <ns2:items id="description">Normalna globina dihanja</ns2:items>
            </ns2:items>
            <ns2:items code="at0018">
                <ns2:items id="text">Plitvo</ns2:items>
                <ns2:items id="description">Plitvo dihanje</ns2:items>
            </ns2:items>
            <ns2:items code="at0019">
                <ns2:items id="text">Globoko</ns2:items>
                <ns2:items id="description">Globoko dihanje</ns2:items>
            </ns2:items>
            <ns2:items code="at0022">
                <ns2:items id="text">*List(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0024">
                <ns2:items id="text">Opis</ns2:items>
                <ns2:items id="description">Opis dihanja</ns2:items>
            </ns2:items>
            <ns2:items code="at0025">
                <ns2:items id="text">Spremenljivo</ns2:items>
                <ns2:items id="description">Spremenljive globine</ns2:items>
            </ns2:items>
            <ns2:items code="at0030">
                <ns2:items id="text">Cheyne-Stokesovo</ns2:items>
                <ns2:items id="description">*</ns2:items>
            </ns2:items>
            <ns2:items code="at0031">
                <ns2:items id="text">*Ataxic respiration(en)</ns2:items>
                <ns2:items id="description">*Breathing of varying tidal volumes and rates.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0033">
                <ns2:items id="text">*Apneustic respiration(en)</ns2:items>
                <ns2:items id="description">*Deep, gasping inspiration with a pause at full inspiration followed by a brief, insufficient release of breath.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0034">
                <ns2:items id="text">Biotovo</ns2:items>
                <ns2:items id="description">*Clusters of irregular breaths that alternate with periods of apnoea. Also termed Biot's breathing.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0037">
                <ns2:items id="text">Napor</ns2:items>
                <ns2:items id="description">*Subject's level of exertion at or just prior to the observation being made. Intended only to record exertion only as it might effect respirations and where it would not normally be recorded as part of general clinical observation.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0044">
                <ns2:items id="text">Apnea</ns2:items>
                <ns2:items id="description">Dihalni premor, dihalna pavza</ns2:items>
            </ns2:items>
            <ns2:items code="at0054">
                <ns2:items id="text">Podaljšan izdih/vdih</ns2:items>
                <ns2:items id="description">Faza izdiha je podaljšana glede na normalno dolžino te faze v primerjavi s fazo vdiha. Povezano z obstruktivnimi boleznimi, npr. astmo.</ns2:items>
            </ns2:items>
            <ns2:items code="at0055">
                <ns2:items id="text">FiO2</ns2:items>
                <ns2:items id="description">Delež kisika v vdihanem zraku. Privzeta vrednost je 21%</ns2:items>
            </ns2:items>
            <ns2:items code="at0056">
                <ns2:items id="text">*Confounding factors(en)</ns2:items>
                <ns2:items id="description">*Comment on and record other incidental factors that may be contributing to the respirations observation. For example, level of anxiety, pain, feeding in infants, tracheostomy.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0057">
                <ns2:items id="text">Periodično</ns2:items>
                <ns2:items id="description">*Clusters of breaths separated by intervals of apnea (no breathing) or near-apnea. May also describe a normal patter nof breathing in neonates.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0058">
                <ns2:items id="text">Paradoksalno</ns2:items>
                <ns2:items id="description">*Inflation of the lung during expiration and deflation of the lung during inspiration.(en)</ns2:items>
            </ns2:items>
        </ns2:term_definitions>
    </ns2:component_ontologies>
    <ns2:component_ontologies archetype_id="openEHR-EHR-OBSERVATION.apnoea__zn.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0000">
                <ns2:items id="text">Apnoa</ns2:items>
                <ns2:items id="description">Podrobnosti o pojavu apnoe</ns2:items>
            </ns2:items>
            <ns2:items code="at0001">
                <ns2:items id="text">*Event Series(en)</ns2:items>
                <ns2:items id="description">*@ internal @(en)</ns2:items>
