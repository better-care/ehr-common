                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0053">
                                            <ns2:items id="text">NO delivered</ns2:items>
                                            <ns2:items id="description">Amout of Nitrogen monoxide delivered.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0054">
                                            <ns2:items id="text">NO2 removed</ns2:items>
                                            <ns2:items id="description">*</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0055">
                                            <ns2:items id="text">Heater used</ns2:items>
                                            <ns2:items id="description">If true a heater should be used/ is used.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0056">
                                            <ns2:items id="text">Ventilation device</ns2:items>
                                            <ns2:items id="description">Details of the ventilation device.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0058">
                                            <ns2:items id="text">Flows</ns2:items>
                                            <ns2:items id="description">Flow-related settings.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0059">
                                            <ns2:items id="text">Flow name</ns2:items>
                                            <ns2:items id="description">The name of the flow parameter.</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0060">
                                            <ns2:items id="text">Flow rate</ns2:items>
                                            <ns2:items id="description">*</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0065">
                                            <ns2:items id="text">Spontaneous</ns2:items>
                                            <ns2:items id="description">Patient is breathing spontaneously.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0066">
                                            <ns2:items id="text">A/C (ACV) (A/CMV)</ns2:items>
                                            <ns2:items id="description">Assist-control ventilation.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0067">
                                            <ns2:items id="text">A/C PC (PACV)</ns2:items>
                                            <ns2:items id="description">Assist-control ventilation, pressure controlled.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0068">
                                            <ns2:items id="text">A/C VC</ns2:items>
                                            <ns2:items id="description">Assist-control ventilation, volume controlled.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0069">
                                            <ns2:items id="text">SIMV VC/PC</ns2:items>
                                            <ns2:items id="description">Synchronised intermittent mandatory ventilation.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0070">
                                            <ns2:items id="text">CPAP (PS/CPAP)</ns2:items>
                                            <ns2:items id="description">Pressure support / Continous positive airway pressure.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0071">
                                            <ns2:items id="text">BILEVEL CPAP</ns2:items>
                                            <ns2:items id="description">Bilevel CPAP.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0072">
                                            <ns2:items id="text">CMV (CV)</ns2:items>
                                            <ns2:items id="description">Controlled mandatory ventilation or Controlled ventilation&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0073">
                                            <ns2:items id="text">HFOV</ns2:items>
                                            <ns2:items id="description"> High frequency oscillation ventilation.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0074">
                                            <ns2:items id="text">HFO CMV</ns2:items>
                                            <ns2:items id="description">High frequency oscillation + Controlled mechanical ventilation.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0075">
                                            <ns2:items id="text">PTV</ns2:items>
                                            <ns2:items id="description">Patient triggered ventilation.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0076">
                                            <ns2:items id="text">IPPV</ns2:items>
                                            <ns2:items id="description">Intermittent positive pressure ventilation.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0077">
                                            <ns2:items id="text">MMV</ns2:items>
                                            <ns2:items id="description">Mandatory minute ventilation.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0078">
                                            <ns2:items id="text">SIMV ASB</ns2:items>
                                            <ns2:items id="description">Synchronised intermittent mandatory ventilation + Assisted spontaneous breathing.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0079">
                                            <ns2:items id="text">BiPAP</ns2:items>
                                            <ns2:items id="description">Biphasic positive airway pressure.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0080">
                                            <ns2:items id="text">PSV</ns2:items>
                                            <ns2:items id="description">Pressure support ventilation.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0081">
                                            <ns2:items id="text">BiPAP ASB</ns2:items>
                                            <ns2:items id="description">Biphasic positive airway pressure + Assisted spontaneous breathing.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0082">
                                            <ns2:items id="text">PSV ST</ns2:items>
                                            <ns2:items id="description">Pressure support ventilation with spontaneous timed mode.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0083">
                                            <ns2:items id="text">PCV</ns2:items>
                                            <ns2:items id="description">Pressure controlled ventilation.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0084">
                                            <ns2:items id="text">S/ T</ns2:items>
                                            <ns2:items id="description">Spontaneous timed breathing.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="at0085">
                                            <ns2:items id="text">PAV / T</ns2:items>
                                            <ns2:items id="description">Proportional assist ventilation/Time.&#13;</ns2:items>
                                        </ns2:term_definitions>
                                        <ns2:term_definitions code="[ppb]">
                                            <ns2:items id="text">ppb</ns2:items>
                                            <ns2:items id="description">parts per billion</ns2:items>
                                        </ns2:term_definitions>
                                    </ns2:children>
