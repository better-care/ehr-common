                                <ns2:term_definitions code="at0012">
                                    <ns2:items id="text">Quantity</ns2:items>
                                    <ns2:items id="description">The quantity of material used - default derived from EAN terminology.</ns2:items>
                                </ns2:term_definitions>
                                <ns2:term_definitions code="at0019">
                                    <ns2:items id="text">Notification</ns2:items>
