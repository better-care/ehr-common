    <ns2:component_ontologies archetype_id="openEHR-EHR-ACTION.procedure-ventilation-zn.v1">
        <ns2:term_definitions language="sl">
            <ns2:items code="at0.0.64">
                <ns2:items id="text">Filter menjan</ns2:items>
                <ns2:items id="description">Podatki o zamenjavi filtra</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.69">
                <ns2:items id="text">Filter A</ns2:items>
                <ns2:items id="description">Datum zadnje menjave filtra A</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.70">
                <ns2:items id="text">Spontano dihajoč</ns2:items>
                <ns2:items id="description">*True if the patient is breathing spontaneously (for a short time) in spite of artificial ventilation.(en)</ns2:items>
            </ns2:items>
            <ns2:items code="at0.0.71">
