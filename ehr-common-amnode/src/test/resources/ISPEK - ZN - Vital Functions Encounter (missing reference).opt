                                                                </ns2:attributes>
                                                            </ns2:children>
                                                            <ns2:cardinality>
                                                                <ns2:is_ordered>false</ns2:is_ordered>
                                                                <ns2:is_unique>false</ns2:is_unique>
                                                                <ns2:interval>
                                                                    <ns2:lower_included>true</ns2:lower_included>
                                                                    <ns2:upper_included>false</ns2:upper_included>
                                                                    <ns2:lower_unbounded>false</ns2:lower_unbounded>
                                                                    <ns2:upper_unbounded>true</ns2:upper_unbounded>
                                                                    <ns2:lower>1</ns2:lower>
                                                                </ns2:interval>
                                                            </ns2:cardinality>
                                                        </ns2:attributes>
                                                        <ns2:archetype_id>
                                                            <ns2:value>openEHR-EHR-CLUSTER.pupils.v1</ns2:value>
                                                        </ns2:archetype_id>
                                                        <ns2:term_definitions code="at0000">
                                                            <ns2:items id="text">Pupils</ns2:items>
                                                            <ns2:items id="description">Record examination of pupils.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0002">
                                                            <ns2:items id="text">Pupil size</ns2:items>
                                                            <ns2:items id="description">Measured size of the pupil.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0003">
                                                            <ns2:items id="text">Direct light reflex</ns2:items>
                                                            <ns2:items id="description">Pupil constricts with light shone into that eye.   </ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0004">
                                                            <ns2:items id="text">Consensual light reflex</ns2:items>
                                                            <ns2:items id="description">Findings of the consensual pupillary light reflex.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0005">
                                                            <ns2:items id="text">Shape</ns2:items>
                                                            <ns2:items id="description">The shape of the pupil.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0006">
                                                            <ns2:items id="text">Accommodation reflex</ns2:items>
                                                            <ns2:items id="description">Findings of the pupillary accommodation reflex.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0007">
                                                            <ns2:items id="text">Speed of light reflex</ns2:items>
                                                            <ns2:items id="description">The speed of the pupillary response to light.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0008">
                                                            <ns2:items id="text">Sluggish/slow</ns2:items>
                                                            <ns2:items id="description">The pupillary light reflex is slower than normal.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0009">
                                                            <ns2:items id="text">Normal</ns2:items>
                                                            <ns2:items id="description">The speed of the pupillary light reflex is normal.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0010">
                                                            <ns2:items id="text">Brisk</ns2:items>
                                                            <ns2:items id="description">The pupillary light reflex is faster than normal.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0011">
                                                            <ns2:items id="text">Normal statement</ns2:items>
                                                            <ns2:items id="description">A single normal finding.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0013">
                                                            <ns2:items id="text">PERL - Pupils equal and reactive to light</ns2:items>
                                                            <ns2:items id="description">Both pupils are equal and reactive to light.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0014">
                                                            <ns2:items id="text">Right side</ns2:items>
                                                            <ns2:items id="description">Findings per side. May be recorded for left, right or both pupils.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0015">
                                                            <ns2:items id="text">Side</ns2:items>
                                                            <ns2:items id="description">Laterality of the eye(s) examined.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0016">
                                                            <ns2:items id="text">Left</ns2:items>
                                                            <ns2:items id="description">Findings of the left pupil.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0017">
                                                            <ns2:items id="text">Right</ns2:items>
                                                            <ns2:items id="description">Findings of the right pupil.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0018">
                                                            <ns2:items id="text">Both eyes</ns2:items>
                                                            <ns2:items id="description">Findings of both pupils.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0019">
                                                            <ns2:items id="text">PERLA - Pupils equal and reactive to light and accomodation.</ns2:items>
                                                            <ns2:items id="description">Both pupils are equal and reactive to light and accommodation. </ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0020">
                                                            <ns2:items id="text">Estimated size</ns2:items>
                                                            <ns2:items id="description">A text description of the estimated pupil size.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0021">
                                                            <ns2:items id="text">Normal pupil size (3-5mm)</ns2:items>
                                                            <ns2:items id="description">The pupil size is normal (3-5mm).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0022">
                                                            <ns2:items id="text">Constricted pupil (1.5-2.5mm)</ns2:items>
                                                            <ns2:items id="description">The pupil is constricted, relative to normal (1.5-2.5mm).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0023">
                                                            <ns2:items id="text">Pin-point pupil (&lt;= 1mm)</ns2:items>
                                                            <ns2:items id="description">The pupil is heavily constricted (&lt;= 1mm).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0024">
                                                            <ns2:items id="text">Dilated pupil (&gt;= 5.5mm)</ns2:items>
                                                            <ns2:items id="description">The pupil is dilated, relative to normal (&gt;= 5.5mm).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0027">
                                                            <ns2:items id="text">Comment</ns2:items>
                                                            <ns2:items id="description">Any additional comment on pupils.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0032">
                                                            <ns2:items id="text">Pupils normal</ns2:items>
                                                            <ns2:items id="description">The pupils appear and react normally.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0033">
                                                            <ns2:items id="text">Nonreactive (-)</ns2:items>
                                                            <ns2:items id="description">The direct light reflex is slow or sluggish (-).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0034">
                                                            <ns2:items id="text">Uncertain (+/-)</ns2:items>
                                                            <ns2:items id="description">The direct light reflex is of normal speed (+/-).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0035">
                                                            <ns2:items id="text">Slowly (+)</ns2:items>
                                                            <ns2:items id="description">The direct light reflex is slowly (+).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0036">
                                                            <ns2:items id="text">Normal (++)</ns2:items>
                                                            <ns2:items id="description">The direct light reflex is Normal (++).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0037">
                                                            <ns2:items id="text">Present</ns2:items>
                                                            <ns2:items id="description">The consensual light reflex is present.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0038">
                                                            <ns2:items id="text">Absent</ns2:items>
                                                            <ns2:items id="description">The consensual light reflex is absent.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0039">
                                                            <ns2:items id="text">Sluggish/slow (-)</ns2:items>
                                                            <ns2:items id="description">The consensual light reflex is sluggish or slow (-).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0040">
                                                            <ns2:items id="text">Normal (+/-)</ns2:items>
                                                            <ns2:items id="description">The consensual light reflex is of normal speed (+/-).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0041">
                                                            <ns2:items id="text">Brisk (+)</ns2:items>
                                                            <ns2:items id="description">The consensual light reflex is brisk (+).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0043">
                                                            <ns2:items id="text">Present</ns2:items>
                                                            <ns2:items id="description">The accomodation light reflex is present.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0044">
                                                            <ns2:items id="text">Absent</ns2:items>
                                                            <ns2:items id="description">The accommodation light reflex is absent.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0045">
                                                            <ns2:items id="text">Sluggish/slow (-)</ns2:items>
                                                            <ns2:items id="description">The accommodation light reflex is slow or sluggish (-).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0046">
                                                            <ns2:items id="text">Normal (-/+)</ns2:items>
                                                            <ns2:items id="description">The accommodation light reflex is of normal speed (+/-).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0047">
                                                            <ns2:items id="text">Brisk (+)</ns2:items>
                                                            <ns2:items id="description">The accommodation light reflex is brisk (+).</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0049">
                                                            <ns2:items id="text">Normal, circular</ns2:items>
                                                            <ns2:items id="description">The pupil is a normal, circular shape.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0050">
                                                            <ns2:items id="text">Abnormal</ns2:items>
                                                            <ns2:items id="description">The pupil is an abnormal shape.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0051">
                                                            <ns2:items id="text">Oval</ns2:items>
                                                            <ns2:items id="description">The pupil is an oval shape.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0052">
                                                            <ns2:items id="text">Irregular</ns2:items>
                                                            <ns2:items id="description">The pupil is irregular.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0053">
                                                            <ns2:items id="text">Afferent defect</ns2:items>
                                                            <ns2:items id="description">Findings of the afferent pupillary defect.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0054">
                                                            <ns2:items id="text">Absent</ns2:items>
                                                            <ns2:items id="description">The afferent pupillary relfex is absent.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0055">
                                                            <ns2:items id="text">Present</ns2:items>
                                                            <ns2:items id="description">The afferent pupillary reflex is present.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0056">
                                                            <ns2:items id="text">Sectoral</ns2:items>
                                                            <ns2:items id="description">*</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0057">
                                                            <ns2:items id="text">Teardrop</ns2:items>
                                                            <ns2:items id="description">The pupil is tear-drop shaped.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0058">
                                                            <ns2:items id="text">Keyhole</ns2:items>
                                                            <ns2:items id="description">The pupil is keyhole-shaped.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0059">
                                                            <ns2:items id="text">Iris colour</ns2:items>
                                                            <ns2:items id="description">The colour of the iris.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0060">
                                                            <ns2:items id="text">Blue</ns2:items>
                                                            <ns2:items id="description">The iris is blue.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0061">
                                                            <ns2:items id="text">Brown</ns2:items>
                                                            <ns2:items id="description">The iris is brown.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0062">
                                                            <ns2:items id="text">Grey</ns2:items>
                                                            <ns2:items id="description">The iris is grey.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0063">
                                                            <ns2:items id="text">Green</ns2:items>
                                                            <ns2:items id="description">The iris is green.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0064">
                                                            <ns2:items id="text">Red</ns2:items>
                                                            <ns2:items id="description">The iris is red.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0065">
                                                            <ns2:items id="text">Amber</ns2:items>
                                                            <ns2:items id="description">The iris is amber.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0066">
                                                            <ns2:items id="text">Hazel</ns2:items>
                                                            <ns2:items id="description">The iris colour is hazel.</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0067">
                                                            <ns2:items id="text">*Zelo hiter (++)(en)</ns2:items>
                                                            <ns2:items id="description">**(en)</ns2:items>
                                                        </ns2:term_definitions>
                                                        <ns2:term_definitions code="at0068">
                                                            <ns2:items id="text">Fast (+++)</ns2:items>
                                                            <ns2:items id="description">Fast (+++)</ns2:items>
                                                        </ns2:term_definitions>
