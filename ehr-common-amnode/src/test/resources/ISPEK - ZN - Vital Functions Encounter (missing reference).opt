                        <ns2:term_definitions code="at0.32">
                            <ns2:items id="text">Character</ns2:items>
                            <ns2:items id="description">Character of the vomiting.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.33">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.34">
                            <ns2:items id="text">Time relation to feeding</ns2:items>
                            <ns2:items id="description">The time relationship of the vomiting to feeding. Genrally applicable to neonates and infants.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.35">
                            <ns2:items id="text">During feeding</ns2:items>
                            <ns2:items id="description">Vomiting occues during feeding.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.36">
                            <ns2:items id="text">Immediately after feeding.</ns2:items>
                            <ns2:items id="description">Vomiting occurs immediately after feeding.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.37">
                            <ns2:items id="text">Up to 1 hour after feeding</ns2:items>
                            <ns2:items id="description">Vomiting occurs up to 1 hour after feeding.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.38">
                            <ns2:items id="text">Up to 2 hours after feeding</ns2:items>
                            <ns2:items id="description">Vomiting occurs up to 2 hours after feeding.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.39">
                            <ns2:items id="text">More than 2  hours after feeding</ns2:items>
                            <ns2:items id="description">Vomiting occurs more than 2  hours after feeding.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.40">
                            <ns2:items id="text">Normal</ns2:items>
                            <ns2:items id="description">The vomiting is of a normal or usual character.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.41">
                            <ns2:items id="text">Projectile</ns2:items>
                            <ns2:items id="description">The vomiting is projectile in nature.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.42">
                            <ns2:items id="text">Effortless</ns2:items>
                            <ns2:items id="description">The vomiting appears effortless.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.43">
                            <ns2:items id="text">Retching</ns2:items>
                            <ns2:items id="description">The subject is retching.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.44">
                            <ns2:items id="text">Infant spilling</ns2:items>
                            <ns2:items id="description">Infant regurgitation/ vomiting.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.45">
                            <ns2:items id="text">Datetime last fed</ns2:items>
                            <ns2:items id="description">The date and or time that the subject last fed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.46">
                            <ns2:items id="text">Time since last fed</ns2:items>
                            <ns2:items id="description">The time elapsed since the subject last fed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.50">
                            <ns2:items id="text">With effort</ns2:items>
                            <ns2:items id="description">Vomiting with effort</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.51">
                            <ns2:items id="text">Additional description</ns2:items>
                            <ns2:items id="description">Additional description</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.57">
                            <ns2:items id="text">Comment about feeding</ns2:items>
                            <ns2:items id="description">Any additional about feeding</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Fluid output</ns2:items>
                            <ns2:items id="description">Recording of findings and measurement (or estimation) of bodily output such as fluid output and defaecation. </ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000.1">
                            <ns2:items id="text">Vomiting</ns2:items>
                            <ns2:items id="description">Findings related to vomiting.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0016.1">
                            <ns2:items id="text">Vomit detail</ns2:items>
                            <ns2:items id="description">Details of the vomit observed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Event Series</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">The estimation of fluid output without specifying the period of time.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">List</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0006">
                            <ns2:items id="text">Total</ns2:items>
                            <ns2:items id="description">For recording total fluid output over a period (may transcend a number of interval or point in time records).</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0007">
                            <ns2:items id="text">Actual</ns2:items>
                            <ns2:items id="description">For recording the fluid output over a period of time when this will later be totalled.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0008">
                            <ns2:items id="text">List</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
