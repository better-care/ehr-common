                <ns2:items id="description">Primesi v blatu</ns2:items>
            </ns2:items>
            <ns2:items code="at0002">
                <ns2:items id="text">Vir telesnega izločka</ns2:items>
                <ns2:items id="description">Vir telesnega izločka</ns2:items>
            </ns2:items>
            <ns2:items code="at0013">
                <ns2:items id="text">Barva</ns2:items>
                <ns2:items id="description">Barva telesnega izločka</ns2:items>
            </ns2:items>
