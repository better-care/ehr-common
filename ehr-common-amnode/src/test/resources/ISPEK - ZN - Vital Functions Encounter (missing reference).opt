                                                                        <ns2:term_definitions code="at0000">
                                                                            <ns2:items id="text">ABC pain scale</ns2:items>
                                                                            <ns2:items id="description">Pain scale used for babies.</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0005">
                                                                            <ns2:items id="text">First cry acuteness</ns2:items>
                                                                            <ns2:items id="description">Acuteness of the first cry.</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0006">
                                                                            <ns2:items id="text">&lt; 400 Hz</ns2:items>
                                                                            <ns2:items id="description">Low pitch</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0007">
                                                                            <ns2:items id="text">&gt;= 400 Hz</ns2:items>
                                                                            <ns2:items id="description">High pitch</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0008">
                                                                            <ns2:items id="text">Burst rhythmicity</ns2:items>
                                                                            <ns2:items id="description">Rhythmicity of the crying bout</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0009">
                                                                            <ns2:items id="text">Not rhythmic</ns2:items>
                                                                            <ns2:items id="description">The crying bout is not rythmic.</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0010">
                                                                            <ns2:items id="text">Rhythmic bursts</ns2:items>
                                                                            <ns2:items id="description">The crying bout is rythmic.</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0011">
                                                                            <ns2:items id="text">Cry constancy</ns2:items>
                                                                            <ns2:items id="description">Cry constancy.</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0012">
                                                                            <ns2:items id="text">No cry</ns2:items>
                                                                            <ns2:items id="description">No constancy in crying, brief moan rather than crying.</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0013">
                                                                            <ns2:items id="text">Not constant</ns2:items>
                                                                            <ns2:items id="description">More than brief moan, but not constant.</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0014">
                                                                            <ns2:items id="text">Constant</ns2:items>
                                                                            <ns2:items id="description">Crying is constant in time.</ns2:items>
                                                                        </ns2:term_definitions>
                                                                        <ns2:term_definitions code="at0015">
                                                                            <ns2:items id="text">ABC pain score</ns2:items>
                                                                            <ns2:items id="description">Sum of scores for 3 criteria</ns2:items>
                                                                        </ns2:term_definitions>
