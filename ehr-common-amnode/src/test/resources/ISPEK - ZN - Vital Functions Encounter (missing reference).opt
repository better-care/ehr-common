                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Urinalysis</ns2:items>
                            <ns2:items id="description">Semi-quantitative chemical analysis of a urine sample by direct observation. The color change occurring on each segment of a dipstick is read by being compared to a color chart.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Event Series</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Any event</ns2:items>
                            <ns2:items id="description">*</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0030">
                            <ns2:items id="text">Comments</ns2:items>
                            <ns2:items id="description">Any general comments on the results.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0032">
                            <ns2:items id="text">Blood</ns2:items>
                            <ns2:items id="description">Detection of blood in urine sample.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0037">
                            <ns2:items id="text">Ketones</ns2:items>
                            <ns2:items id="description">Detection of ketones in urine sample.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0043">
                            <ns2:items id="text">Nitrite</ns2:items>
                            <ns2:items id="description">Detection of nitrites in urine sample.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0050">
                            <ns2:items id="text">Glucose</ns2:items>
                            <ns2:items id="description">Detection of glucose in urine sample.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0056">
                            <ns2:items id="text">Urobilinogen</ns2:items>
                            <ns2:items id="description">Detection of urobilinogen in urine sample.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0062">
                            <ns2:items id="text">Bilirubin</ns2:items>
                            <ns2:items id="description">Detection of bilirubin in urine sample.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0068">
                            <ns2:items id="text">Leukocytes</ns2:items>
                            <ns2:items id="description">Detection of white blood cells in the urine.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0079">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0095">
                            <ns2:items id="text">Protein</ns2:items>
                            <ns2:items id="description">Detection of protein in urine sample.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0096">
                            <ns2:items id="text">Negative</ns2:items>
                            <ns2:items id="description">Negative</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0097">
                            <ns2:items id="text">Trace</ns2:items>
                            <ns2:items id="description">Trace</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0098">
                            <ns2:items id="text">+</ns2:items>
                            <ns2:items id="description">30mg/dl</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0099">
                            <ns2:items id="text">++</ns2:items>
                            <ns2:items id="description">100mg/dl</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0100">
                            <ns2:items id="text">+++</ns2:items>
                            <ns2:items id="description">300mg/dl</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0101">
                            <ns2:items id="text">++++</ns2:items>
                            <ns2:items id="description">over 2000mg/dl</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0102">
                            <ns2:items id="text">Negative</ns2:items>
                            <ns2:items id="description">Negative</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0103">
                            <ns2:items id="text">Non-haemolysed Trace</ns2:items>
