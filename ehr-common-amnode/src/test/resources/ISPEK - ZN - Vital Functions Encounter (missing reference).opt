                        <ns2:term_definitions code="at0.2">
                            <ns2:items id="text">Unassisted oxygen delivery</ns2:items>
                            <ns2:items id="description">The intervention is unassisted oxygen deliverry.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.3">
                            <ns2:items id="text">Datetime last filter change</ns2:items>
                            <ns2:items id="description">Date and time that the oxygen administration system filter was changed.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0.4">
                            <ns2:items id="text">Continuous positive airway pressure (CPAP)</ns2:items>
                            <ns2:items id="description">Continuous positive airway pressure setting for non-mechanical ventilation.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000.1">
                            <ns2:items id="text">Unassisted oxygen delivery</ns2:items>
                            <ns2:items id="description">Unassisted oxygen delivery.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002.1">
                            <ns2:items id="text">Intervention</ns2:items>
                            <ns2:items id="description">The name of the procedu re.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0058">
                            <ns2:items id="text">Performer</ns2:items>
                            <ns2:items id="description">The person performing the procedure (where not the information provider).</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0059">
                            <ns2:items id="text">Assistant</ns2:items>
                            <ns2:items id="description">A person assisting the key intervention performer.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0000">
                            <ns2:items id="text">Clinical intervention</ns2:items>
                            <ns2:items id="description">A clinical activity that has been carried out for therapeutic or diagnostic purposes.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0001">
                            <ns2:items id="text">Tree</ns2:items>
                            <ns2:items id="description">@ internal @</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0002">
                            <ns2:items id="text">Intervention</ns2:items>
                            <ns2:items id="description">The name of the procedure.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0003">
                            <ns2:items id="text">Intervention details</ns2:items>
                            <ns2:items id="description">Detailed structure describing the procedure carried out, including preparation and details about the method and equipment/devices used.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0004">
                            <ns2:items id="text">Intervention unsuccessful</ns2:items>
                            <ns2:items id="description">Was the intervention regarded as unsuccessful, from a clinical perspective? True if unsuccessful.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0005">
                            <ns2:items id="text">Comments</ns2:items>
                            <ns2:items id="description">Comments about the procedure.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0006">
                            <ns2:items id="text">Complication</ns2:items>
                            <ns2:items id="description">Details about any complication arising from the procedure.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0013">
                            <ns2:items id="text">Multimedia</ns2:items>
                            <ns2:items id="description">Multimedia representation of the procedure, including images.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0014">
                            <ns2:items id="text">Reason/s for intervention</ns2:items>
                            <ns2:items id="description">The reason or indication for the procedure.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0015">
                            <ns2:items id="text">Unplanned event</ns2:items>
                            <ns2:items id="description">An unplanned event prior to or related to the procedure, which may affect its execution e.g patient self-removed cannula.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0018">
                            <ns2:items id="text">Failed attempts</ns2:items>
                            <ns2:items id="description">The number of failed attempts to perform the procedure.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0030">
                            <ns2:items id="text">Additional task</ns2:items>
                            <ns2:items id="description">Record information about unplanned or unexpected activities that needed to be done during the procedure. Record the name of the task and a description within this archetype, but detail should be recorded in specific linked INSTRUCTION or ACTION archetypes.</ns2:items>
                        </ns2:term_definitions>
                        <ns2:term_definitions code="at0031">
                            <ns2:items id="text">Task description</ns2:items>
                            <ns2:items id="description">Description of additional task performed during the procedure.</ns2:items>
